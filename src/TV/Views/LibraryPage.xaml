<Page x:Class="TV.Views.LibraryPage" x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:TV.Controls"
      Background="Transparent" Loaded="OnLoaded" SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <x:Double x:Key="ThumbnailWidth">56</x:Double>
        <x:Double x:Key="ThumbnailHeight">84</x:Double>
        <x:Double x:Key="LibraryRowMinHeight">56</x:Double>

        <LinearGradientBrush x:Key="CardBottomScrim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#000B0B0D" Offset="0.18" />
            <GradientStop Color="#6E0B0B0D" Offset="0.56" />
            <GradientStop Color="#F009090C" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="LibraryRowItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="MinHeight" Value="{StaticResource LibraryRowMinHeight}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootLayout" Padding="{StaticResource PagePaddingWide}" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 画册个人典藏报头 + 按需反馈条（避免未展开时产生双倍行距空带） -->
        <StackPanel Spacing="12">
            <Grid x:Name="HeaderGrid" ColumnSpacing="{StaticResource SpaceMedium}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel x:Name="HeaderTitle" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="03 · COLLECTION" Style="{StaticResource EyebrowText}" />
                    </StackPanel>
                    <TextBlock Text="媒体库" Style="{StaticResource PageTitleText}" />
                    <TextBlock x:Name="HeaderSubtitle" Text="继续观看、收藏、离线下载与本地影片的个人片库" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" Width="240" VerticalAlignment="Center"
                         PlaceholderText="搜索媒体库" AutomationProperties.Name="搜索媒体库"
                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DropDownButton x:Name="LocalMediaButton" Grid.Column="2" Content="本地媒体" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                                AutomationProperties.Name="本地媒体">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="导入媒体文件（可多选）" Command="{Binding ImportFilesCommand}" />
                            <MenuFlyoutItem Text="导入文件夹并自动更新" Command="{Binding ImportFolderCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="直接打开文件" Command="{Binding OpenFileCommand}" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="LibraryRefreshButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                        Click="OnRefreshClick" ToolTipService.ToolTip="刷新"
                        AutomationProperties.Name="刷新">
                    <controls:LineIcon PathData="{StaticResource IconRefresh}" IconSize="17" />
                </Button>
            </Grid>

            <InfoBar IsOpen="{Binding HasError}" Message="{Binding StatusMessage}"
                     Severity="Warning" IsClosable="False"
                     Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <InfoBar IsOpen="{Binding HasSuccess}" Message="{Binding StatusMessage}"
                     Severity="Success" IsClosable="False"
                     Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- 统一横向分段导航（五层光学磨砂槽 + 弹性晶体滑行胶囊 + 底部朱砂光点，支持滚轮横滑） -->
        <controls:GlassSurface x:Name="SegmentTrack" Grid.Row="1" HorizontalAlignment="Left"
                               CornerRadius="23" Padding="4">
            <ScrollViewer x:Name="SegmentScroller"
                          controls:ScrollWheelBehavior.HorizontalWheelMode="Direct"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="SegmentTrackHost">
                    <!-- 弹簧滑行的晶体高亮胶囊 + 顶部微高光丝 + 底部极细朱砂光点 -->
                    <Border x:Name="SegmentGlidePill"
                            Height="38" Width="96" CornerRadius="19"
                            Background="{ThemeResource NavActivePlateBrush}"
                            BorderBrush="{ThemeResource NavActiveBorderBrush}" BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False">
                        <Grid>
                            <Border Height="1" VerticalAlignment="Top" Margin="12,0"
                                    Background="{ThemeResource GlassCausticBrush}" IsHitTestVisible="False" />
                            <Border Width="16" Height="2" CornerRadius="1"
                                    Background="{ThemeResource VermilionBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </Grid>
                    </Border>
                    <ListView x:Name="SegmentList" SelectionMode="Single"
                              IsItemClickEnabled="False" HorizontalAlignment="Left" Padding="0"
                              Background="Transparent" BorderThickness="0"
                              ItemContainerStyle="{StaticResource HorizontalNavSegmentItemStyle}"
                              SelectionChanged="OnSegmentSelectionChanged"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListViewItem AutomationProperties.Name="继续观看" ToolTipService.ToolTip="继续观看">
                            <TextBlock Text="继续观看" Style="{StaticResource NavSegmentTextStyle}" />
                        </ListViewItem>
                        <ListViewItem AutomationProperties.Name="收藏" ToolTipService.ToolTip="收藏">
                            <TextBlock Text="收藏" Style="{StaticResource NavSegmentTextStyle}" />
                        </ListViewItem>
                        <ListViewItem AutomationProperties.Name="下载" ToolTipService.ToolTip="下载">
                            <TextBlock Text="下载" Style="{StaticResource NavSegmentTextStyle}" />
                        </ListViewItem>
                        <ListViewItem AutomationProperties.Name="本地媒体" ToolTipService.ToolTip="本地媒体">
                            <TextBlock Text="本地媒体" Style="{StaticResource NavSegmentTextStyle}" />
                        </ListViewItem>
                    </ListView>
                </Grid>
            </ScrollViewer>
        </controls:GlassSurface>

        <!-- 内容区 -->
        <Grid x:Name="ContentHost" Grid.Row="2">

            <!-- 继续观看（自适应行列与宽屏信息流） -->
            <Grid Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVisibility}}">
                <GridView x:Name="HistoryGrid" ItemsSource="{Binding History}" SelectionMode="None" IsItemClickEnabled="True"
                          Loaded="OnHistoryGridLoaded" SizeChanged="OnHistoryViewportChanged"
                          ItemClick="OnHistoryClick" ContainerContentChanging="OnWatchContainerChanging" Padding="0,0,12,0"
                          Background="Transparent" BorderThickness="0"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="320" ItemHeight="192" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,4,16,16" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  PointerEntered="OnWatchCardIn" PointerExited="OnWatchCardOut"
                                  PointerPressed="OnWatchCardPressed" PointerReleased="OnWatchCardReleased" PointerCanceled="OnWatchCardReleased">
                                <Border CornerRadius="{StaticResource RadiusPanel}"
                                        controls:GlassOpticsEngine.Mode="Interactive"
                                        controls:GlassOpticsEngine.Profile="Card"
                                        controls:GlassOpticsEngine.RadiusOverride="14"
                                        Background="{ThemeResource PosterPlaceholderBrush}"
                                        BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid>
                                            <controls:LineIcon PathData="{StaticResource IconFilm}" IconSize="28" Foreground="{ThemeResource TertiaryTextBrush}" />
                                            <Image x:Name="WatchArt" controls:PosterImage.CachedSource="{Binding Picture}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                                        </Grid>
                                        <Rectangle Fill="{StaticResource CardBottomScrim}" />
                                        <Border Height="1" VerticalAlignment="Top" Margin="14,0"
                                                Background="{ThemeResource GlassCausticBrush}" Opacity="0.72" IsHitTestVisible="False" />
                                        <StackPanel VerticalAlignment="Bottom" Padding="14,10,14,13" Spacing="4">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleText}"
                                                       Foreground="#FFF4F3EE" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MetaText}"
                                                       Foreground="#CCF4F3EE" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <Grid Margin="0,5,0,0" ColumnSpacing="{StaticResource SpaceMini}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="3.5"
                                                             CornerRadius="2"
                                                             VerticalAlignment="Center"
                                                             Background="#3DFFFFFF"
                                                             Foreground="{ThemeResource VermilionBrush}"
                                                             Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Column="1" Text="已看完"
                                                           Style="{StaticResource MonoMetaText}"
                                                           Foreground="{ThemeResource VermilionBrush}"
                                                           Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </StackPanel>
                                        <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="34" MinWidth="34" MinHeight="34" Margin="10"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                CornerRadius="17"
                                                Background="{ThemeResource GlassDarkBadgeBrush}" BorderBrush="#3BFFFFFF" BorderThickness="1"
                                                Tag="{Binding}" Click="OnDeleteHistoryClick"
                                                AutomationProperties.Name="删除记录"
                                                ToolTipService.ToolTip="删除记录">
                                            <controls:LineIcon PathData="{StaticResource IconTrash}" IconSize="14" Foreground="#FFF4F3EE" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="380" Spacing="{StaticResource SpaceSmall}"
                            Visibility="{Binding EmptyHistory, Converter={StaticResource StringToVisibility}}">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{ThemeResource GlassPanelBrush}"
                            BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <controls:LineIcon PathData="{StaticResource IconVod}" IconSize="28"
                                           Foreground="{ThemeResource SecondaryTextBrush}" />
                    </Border>
                    <TextBlock Text="{Binding EmptyHistory}" Style="{StaticResource SectionTitleText}"
                               TextAlignment="Center" />
                    <TextBlock Text="在点播页播放影片后，播放进度会自动出现在这里。" Style="{StaticResource SecondaryText}"
                               TextAlignment="Center" />
                    <Button Content="浏览点播" Click="OnBrowseVodClick"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 收藏 -->
            <Grid Visibility="{Binding IsFavoritesTab, Converter={StaticResource BoolToVisibility}}">
                <ListView ItemsSource="{Binding Favorites}" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnFavoriteClick" Padding="0,0,12,0"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ItemContainerStyle="{StaticResource LibraryRowItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Grid MinHeight="{StaticResource LibraryRowMinHeight}" Padding="8,10"
                                      ColumnSpacing="{StaticResource SpaceMedium}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource ThumbnailWidth}" Height="{StaticResource ThumbnailHeight}"
                                            CornerRadius="{StaticResource RadiusControl}"
                                            Background="{ThemeResource PosterPlaceholderBrush}"
                                            BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1">
                                        <Grid>
                                            <controls:LineIcon PathData="{StaticResource IconFilm}" IconSize="20"
                                                               Foreground="{ThemeResource TertiaryTextBrush}" />
                                            <Image controls:PosterImage.CachedSource="{Binding Picture}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpaceTiny}">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleText}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MetaText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0"
                                            Click="OnRemoveFavoriteClick"
                                            AutomationProperties.Name="移除收藏"
                                            ToolTipService.ToolTip="移除收藏">
                                        <controls:LineIcon PathData="{StaticResource IconTrash}" IconSize="16"
                                                           Foreground="{ThemeResource SecondaryTextBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="380" Spacing="{StaticResource SpaceSmall}"
                            Visibility="{Binding EmptyFavorites, Converter={StaticResource StringToVisibility}}">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{ThemeResource GlassPanelBrush}"
                            BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <controls:LineIcon PathData="{StaticResource IconStar}" IconSize="28"
                                           Foreground="{ThemeResource SecondaryTextBrush}" />
                    </Border>
                    <TextBlock Text="{Binding EmptyFavorites}" Style="{StaticResource SectionTitleText}"
                               TextAlignment="Center" />
                    <TextBlock Text="在影片详情页点击收藏，影片会集中出现在这里。" Style="{StaticResource SecondaryText}"
                               TextAlignment="Center" />
                    <Button Content="刷新媒体库" Command="{Binding LoadCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 下载 -->
            <Grid Visibility="{Binding IsDownloadsTab, Converter={StaticResource BoolToVisibility}}">
                <ListView ItemsSource="{Binding Downloads}" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnDownloadClick" Padding="0,0,12,0"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ItemContainerStyle="{StaticResource LibraryRowItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Grid MinHeight="{StaticResource LibraryRowMinHeight}" Padding="8,10"
                                      ColumnSpacing="{StaticResource SpaceMedium}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource ThumbnailWidth}" Height="{StaticResource ThumbnailHeight}"
                                            CornerRadius="{StaticResource RadiusControl}"
                                            Background="{ThemeResource GlassChipBrush}"
                                            BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1">
                                        <controls:LineIcon PathData="{StaticResource IconDownload}" IconSize="20"
                                                           Foreground="{ThemeResource SecondaryTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpaceTiny}">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleText}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Episode}" Style="{StaticResource MetaText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                Spacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonStyle}" Tag="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Click="OnRevealDownloadClick"
                                                AutomationProperties.Name="所在文件夹"
                                                ToolTipService.ToolTip="所在文件夹">
                                            <controls:LineIcon PathData="{StaticResource IconFolder}" IconSize="16" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Tag="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Click="OnRemoveDownloadClick"
                                                AutomationProperties.Name="从媒体库移除"
                                                ToolTipService.ToolTip="从媒体库移除">
                                            <controls:LineIcon PathData="{StaticResource IconTrash}" IconSize="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="380" Spacing="{StaticResource SpaceSmall}"
                            Visibility="{Binding EmptyDownloads, Converter={StaticResource StringToVisibility}}">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{ThemeResource GlassPanelBrush}"
                            BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <controls:LineIcon PathData="{StaticResource IconDownload}" IconSize="28"
                                           Foreground="{ThemeResource SecondaryTextBrush}" />
                    </Border>
                    <TextBlock Text="{Binding EmptyDownloads}" Style="{StaticResource SectionTitleText}"
                               TextAlignment="Center" />
                    <TextBlock Text="在详情页选择下载，完成的剧集会归档在这里。" Style="{StaticResource SecondaryText}"
                               TextAlignment="Center" />
                    <Button Content="打开文件" Command="{Binding OpenFileCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 本地媒体 -->
            <Grid Visibility="{Binding IsLocalTab, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="LocalFoldersScroller"
                              controls:ScrollWheelBehavior.HorizontalWheelMode="Direct"
                              HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsLocalTab, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding LocalFolders}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,10" Padding="12,4" CornerRadius="{StaticResource RadiusControl}"
                                        Background="{ThemeResource GlassChipBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                                        <controls:LineIcon PathData="{StaticResource IconFolder}" IconSize="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource MetaText}" MaxWidth="240"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding}" />
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="停止监视" Tag="{Binding}"
                                                Click="OnRemoveLocalFolderClick" AutomationProperties.Name="停止监视" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ComboBox Grid.Row="1" Margin="0,0,0,8" SelectedIndex="{Binding LocalMediaFilter, Mode=TwoWay}"
                          AutomationProperties.Name="筛选本地媒体">
                    <ComboBoxItem Content="全部媒体" />
                    <ComboBoxItem Content="视频" />
                    <ComboBoxItem Content="音乐" />
                </ComboBox>
                <Grid Grid.Row="2">
                    <ListView ItemsSource="{Binding LocalFiles}" SelectionMode="None" IsItemClickEnabled="False"
                              Padding="0,0,12,0" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ItemContainerStyle="{StaticResource LibraryRowItemStyle}" AutomationProperties.Name="本地媒体列表">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid MinHeight="64" Padding="8,10" ColumnSpacing="{StaticResource SpaceMedium}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Click="OnLocalMediaClick" AutomationProperties.Name="{Binding Title}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Background="Transparent" BorderThickness="0" Padding="0">
                                            <Grid ColumnSpacing="{StaticResource SpaceMedium}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="56" Height="44" CornerRadius="{StaticResource RadiusControl}"
                                                        Background="{ThemeResource GlassChipBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MediaLabel}" Style="{StaticResource MetaText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpaceTiny}">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleText}" MaxLines="1" />
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{Binding Path}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Tag="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Click="OnRemoveLocalMediaClick" AutomationProperties.Name="从本地库移除"
                                                ToolTipService.ToolTip="仅从媒体库移除，不删除文件">
                                            <controls:LineIcon PathData="{StaticResource IconTrash}" IconSize="16" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                Spacing="{StaticResource SpaceSmall}" Visibility="{Binding EmptyLocal, Converter={StaticResource StringToVisibility}}">
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="{ThemeResource GlassPanelBrush}"
                                BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                                HorizontalAlignment="Center">
                            <controls:LineIcon PathData="{StaticResource IconFolder}" IconSize="28"
                                               Foreground="{ThemeResource SecondaryTextBrush}" />
                        </Border>
                        <TextBlock Text="{Binding EmptyLocal}" Style="{StaticResource SectionTitleText}" TextAlignment="Center" />
                        <TextBlock Text="导入视频或音乐文件，也可以监视文件夹。"
                                   Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}" HorizontalAlignment="Center">
                            <Button Content="导入文件" Command="{Binding ImportFilesCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="导入文件夹" Command="{Binding ImportFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>

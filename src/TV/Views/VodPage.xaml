<Page
    x:Class="TV.Views.VodPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TV.Converters"
    xmlns:controls="using:TV.Controls"
    Background="Transparent"
    NavigationCacheMode="Enabled"
    Loaded="OnLoaded">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <Grid x:Name="VodRoot" Padding="{StaticResource PagePaddingWide}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主内容舞台：底层全高海报流 + 顶层 GPU 1:1 可打断收起画册画廊与吸顶磨砂筛选坞 -->
        <Grid x:Name="VodStage" Grid.Row="0">
            <!-- 画框质感海报网格：顶部放置与 TopCollapsibleBand + StickyDockBand 等高的透明占位 Header，杜绝滚动高度突变与抖动 -->
            <GridView x:Name="Posters" AutomationProperties.Name="点播海报" Loaded="OnPostersLoaded"
                      Unloaded="OnPostersUnloaded" ItemsSource="{Binding Items}" SelectionMode="None"
                      ContainerContentChanging="OnPosterContainerChanging" SizeChanged="OnPosterViewportChanged"
                      Padding="0" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.IsVerticalScrollChainingEnabled="False">
                <GridView.Header>
                    <Border x:Name="ScrollTopSpacer" Height="328" IsHitTestVisible="False" />
                </GridView.Header>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="206" ItemHeight="356" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Button Padding="0" BorderThickness="0" Background="Transparent"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding Item.Name}"
                                Margin="0,4,18,20" Click="OnCardClick"
                                PointerEntered="OnCardIn" PointerExited="OnCardOut"
                                PointerPressed="OnCardPressed" PointerReleased="OnCardReleased" PointerCanceled="OnCardReleased">
                            <Grid RowSpacing="9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="270" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="PosterFrame" Grid.Row="0" Style="{StaticResource GlassOpticalPanelBorderStyle}"
                                        CornerRadius="{StaticResource RadiusCard}"
                                        BorderThickness="1" BorderBrush="{ThemeResource GlassEdgeBrush}"
                                        Background="{ThemeResource PosterPlaceholderBrush}">
                                    <Grid>
                                        <controls:LineIcon PathData="{StaticResource IconFilm}" IconSize="30"
                                                           Foreground="{ThemeResource TertiaryTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="PosterArt" Source="{Binding Poster}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                                        <Rectangle VerticalAlignment="Bottom" Height="56" IsHitTestVisible="False">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#000B0B0D" Offset="0" />
                                                    <GradientStop Color="#720B0B0D" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Border Visibility="{Binding Item.Remarks, Converter={StaticResource StringToVisibility}}"
                                                Background="{ThemeResource GlassDarkBadgeBrush}" BorderBrush="#2EFFFFFF" BorderThickness="1"
                                                CornerRadius="5" Height="24" Padding="8,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9">
                                            <TextBlock Text="{Binding Item.Remarks}" FontSize="{StaticResource FontSizeMeta}"
                                                       FontWeight="SemiBold" Foreground="{ThemeResource GlassDarkBadgeInkBrush}"
                                                       MaxWidth="112" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Visibility="{Binding Rating, Converter={StaticResource StringToVisibility}}"
                                                Background="{ThemeResource GlassDarkBadgeBrush}" BorderBrush="#2EFFFFFF" BorderThickness="1"
                                                CornerRadius="5" Height="24" Padding="8,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <Ellipse Width="4.5" Height="4.5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Rating}" Style="{StaticResource MonoMetaText}"
                                                           FontWeight="SemiBold" Foreground="{ThemeResource GlassDarkBadgeInkBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <!-- 磨砂圆镜播放浮层 -->
                                        <Grid x:Name="PlayOverlay" Background="#660B0B0D" Opacity="0">
                                            <Border x:Name="PlayBadge" Width="52" Height="52" CornerRadius="26"
                                                    Background="#E8F4F3EE" BorderBrush="#66FFFFFF" BorderThickness="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <controls:LineIcon PathData="{StaticResource IconPlaySolid}" IconSize="20" IsFilled="True"
                                                                   Foreground="#0D0D10" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding Item.Name}" Style="{StaticResource CardTitleText}" MaxLines="1" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Item.Year}" Style="{StaticResource MonoMetaText}"
                                               Visibility="{Binding Item.Year, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="·" Style="{StaticResource MetaText}"
                                               Visibility="{Binding Item.Year, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="{Binding Item.SiteName}" Style="{StaticResource MetaText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- 顶部画册报头 + 展陈宽幅卡片（随下滑在 GPU 线程跟手微缩滑隐，任意瞬间可打断折返） -->
            <StackPanel x:Name="TopCollapsibleBand" VerticalAlignment="Top" Canvas.ZIndex="10"
                        Margin="0,0,16,0" Padding="0,0,0,8" Spacing="10" Background="Transparent"
                        SizeChanged="OnHeaderBandSizeChanged">
                <!-- 现代平面画册报头：左画册索引 + 主标题 + 磨砂站点标 / 右极简磨砂操作 -->
                <Grid x:Name="BrowseHeader" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="01 · ARCHIVE" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="点播" Style="{StaticResource PageTitleText}" VerticalAlignment="Center" />
                            <DropDownButton x:Name="RepoSwitcherButton"
                                            Style="{StaticResource GlassDropDownButtonStyle}"
                                            Background="{ThemeResource GlassChipBrush}"
                                            BorderBrush="{ThemeResource GlassEdgeBrush}"
                                            Height="34" MinHeight="34" CornerRadius="17"
                                            controls:GlassOpticsEngine.RadiusOverride="17"
                                            Padding="13,0,11,0" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="切换片源仓库（右键刷新当前仓库）"
                                            AutomationProperties.Name="切换仓库">
                                <DropDownButton.Content>
                                    <TextBlock Text="{Binding ActiveRepositoryName}" Style="{StaticResource MetaText}"
                                               Foreground="{ThemeResource PrimaryTextBrush}" MaxWidth="220"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DropDownButton.Content>
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="RepoSwitcherFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnRepoMenuOpening" />
                                </DropDownButton.Flyout>
                                <DropDownButton.ContextFlyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Text="刷新当前仓库" Click="OnRefreshRepositoryClick"
                                                        AutomationProperties.Name="刷新当前仓库" />
                                    </MenuFlyout>
                                </DropDownButton.ContextFlyout>
                            </DropDownButton>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="HeaderSearchButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnSearchClick"
                                AutomationProperties.Name="打开搜索">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <controls:LineIcon PathData="{StaticResource IconSearch}" IconSize="15" />
                                <TextBlock Text="搜索" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HeaderReloadButton" Style="{StaticResource IconButtonStyle}" Command="{Binding ReloadCommand}"
                                ToolTipService.ToolTip="重新加载" AutomationProperties.Name="重新加载">
                            <controls:LineIcon PathData="{StaticResource IconRefresh}" IconSize="17" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 美术馆宽幅展陈画廊：磨砂铭牌 + 内嵌图景微缩放（Shift+滚轮可横滑，普通滚轮穿透驱动页面纵滑） -->
                <Grid x:Name="GalleryHost">
                    <ScrollViewer x:Name="GalleryScroller" Height="186"
                                  controls:ScrollWheelBehavior.HorizontalWheelMode="ShiftOnly"
                                  Visibility="{Binding ShowGallery, Converter={StaticResource BoolToVisibility}}"
                                  HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding GalleryItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="336" Height="176" Margin="0,4,18,6" Padding="0" BorderThickness="0"
                                            Background="Transparent"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            AutomationProperties.Name="{Binding Item.Name}"
                                            Loaded="OnFeaturedLoaded" Click="OnCardClick"
                                            PointerEntered="OnFeaturedIn" PointerExited="OnFeaturedOut"
                                            PointerPressed="OnCardPressed" PointerReleased="OnCardReleased" PointerCanceled="OnCardReleased">
                                        <Border Style="{StaticResource GlassOpticalPanelBorderStyle}"
                                                CornerRadius="{StaticResource RadiusPanel}" BorderThickness="1"
                                                BorderBrush="{ThemeResource GlassEdgeBrush}"
                                                Background="{ThemeResource PosterPlaceholderBrush}">
                                            <Grid>
                                                <Image x:Name="GalleryArt" Source="{Binding Poster}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                                                <Rectangle IsHitTestVisible="False">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#000B0B0D" Offset="0.22" />
                                                            <GradientStop Color="#A60B0B0D" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <!-- 右上极简磨砂评分印记 -->
                                                <Border Visibility="{Binding Rating, Converter={StaticResource StringToVisibility}}"
                                                        Background="{ThemeResource GlassDarkBadgeBrush}" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                        CornerRadius="6" Height="24" Padding="8,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Rating}" Style="{StaticResource MonoMetaText}"
                                                                   FontWeight="SemiBold" Foreground="{ThemeResource GlassDarkBadgeInkBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- 底部光学展陈铭牌 -->
                                                <Border VerticalAlignment="Bottom" Margin="10"
                                                        Background="{ThemeResource GlassDarkBadgeBrush}"
                                                        BorderBrush="{StaticResource PlayerGlassBorderBrush}" BorderThickness="1"
                                                        CornerRadius="10" Padding="12,8">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Item.Remarks}" Style="{StaticResource MetaText}"
                                                                   FontWeight="SemiBold" Foreground="{ThemeResource GlassDarkBadgeAccentBrush}"
                                                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding Item.Remarks, Converter={StaticResource StringToVisibility}}" />
                                                        <TextBlock Text="{Binding Item.Name}" FontSize="{StaticResource FontSizeCardTitle}"
                                                                   LineHeight="{StaticResource LineHeightCardTitle}" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource GlassDarkBadgeInkBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </StackPanel>

            <!-- 吸顶磨砂筛选坞 + 细丝加载条：随滚动 1:1 丝滑上移并无缝化为悬浮磨砂玻璃坞 -->
            <StackPanel x:Name="StickyDockBand" VerticalAlignment="Top" Canvas.ZIndex="20"
                        Margin="0,0,16,0" SizeChanged="OnHeaderBandSizeChanged">
                <Grid x:Name="FilterDock" Margin="0,0,0,8">
                    <controls:GlassSurface x:Name="FilterDockGlass"
                                           CornerRadius="14" Opacity="0" IsHitTestVisible="False">
                        <controls:GlassSurface.Shadow>
                            <ThemeShadow x:Name="FilterDockShadow" />
                        </controls:GlassSurface.Shadow>
                    </controls:GlassSurface>
                    <Border x:Name="FilterDockDivider" Height="1"
                            Background="{ThemeResource DividerBrush}"
                            VerticalAlignment="Bottom" IsHitTestVisible="False" />
                    <Grid x:Name="FilterBar" Padding="10,8,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="CategoryScroller"
                                      controls:ScrollWheelBehavior.HorizontalWheelMode="ShiftOnly"
                                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Center">
                            <Grid x:Name="CategoryTrackHost" VerticalAlignment="Center">
                                <!-- 统一横向导航高反差弹簧滑行胶囊：单实例物理跟随，杜绝多选态残留 -->
                                <Border x:Name="CategoryGlidePill" Height="38" Width="84"
                                        CornerRadius="19"
                                        Background="{ThemeResource NavChipSelectedBackgroundBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Opacity="0" IsHitTestVisible="False" />
                                <ListView x:Name="CategoryNavList" AutomationProperties.Name="点播分类"
                                          ItemsSource="{Binding Categories}"
                                          SelectionMode="Single" IsItemClickEnabled="False"
                                          Background="Transparent" BorderThickness="0" Padding="0"
                                          ItemContainerStyle="{StaticResource HorizontalNavChipItemStyle}"
                                          SelectionChanged="OnCategorySelectionChanged"
                                          ContainerContentChanging="OnCategoryContainerChanging"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection />
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource NavSegmentTextStyle}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </ScrollViewer>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                            <controls:AnchoredChoice Header="站点" ItemsSource="{Binding Sites}" MaxWidth="204"
                                                     DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                                                     PlaceholderText="选择站点" />
                            <Button x:Name="FilterButton" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                                    AutomationProperties.Name="筛选">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <controls:LineIcon PathData="{StaticResource IconFilter}" IconSize="16" />
                                    <TextBlock Text="{Binding FilterBadge}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Width="284" Spacing="14">
                                            <StackPanel Spacing="{StaticResource SpaceSmall}"
                                                        Visibility="{Binding HasCategoryFilters, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                                <controls:AnchoredChoice Header="类型" ItemsSource="{Binding TypeFilters}"
                                                                         SelectedItem="{Binding TypeFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                <controls:AnchoredChoice Header="年份" ItemsSource="{Binding YearFilters}"
                                                                         SelectedItem="{Binding YearFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                <controls:AnchoredChoice Header="排序" SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                                                                         Options="默认|年份|评分" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding CategoryFilters}"
                                                          Visibility="{Binding HasCategoryFilters, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:AnchoredChoice Header="{Binding Name}" ItemsSource="{Binding Values}" DisplayMemberPath="Name"
                                                                                 SelectedItem="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="重置筛选" Command="{Binding ResetFiltersCommand}"
                                                    Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"
                                                    AutomationProperties.Name="重置筛选"
                                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <ProgressBar IsIndeterminate="{Binding IsLoading}" Height="2" Margin="2,0,2,4"
                             Foreground="{ThemeResource VermilionBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <Button x:Name="BackToTop" Visibility="Collapsed" Click="OnTopClick" Canvas.ZIndex="30"
                    Style="{StaticResource GlassFabButtonStyle}"
                    AutomationProperties.Name="回到顶部" ToolTipService.ToolTip="回到顶部"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18">
                <controls:LineIcon PathData="{StaticResource IconArrowUp}" IconSize="18" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,12,0,0">
            <Button Content="{Binding SiteToolAction}" Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="{Binding HasSiteTool, Converter={StaticResource BoolToVisibility}}" Click="OnSiteToolClick" />
            <Button Content="打开投屏接收" Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="{Binding IsPushSite, Converter={StaticResource BoolToVisibility}}" Click="OnSiteCastClick" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetaText}" VerticalAlignment="Center"
                       MaxWidth="460" TextTrimming="CharacterEllipsis" />
            <Button Content="完成验证" Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnVerifySiteClick"
                    AutomationProperties.Name="完成站点验证"
                    Visibility="{Binding HasPendingVerification, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="加载更多" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</Page>

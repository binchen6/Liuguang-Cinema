<Page
    x:Class="TV.Views.VodPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TV.Converters"
    xmlns:controls="using:TV.Controls"
    Background="Transparent"
    Loaded="OnLoaded">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <Grid Padding="{StaticResource PagePaddingWide}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 现代平面画册报头：左画册索引 + 主标题 + 磨砂站点标 / 右极简磨砂操作 -->
        <Grid x:Name="BrowseHeader" Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="01 · ARCHIVE" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="点播" Style="{StaticResource PageTitleText}" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource GlassChipBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="12,4" VerticalAlignment="Center"
                            Visibility="{Binding SelectedSite.DisplayName, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                        <TextBlock Text="{Binding SelectedSite.DisplayName}" Style="{StaticResource MetaText}"
                                   Foreground="{ThemeResource PrimaryTextBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="HeaderSearchButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnSearchClick"
                        AutomationProperties.Name="打开搜索">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LineIcon PathData="{StaticResource IconSearch}" IconSize="15" />
                        <TextBlock Text="搜索" Style="{StaticResource SecondaryText}"
                                   Foreground="{ThemeResource PrimaryTextBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="HeaderReloadButton" Style="{StaticResource IconButtonStyle}" Command="{Binding ReloadCommand}"
                        ToolTipService.ToolTip="重新加载" AutomationProperties.Name="重新加载">
                    <controls:LineIcon PathData="{StaticResource IconRefresh}" IconSize="17" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 美术馆宽幅展陈画廊：磨砂铭牌 + 内嵌图景微缩放 -->
        <Grid x:Name="GalleryHost" Grid.Row="1" Margin="0,10,0,0">
            <ScrollViewer Height="186"
                          Visibility="{Binding ShowGallery, Converter={StaticResource BoolToVisibility}}"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding GalleryItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="332" Height="174" Margin="0,4,18,8" Padding="0" BorderThickness="0"
                                    Background="Transparent"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Item.Name}"
                                    Loaded="OnFeaturedLoaded" Click="OnCardClick"
                                    PointerEntered="OnFeaturedIn" PointerExited="OnFeaturedOut"
                                    PointerPressed="OnCardPressed" PointerReleased="OnCardReleased" PointerCanceled="OnCardReleased">
                                <Border CornerRadius="{StaticResource RadiusPanel}" BorderThickness="1"
                                        BorderBrush="{ThemeResource GlassEdgeBrush}"
                                        Background="{ThemeResource PosterPlaceholderBrush}">
                                    <Grid>
                                        <Image x:Name="GalleryArt" Source="{Binding Poster}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                                        <Rectangle IsHitTestVisible="False">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#000B0B0D" Offset="0.25" />
                                                    <GradientStop Color="#990B0B0D" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <!-- 右上极简磨砂评分印记 -->
                                        <Border Visibility="{Binding Rating, Converter={StaticResource StringToVisibility}}"
                                                Background="{ThemeResource GlassDarkBadgeBrush}" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                CornerRadius="6" Padding="8,3"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="5" Height="5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Rating}" Style="{StaticResource MonoMetaText}"
                                                           FontWeight="SemiBold" Foreground="{ThemeResource GlassDarkBadgeInkBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <!-- 底部磨砂展陈铭牌 -->
                                        <Border VerticalAlignment="Bottom" Margin="10"
                                                Background="{ThemeResource GlassDarkBadgeBrush}"
                                                BorderBrush="#26FFFFFF" BorderThickness="1"
                                                CornerRadius="9" Padding="12,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Item.Remarks}" Style="{StaticResource MetaText}"
                                                           FontWeight="SemiBold" Foreground="{ThemeResource GlassDarkBadgeAccentBrush}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Item.Remarks, Converter={StaticResource StringToVisibility}}" />
                                                <TextBlock Text="{Binding Item.Name}" FontSize="{StaticResource FontSizeCardTitle}"
                                                           LineHeight="{StaticResource LineHeightCardTitle}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource GlassDarkBadgeInkBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 分类与筛选坞：常规态为极简 Hairline 带，滚动后平滑转入悬浮磨砂玻璃坞（纯 ThemeResource 自动响应深浅/高对比主题切换） -->
        <Grid x:Name="FilterDock" Grid.Row="2" Margin="0,10,0,12">
            <Border x:Name="FilterDockGlass"
                    Background="{ThemeResource GlassPanelBrush}"
                    BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                    CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="FilterDockDivider" Height="1"
                    Background="{ThemeResource DividerBrush}"
                    VerticalAlignment="Bottom" IsHitTestVisible="False" />
            <Grid x:Name="FilterBar" Padding="0,6,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource FilterChipStyle}" Content="{Binding Name}" Tag="{Binding}"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Click="OnCategoryPillClick" Margin="0,0,8,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <controls:AnchoredChoice Header="站点" ItemsSource="{Binding Sites}" MaxWidth="204"
                                             DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                                             PlaceholderText="选择站点" />
                    <Button x:Name="FilterButton" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                            AutomationProperties.Name="筛选">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:LineIcon PathData="{StaticResource IconFilter}" IconSize="16" />
                            <TextBlock Text="筛选" Style="{StaticResource SecondaryText}"
                                       Foreground="{ThemeResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="284" Spacing="14">
                                    <StackPanel Spacing="{StaticResource SpaceSmall}"
                                                Visibility="{Binding HasCategoryFilters, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                        <controls:AnchoredChoice Header="类型" ItemsSource="{Binding TypeFilters}"
                                                                 SelectedItem="{Binding TypeFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                        <TextBox Header="年份" Text="{Binding YearFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <controls:AnchoredChoice Header="排序" SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                                                                 Options="默认|年份" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding CategoryFilters}"
                                                  Visibility="{Binding HasCategoryFilters, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:AnchoredChoice Header="{Binding Name}" ItemsSource="{Binding Values}" DisplayMemberPath="Name"
                                                                         SelectedItem="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <ProgressBar Grid.Row="3" IsIndeterminate="{Binding IsLoading}" Height="2" Margin="0,0,0,10"
                     Foreground="{ThemeResource VermilionBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!-- 画框质感海报网格：内嵌艺术图景微缩放 + 磨砂圆镜播放徽章 -->
        <Grid Grid.Row="4">
            <GridView x:Name="Posters" AutomationProperties.Name="点播海报" Loaded="OnPostersLoaded"
                      Unloaded="OnPostersUnloaded" ItemsSource="{Binding Items}" SelectionMode="None"
                      ContainerContentChanging="OnPosterContainerChanging" SizeChanged="OnPosterViewportChanged"
                      Padding="0" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.IsVerticalScrollChainingEnabled="False">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="206" ItemHeight="350" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Button Padding="0" BorderThickness="0" Background="Transparent"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding Item.Name}"
                                Margin="0,4,18,20" Click="OnCardClick"
                                PointerEntered="OnCardIn" PointerExited="OnCardOut"
                                PointerPressed="OnCardPressed" PointerReleased="OnCardReleased" PointerCanceled="OnCardReleased">
                            <Grid RowSpacing="9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="270" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="PosterFrame" Grid.Row="0" CornerRadius="{StaticResource RadiusCard}"
                                        BorderThickness="1" BorderBrush="{ThemeResource GlassEdgeBrush}"
                                        Background="{ThemeResource PosterPlaceholderBrush}">
                                    <Grid>
                                        <controls:LineIcon PathData="{StaticResource IconFilm}" IconSize="30"
                                                           Foreground="{ThemeResource TertiaryTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="PosterArt" Source="{Binding Poster}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                                        <Rectangle VerticalAlignment="Bottom" Height="52" IsHitTestVisible="False">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#000B0B0D" Offset="0" />
                                                    <GradientStop Color="#6E0B0B0D" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Border Visibility="{Binding Item.Remarks, Converter={StaticResource StringToVisibility}}"
                                                Background="{ThemeResource GlassDarkBadgeBrush}" BorderBrush="#2EFFFFFF" BorderThickness="1"
                                                CornerRadius="5" Padding="7,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9">
                                            <TextBlock Text="{Binding Item.Remarks}" FontSize="{StaticResource FontSizeMeta}"
                                                       FontWeight="SemiBold" Foreground="{ThemeResource GlassDarkBadgeInkBrush}" MaxWidth="112" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border Visibility="{Binding Rating, Converter={StaticResource StringToVisibility}}"
                                                Background="{ThemeResource GlassDarkBadgeBrush}" BorderBrush="#2EFFFFFF" BorderThickness="1"
                                                CornerRadius="5" Padding="7,3"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Ellipse Width="4.5" Height="4.5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Rating}" Style="{StaticResource MonoMetaText}"
                                                           FontWeight="SemiBold" Foreground="{ThemeResource GlassDarkBadgeInkBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <!-- 磨砂圆镜播放浮层 -->
                                        <Grid x:Name="PlayOverlay" Background="#660B0B0D" Opacity="0">
                                            <Border x:Name="PlayBadge" Width="52" Height="52" CornerRadius="26"
                                                    Background="#E8F4F3EE" BorderBrush="#66FFFFFF" BorderThickness="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <controls:LineIcon PathData="{StaticResource IconPlaySolid}" IconSize="20" IsFilled="True"
                                                                   Margin="2,0,0,0" Foreground="#0D0D10" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding Item.Name}" Style="{StaticResource CardTitleText}" MaxLines="1" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Item.Year}" Style="{StaticResource MonoMetaText}"
                                               Visibility="{Binding Item.Year, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="·" Style="{StaticResource MetaText}"
                                               Visibility="{Binding Item.Year, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="{Binding Item.SiteName}" Style="{StaticResource MetaText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Button x:Name="BackToTop" Visibility="Collapsed" Click="OnTopClick"
                    Style="{StaticResource GlassFabButtonStyle}"
                    AutomationProperties.Name="回到顶部" ToolTipService.ToolTip="回到顶部"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,18">
                <controls:LineIcon PathData="{StaticResource IconArrowUp}" IconSize="18" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetaText}" VerticalAlignment="Center"
                       MaxWidth="460" TextTrimming="CharacterEllipsis" />
            <Button Content="完成验证" Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnVerifySiteClick"
                    AutomationProperties.Name="完成站点验证"
                    Visibility="{Binding HasPendingVerification, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="加载更多" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</Page>

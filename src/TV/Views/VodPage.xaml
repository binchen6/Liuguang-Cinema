<Page
    x:Class="TV.Views.VodPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TV.Converters"
    xmlns:controls="using:TV.Controls"
    Background="Transparent"
    Loaded="OnLoaded">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <Grid Padding="{StaticResource PagePaddingWide}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid x:Name="BrowseHeader" Grid.Row="0" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="点播" Style="{StaticResource PageTitleText}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnSearchClick"
                        AutomationProperties.Name="打开搜索">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                        <TextBlock Text="搜索" Style="{StaticResource SecondaryText}"
                                   Foreground="{ThemeResource PrimaryTextBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ReloadCommand}"
                        ToolTipService.ToolTip="重新加载" AutomationProperties.Name="重新加载">
                    <FontIcon Glyph="&#xE72C;" FontSize="18" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 精选横向画廊 -->
        <Grid x:Name="GalleryHost" Grid.Row="1" Margin="0,20,0,0">
            <ScrollViewer Height="196"
                          Visibility="{Binding ShowGallery, Converter={StaticResource BoolToVisibility}}"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding GalleryItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="320" Height="180" Margin="0,0,16,0" Padding="0" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Item.Name}"
                                    Loaded="OnFeaturedLoaded" Click="OnCardClick">
                                <Border CornerRadius="{StaticResource RadiusCard}" BorderThickness="1"
                                        BorderBrush="{ThemeResource SubtleBorderBrush}"
                                        Background="{ThemeResource PosterPlaceholderBrush}">
                                    <Grid>
                                        <Image Source="{Binding Poster}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.42" />
                                                    <GradientStop Color="#E60B0D12" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Border Visibility="{Binding Rating, Converter={StaticResource StringToVisibility}}"
                                                Background="#CC0B0D12" CornerRadius="{StaticResource RadiusControl}"
                                                Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                                            <TextBlock Text="{Binding Rating}" FontSize="{StaticResource FontSizeMeta}"
                                                       FontWeight="SemiBold" Foreground="{ThemeResource RatingBrush}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Bottom" Padding="16" Spacing="4">
                                            <TextBlock Text="{Binding Item.Remarks}" FontSize="{StaticResource FontSizeMeta}"
                                                       FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}"
                                                       Visibility="{Binding Item.Remarks, Converter={StaticResource StringToVisibility}}" />
                                            <TextBlock Text="{Binding Item.Name}" FontSize="{StaticResource FontSizeCardTitle}"
                                                       LineHeight="{StaticResource LineHeightCardTitle}" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 分类与筛选（滚动后吸顶） -->
        <Grid x:Name="FilterBar" Grid.Row="2" Margin="0,24,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource FilterChipStyle}" Content="{Binding Name}" Tag="{Binding}"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Click="OnCategoryPillClick" Margin="0,0,8,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <controls:AnchoredChoice Header="站点" ItemsSource="{Binding Sites}"
                                         DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                                         PlaceholderText="选择站点" />
                <Button Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                        AutomationProperties.Name="筛选">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71C;" FontSize="16" />
                        <TextBlock Text="筛选" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="280" Spacing="14">
                                <StackPanel Spacing="{StaticResource SpaceSmall}"
                                            Visibility="{Binding HasCategoryFilters, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                    <controls:AnchoredChoice Header="类型" ItemsSource="{Binding TypeFilters}"
                                                             SelectedItem="{Binding TypeFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <TextBox Header="年份" Text="{Binding YearFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <controls:AnchoredChoice Header="排序" SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                                                             Options="默认|年份" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding CategoryFilters}"
                                              Visibility="{Binding HasCategoryFilters, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:AnchoredChoice Header="{Binding Name}" ItemsSource="{Binding Values}" DisplayMemberPath="Name"
                                                                     SelectedItem="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="3" IsIndeterminate="{Binding IsLoading}" Height="3" Margin="0,0,0,12"
                     Foreground="{ThemeResource AccentFillBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!-- 海报流 -->
        <Grid Grid.Row="4">
            <GridView x:Name="Posters" AutomationProperties.Name="点播海报" Loaded="OnPostersLoaded"
                      Unloaded="OnPostersUnloaded" ItemsSource="{Binding Items}" SelectionMode="None"
                      ContainerContentChanging="OnPosterContainerChanging" SizeChanged="OnPosterViewportChanged"
                      Padding="0" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.IsVerticalScrollChainingEnabled="False">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="206" ItemHeight="386" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Button Padding="0" BorderThickness="0" Background="Transparent"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding Item.Name}"
                                Margin="0,0,18,22" Click="OnCardClick"
                                PointerEntered="OnCardIn" PointerExited="OnCardOut">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="282" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="PosterFrame" Grid.Row="0" CornerRadius="{StaticResource RadiusCard}"
                                        BorderThickness="1" BorderBrush="{ThemeResource SubtleBorderBrush}"
                                        Background="{ThemeResource PosterPlaceholderBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8B9;" FontSize="30"
                                                  Foreground="{ThemeResource TertiaryTextBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Poster}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                                        <Border Visibility="{Binding Item.Remarks, Converter={StaticResource StringToVisibility}}"
                                                Background="#CC0B0D12" CornerRadius="{StaticResource RadiusControl}"
                                                Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                            <TextBlock Text="{Binding Item.Remarks}" FontSize="{StaticResource FontSizeMeta}"
                                                       FontWeight="SemiBold" Foreground="#FFF2F4F9" />
                                        </Border>
                                        <Border Visibility="{Binding Rating, Converter={StaticResource StringToVisibility}}"
                                                Background="#CC0B0D12" CornerRadius="{StaticResource RadiusControl}"
                                                Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                            <TextBlock Text="{Binding Rating}" FontSize="{StaticResource FontSizeMeta}"
                                                       FontWeight="SemiBold" Foreground="{ThemeResource RatingBrush}" />
                                        </Border>
                                        <Grid x:Name="PlayOverlay" Background="#8C0B0D12" Opacity="0">
                                            <Border Width="52" Height="52" CornerRadius="26"
                                                    Background="{ThemeResource AccentFillBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE768;" FontSize="20"
                                                          Foreground="{ThemeResource AccentInkBrush}" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding Item.Name}" Style="{StaticResource CardTitleText}" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Item.Year}" Style="{StaticResource MetaText}" />
                                    <TextBlock Text="·" Style="{StaticResource MetaText}" />
                                    <TextBlock Text="{Binding Item.SiteName}" Style="{StaticResource MetaText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Button x:Name="BackToTop" Visibility="Collapsed" Click="OnTopClick"
                    AutomationProperties.Name="回到顶部" ToolTipService.ToolTip="回到顶部"
                    Width="44" Height="44" Padding="0" CornerRadius="22"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,18"
                    Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource StrongBorderBrush}"
                    BorderThickness="1">
                <FontIcon Glyph="&#xE74A;" FontSize="18" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetaText}" VerticalAlignment="Center"
                       MaxWidth="460" TextTrimming="CharacterEllipsis" />
            <Button Content="加载更多" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</Page>

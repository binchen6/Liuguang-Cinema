<Page x:Class="TV.Views.SettingsPage" x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:TV.Controls"
      Background="Transparent" Loaded="OnLoaded">
    <Page.Resources>
        <!-- 设置页尺寸：左侧分区导航、表单标签列、内容最大宽度 -->
        <x:Double x:Key="SettingsNavWidth">160</x:Double>
        <x:Double x:Key="SettingsFormLabelWidth">100</x:Double>
        <x:Double x:Key="SettingsFormControlWidth">240</x:Double>
        <x:Double x:Key="SettingsContentMaxWidth">960</x:Double>
        <x:Double x:Key="SettingsRowMinHeight">56</x:Double>
        <Thickness x:Key="SettingsScrollPadding">24</Thickness>

        <!-- 左侧分区导航项：48 高、选中态＝暖金底 + 金色指示条；点击/展开切换右侧内容 -->
        <Style x:Key="SettingsNavSectionStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <ToggleButton x:Name="HeaderToggle"
                                      Content="{TemplateBinding Header}"
                                      Height="{StaticResource NavItemHeight}"
                                      Padding="0,0,12,0"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      Background="Transparent" BorderThickness="0"
                                      CornerRadius="{StaticResource RadiusControl}"
                                      UseSystemFocusVisuals="True"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid x:Name="Root" Background="{TemplateBinding Background}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          Padding="{TemplateBinding Padding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Indicator" Width="3" Height="20" CornerRadius="{StaticResource RadiusTag}"
                                                Background="{ThemeResource SelectionIndicatorBrush}" Opacity="0"
                                                VerticalAlignment="Center" />
                                        <ContentPresenter x:Name="Presenter" Grid.Column="1"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Margin="8,0,0,0"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="Root.Background" Value="{ThemeResource NavHoverBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                            </VisualStateGroup>
                                            <VisualStateGroup x:Name="CheckStates">
                                                <VisualState x:Name="Unchecked" />
                                                <VisualState x:Name="Checked">
                                                    <VisualState.Setters>
                                                        <Setter Target="Root.Background" Value="{ThemeResource SelectionBrush}" />
                                                        <Setter Target="Indicator.Opacity" Value="1" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Indeterminate" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePaddingWide}" RowSpacing="{StaticResource SpaceLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Spacing="{StaticResource SpaceTiny}">
            <TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="片源、播放、网盘、网络与外观设置，按分区切换查看。" Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <!-- 左侧分区导航 + 右侧内容 -->
        <Grid Grid.Row="1" ColumnSpacing="{StaticResource SpaceLarge}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="{StaticResource SettingsNavWidth}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Padding="0,0,16,0">
                <StackPanel Spacing="{StaticResource SpaceTiny}">
                    <!-- 片源 -->
                    <Expander x:Name="SourceSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="片源" ToolTipService.ToolTip="片源">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="片源" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 播放 -->
                    <Expander x:Name="PlaybackSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="播放" ToolTipService.ToolTip="播放">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="播放" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 网盘 -->
                    <Expander x:Name="CloudSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="网盘" ToolTipService.ToolTip="网盘">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE753;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="网盘" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 网络 -->
                    <Expander x:Name="NetworkSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="网络" ToolTipService.ToolTip="网络">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE839;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="网络" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 外观与内容 -->
                    <Expander x:Name="AppearanceSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="外观与内容" ToolTipService.ToolTip="外观与内容">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="外观与内容" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 存储 -->
                    <Expander x:Name="StorageSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="存储" ToolTipService.ToolTip="存储">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE7B8;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="存储" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 关于 -->
                    <Expander x:Name="AboutSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="关于" ToolTipService.ToolTip="关于">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="关于" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" RowSpacing="{StaticResource SpaceSmall}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 设置内容：右侧内容区的滚动容器（workspace_layout 断言按此名称取 bounds/滚动） -->
                <ScrollViewer x:Name="SettingsScroller" AutomationProperties.Name="设置内容"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                              Padding="{StaticResource SettingsScrollPadding}">
                    <Grid MaxWidth="{StaticResource SettingsContentMaxWidth}" HorizontalAlignment="Left">
                        <!-- ============ 片源 ============ -->
                        <StackPanel x:Name="SourcePane" Spacing="{StaticResource SpaceMedium}">
                            <TextBlock Text="片源与接口" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="导入接口仓库、刷新内置接口，并确认当前生效的来源。" Style="{StaticResource SecondaryText}" />
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <Button Content="导入仓库" Style="{StaticResource PrimaryButtonStyle}">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <StackPanel Width="320" Spacing="{StaticResource SpaceSmall}"
                                                        AutomationProperties.Name="仓库链接">
                                                <TextBox Header="仓库链接"
                                                         Text="{Binding NewSourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="https://" InputScope="Url" />
                                                <Button Content="导入" Command="{Binding AddSourceCommand}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetaText}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Content="刷新接口" Command="{Binding ReloadCommand}"
                                        Height="{StaticResource PrimaryButtonHeight}" MinHeight="{StaticResource PrimaryButtonHeight}"
                                        Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="已导入仓库" Style="{StaticResource LabelText}" Margin="0,8,0,0" />
                            <ItemsControl ItemsSource="{Binding ImportedRepositories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,10">
                                            <Grid ColumnSpacing="{StaticResource SpaceMedium}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="{StaticResource SpaceTiny}">
                                                    <TextBlock Text="{Binding Url}" Style="{StaticResource BodyText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{Binding Url}" />
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MetaText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                        Tag="{Binding}" Click="OnRemoveSourceClick"
                                                        ToolTipService.ToolTip="删除仓库"
                                                        AutomationProperties.Name="删除仓库">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="自动刷新接口" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoRefreshSources, Mode=TwoWay}"
                                              OnContent="" OffContent="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前生效来源" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ActiveSource}" Style="{StaticResource MetaText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <StackPanel Spacing="{StaticResource SpaceTiny}">
                                <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LastSourceRefresh}" Style="{StaticResource MetaText}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ============ 播放 ============ -->
                        <StackPanel x:Name="PlaybackPane" Spacing="{StaticResource SpaceMedium}"
                                    Visibility="Collapsed">
                            <TextBlock Text="播放" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="解码、连播与缓存策略；修改即时保存。" Style="{StaticResource SecondaryText}" />
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="硬件解码" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding HardwareDecoding, Mode=TwoWay}"
                                              OnContent="" OffContent="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="弱网自动画质" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding AdaptiveQuality, Mode=TwoWay}" OnContent="" OffContent="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="自动连播" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoNext, Mode=TwoWay}"
                                              OnContent="" OffContent="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="续播" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding ResumePlayback, Mode=TwoWay}"
                                              OnContent="" OffContent="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <TextBlock Text="缓存与音量" Style="{StaticResource LabelText}" />
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="点播缓存 (ms)" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}"
                                           Minimum="1200" Maximum="12000" SpinButtonPlacementMode="Inline"
                                           Value="{Binding NetworkCache, Mode=TwoWay}" HorizontalAlignment="Left" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="直播缓存 (ms)" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}"
                                           Minimum="500" Maximum="8000" SpinButtonPlacementMode="Inline"
                                           Value="{Binding LiveCache, Mode=TwoWay}" HorizontalAlignment="Left" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="默认音量" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}" Minimum="0" Maximum="100"
                                           SpinButtonPlacementMode="Inline" Value="{Binding DefaultVolume, Mode=TwoWay}" HorizontalAlignment="Left" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="默认画质" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <controls:AnchoredChoice Grid.Column="1" Header="默认画质" Options="自动|原画|1080p|720p|420p" SelectedIndex="{Binding DefaultQualityIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="失败自动切线" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoSwitchLine, Mode=TwoWay}" OnContent="" OffContent="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- ============ 网盘 ============ -->
                        <StackPanel x:Name="CloudPane" Spacing="{StaticResource SpaceMedium}" Visibility="Collapsed">
                            <TextBlock Text="网盘" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="阿里、夸克、UC 与百度网盘；凭据使用当前用户 DPAPI 加密保存。" Style="{StaticResource SecondaryText}" />
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceTiny}">
                                    <TextBlock Text="账号与状态" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="四个网盘共用同一套扫码、验证和播放恢复流程。" Style="{StaticResource MetaText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开我的云盘" Command="{Binding OpenCloudDriveCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="打开我的云盘" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CloudAccounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="72" ColumnSpacing="{StaticResource SpaceSmall}" Padding="0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpaceTiny}">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" />
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource MetaText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                                                <Button Content="扫码" Tag="{Binding Provider}" Click="OnCloudQrClick" Style="{StaticResource SecondaryButtonStyle}"
                                                        AutomationProperties.Name="{Binding LoginAutomationName}" />
                                                <Button Content="验证" Command="{Binding DataContext.VerifyCloudCommand, ElementName=PageRoot}" CommandParameter="{Binding Provider}"
                                                        Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="验证网盘登录" />
                                                <Button Content="退出" Tag="{Binding Provider}" Click="OnLogoutCloudClick" Style="{StaticResource GhostButtonStyle}"
                                                        AutomationProperties.Name="退出网盘登录" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <TextBlock Text="手动输入凭据" Style="{StaticResource LabelText}" />
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="阿里 Token" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <PasswordBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}"
                                             MinHeight="{StaticResource SecondaryButtonHeight}"
                                             PlaceholderText="粘贴 Token" HorizontalAlignment="Left"
                                             Password="{Binding AliToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="夸克 Cookie" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <PasswordBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}"
                                             MinHeight="{StaticResource SecondaryButtonHeight}"
                                             PlaceholderText="粘贴 Cookie" HorizontalAlignment="Left"
                                             Password="{Binding QuarkCookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="UC Cookie" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <PasswordBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}"
                                             MinHeight="{StaticResource SecondaryButtonHeight}"
                                             PlaceholderText="粘贴 Cookie" HorizontalAlignment="Left"
                                             Password="{Binding UcCookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="百度 Cookie" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <PasswordBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}"
                                             MinHeight="{StaticResource SecondaryButtonHeight}" PlaceholderText="已保存凭据时留空即可"
                                             Password="{Binding BaiduCookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />
                            </Grid>
                            <Button Content="加密保存" Command="{Binding SaveCloudCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceTiny}">
                                    <TextBlock Text="安全播放加速" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="严格校验字节范围；限流时自动退避并降为单连接。" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="恢复默认" Command="{Binding ResetCloudAccelerationCommand}" Style="{StaticResource GhostButtonStyle}" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="启用预读加速" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding CloudAcceleration, Mode=TwoWay}" OnContent="" OffContent="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="连接数" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" MinWidth="160" Maximum="6" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding CloudThreads, Mode=TwoWay}" HorizontalAlignment="Left" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="预读分块 (MB)" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" MinWidth="160" Maximum="8" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding CloudChunkMb, Mode=TwoWay}" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>

                        <!-- ============ 网络 ============ -->
                        <StackPanel x:Name="NetworkPane" Spacing="{StaticResource SpaceMedium}" Visibility="Collapsed">
                            <TextBlock Text="网络" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="安全 DNS、网盘连接与跨站搜索请求参数。" Style="{StaticResource SecondaryText}" />
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DNS 解析" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <controls:AnchoredChoice Grid.Column="1" Header="安全 DNS" MinWidth="160"
                                                         MinHeight="{StaticResource SecondaryButtonHeight}"
                                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                                         SelectedIndex="{Binding DnsIndex, Mode=TwoWay}"
                                                         Options="系统默认|阿里 DoH|腾讯 DoH|114 DNS|360 DNS|百度 DNS" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="跨站搜索并发" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}"
                                           Minimum="1" Maximum="6" SpinButtonPlacementMode="Inline"
                                           Value="{Binding SearchConcurrency, Mode=TwoWay}" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>

                        <!-- ============ 外观与内容 ============ -->
                        <StackPanel x:Name="AppearancePane" Spacing="{StaticResource SpaceMedium}" Visibility="Collapsed">
                            <TextBlock Text="外观与内容" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="主题、动效、窗口行为与推荐内容偏好。" Style="{StaticResource SecondaryText}" />
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="颜色主题" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <controls:AnchoredChoice Grid.Column="1" Header="主题" MinWidth="160"
                                                         MinHeight="{StaticResource SecondaryButtonHeight}"
                                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                                         SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                                                         Options="深色|浅色|跟随系统" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="界面动效" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding AnimationsEnabled, Mode=TwoWay}"
                                              OnContent="" OffContent="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最小化到托盘" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding MinimizeToTray, Mode=TwoWay}"
                                              OnContent="" OffContent="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关闭按钮行为" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <controls:AnchoredChoice Grid.Column="1" Header="关闭窗口时" MinWidth="160"
                                                         MinHeight="{StaticResource SecondaryButtonHeight}"
                                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                                         SelectedIndex="{Binding CloseBehaviorIndex, Mode=TwoWay}"
                                                         Options="每次询问|最小化到托盘|退出应用" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="豆瓣封面与评分" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding DoubanEnabled, Mode=TwoWay}"
                                              OnContent="" OffContent="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="推荐内容" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <controls:AnchoredChoice Grid.Column="1" Header="推荐来源" MinWidth="160"
                                                         MinHeight="{StaticResource SecondaryButtonHeight}"
                                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                                         SelectedIndex="{Binding RecommendationSourceIndex, Mode=TwoWay}"
                                                         Options="站点推荐|豆瓣推荐" />
                            </Grid>
                        </StackPanel>

                        <!-- ============ 存储 ============ -->
                        <StackPanel x:Name="StoragePane" Spacing="{StaticResource SpaceMedium}" Visibility="Collapsed">
                            <TextBlock Text="存储" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="清理缓存不会删除收藏、播放记录与网盘凭据。" Style="{StaticResource SecondaryText}" />
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StorageSummary}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                                    <Button Content="刷新统计" Command="{Binding RefreshStorageCommand}" Style="{StaticResource GhostButtonStyle}" />
                                    <Button Content="打开目录" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="打开数据目录" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="默认下载目录" Style="{StaticResource LabelText}" />
                            <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DownloadFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="视频库\流光影院" AutomationProperties.Name="默认下载目录" />
                                <Button Grid.Column="1" Content="浏览" Command="{Binding SelectDownloadFolderCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="批量下载保存到这里；单集另存仍可自行选择位置。清理缓存不会删除已下载视频。"
                                       Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <TextBlock Text="分项清理" Style="{StaticResource LabelText}" />
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="图片缓存" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="海报与剧照缩略图缓存" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="清除" Command="{Binding ClearImagesCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="元数据缓存" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="站点详情与搜索元数据" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="清除" Command="{Binding ClearMetadataCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="播放记录" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="继续观看与历史记录" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="清除" Click="OnClearHistoryClick"
                                        Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="收藏" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="跨站点收藏列表" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="清除" Click="OnClearFavoritesClick"
                                        Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <TextBlock Text="高级清理" Style="{StaticResource LabelText}" />
                            <TextBlock Text="先扫描再选择。应用缓存默认勾选；已下载媒体、其它软件临时文件与回收站需要单独确认。"
                                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                                <Button Content="扫描可清理项" Command="{Binding ScanCleanupCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="扫描可清理项" />
                                <Button Content="清理选中项" Click="OnCleanSelectedClick" Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.Name="清理选中项" />
                                <ProgressRing Width="24" Height="24" IsActive="{Binding IsCleaning}"
                                              Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding CleanupSummary}" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                       Visibility="{Binding CleanupSummary, Converter={StaticResource StringToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding CleanupCategories}"
                                          Visibility="{Binding HasCleanupResults, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" MinHeight="64" Padding="0,8"
                                                  HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="{StaticResource SpaceTiny}">
                                                <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource MetaText}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <TextBlock Text="全部缓存" Style="{StaticResource LabelText}" />
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="缓存清理" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <DropDownButton Grid.Column="1" Content="清理" HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                MinHeight="{StaticResource SecondaryButtonHeight}"
                                                AutomationProperties.Name="清理">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuFlyoutItem Text="全部缓存" Command="{Binding ClearCachesCommand}" />
                                            <MenuFlyoutItem Text="图片缓存" Command="{Binding ClearImagesCommand}" />
                                            <MenuFlyoutItem Text="元数据缓存" Command="{Binding ClearMetadataCommand}" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>
                            <TextBlock Text="全部缓存包含图片缓存与元数据缓存；播放记录与收藏需要单独确认清理。"
                                       Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- ============ 关于 ============ -->
                        <StackPanel x:Name="AboutPane" Spacing="{StaticResource SpaceMedium}" Visibility="Collapsed">
                            <TextBlock Text="关于" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="流光影院 · 深墨底与暖金流光的桌面影院。" Style="{StaticResource SecondaryText}" />
                            <Border Height="1" Background="{ThemeResource DividerBrush}" />
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="应用名称" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="流光影院" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="版本" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <TextBlock x:Name="AppVersionText" Grid.Column="1" Style="{StaticResource MetaText}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="视觉语言" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="深墨底 · 暖金流光" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据安全" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="网盘凭据经 DPAPI 加密保存，日志不输出敏感内容。"
                                           Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                                <Button Content="打开数据目录" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="查看诊断日志" Command="{Binding OpenDiagnosticsCommand}" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="查看诊断日志" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 状态提示（导入、清理、登录结果） -->
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource MetaText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</Page>

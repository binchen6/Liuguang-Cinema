<Page
    x:Class="TV.Views.DetailPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TV.Converters"
    xmlns:controls="using:TV.Controls"
    Background="Transparent"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <local:BoolToFavoriteConverter x:Key="FavoriteText" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
        <local:IntroMaxLinesConverter x:Key="IntroMaxLines" />
        <local:IntroToggleTextConverter x:Key="IntroToggleText" />
        <!-- 详情页专用的版式尺寸（规格：封面 260×390） -->
        <x:Double x:Key="DetailCoverWidth">260</x:Double>
        <x:Double x:Key="DetailCoverHeight">390</x:Double>
        <x:Double x:Key="EpisodePanelMaxHeight">430</x:Double>
        <x:Double x:Key="DetailActionWidth">112</x:Double>
        <Style x:Key="DetailActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="{StaticResource DetailActionWidth}" />
            <Setter Property="Height" Value="{StaticResource PrimaryButtonHeight}" />
            <Setter Property="MinHeight" Value="{StaticResource PrimaryButtonHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DetailPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="{StaticResource DetailActionWidth}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePaddingStandard}" Spacing="{StaticResource SpaceXLarge}">

            <!-- 主信息：左封面 + 右标题/元数据/简介/主操作 -->
            <Grid x:Name="HeroGrid" ColumnSpacing="{StaticResource SpaceXLarge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CoverColumn" Width="Auto" />
                    <ColumnDefinition x:Name="InfoColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="CoverFrame" Width="{StaticResource DetailCoverWidth}"
                        Height="{StaticResource DetailCoverHeight}"
                        CornerRadius="{StaticResource RadiusCard}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource SubtleBorderBrush}"
                        Background="{ThemeResource PosterPlaceholderBrush}"
                        VerticalAlignment="Top">
                    <Grid>
                        <FontIcon Glyph="&#xE8B9;" FontSize="40"
                                  Foreground="{ThemeResource TertiaryTextBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding SelectedCard.Poster}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                    </Grid>
                </Border>

                <StackPanel x:Name="DetailInfo" Grid.Column="1" Spacing="{StaticResource SpaceMedium}" VerticalAlignment="Top">
                    <StackPanel Spacing="{StaticResource SpaceSmall}">
                        <TextBlock Text="{Binding Detail.Name}" Style="{StaticResource PageTitleText}" />
                        <ItemsControl ItemsSource="{Binding DetailMetadata}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" Margin="0,0,8,6" Background="{ThemeResource SurfaceAltBrush}"
                                            CornerRadius="{StaticResource RadiusTag}">
                                        <TextBlock Text="{Binding}" Style="{StaticResource MetaText}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 简介：默认最多 6 行，可展开全文 -->
                    <StackPanel Spacing="{StaticResource SpaceMini}"
                                Visibility="{Binding Detail.Description, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="简介" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding Detail.Description}" Style="{StaticResource BodyText}"
                                   MaxLines="6" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsIntroExpanded, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                        <TextBlock Text="{Binding Detail.Description}" Style="{StaticResource BodyText}"
                                   Visibility="{Binding IsIntroExpanded, Converter={StaticResource BoolToVisibility}}" />
                        <HyperlinkButton Content="{Binding IsIntroExpanded, Converter={StaticResource IntroToggleText}}"
                                         Command="{Binding ToggleIntroCommand}"
                                         Visibility="{Binding CanExpandIntro, Converter={StaticResource BoolToVisibility}}"
                                         HorizontalAlignment="Left" Padding="0" />
                    </StackPanel>

                    <!-- 主操作「播放」最突出，收藏 / 下载 / 投屏为次操作 -->
                    <Grid x:Name="ActionButtons" ColumnSpacing="12" RowSpacing="12" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ActionSecondRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Button x:Name="PlayAction" Content="{Binding PrimaryPlayText}"
                                Style="{StaticResource DetailPrimaryButtonStyle}"
                                Click="OnPlayFirstClick"
                                AutomationProperties.Name="播放" />
                        <Button x:Name="FavoriteAction" Grid.Column="1" Content="{Binding IsFavorite, Converter={StaticResource FavoriteText}}"
                                Command="{Binding ToggleFavoriteCommand}"
                                Style="{StaticResource DetailActionButtonStyle}"
                                AutomationProperties.Name="收藏" />
                        <Button x:Name="DownloadAction" Grid.Column="2" Style="{StaticResource DetailActionButtonStyle}"
                                AutomationProperties.Name="下载"
                                ToolTipService.ToolTip="选择集数并另存为本地文件">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                                <FontIcon Glyph="&#xE896;" FontSize="16"
                                          Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                <ProgressRing Width="16" Height="16" IsActive="{Binding IsDownloading}"
                                              Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="下载" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Width="320" Spacing="{StaticResource SpaceSmall}">
                                        <TextBlock Text="选择一集或多集，批量下载会保存到设置中的默认目录。"
                                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                        <ListView x:Name="EpisodeToSave" ItemsSource="{Binding Episodes}"
                                                  SelectionMode="Multiple" MaxHeight="220" AutomationProperties.Name="下载集数">
                                            <ListView.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" /></DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock Text="{Binding DownloadStatus}" Style="{StaticResource SecondaryText}"
                                                   Visibility="{Binding DownloadStatus, Converter={StaticResource StringToVisibility}}" />
                                        <ProgressBar Value="{Binding DownloadProgress}"
                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Spacing="{StaticResource SpaceMini}">
                                            <Button Content="下载选中" Click="OnSaveClick" HorizontalAlignment="Stretch"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                            <Grid ColumnSpacing="{StaticResource SpaceMini}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Button Content="全选 / 取消全选" Click="OnSelectAllEpisodesClick" Style="{StaticResource GhostButtonStyle}"
                                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                                <Button Grid.Column="1" Content="单集另存" Click="OnSaveAsClick" Style="{StaticResource GhostButtonStyle}"
                                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                            </Grid>
                                            <Button Content="取消下载" Command="{Binding CancelDownloadCommand}" HorizontalAlignment="Stretch"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="CastAction" Grid.Column="3" Content="投屏"
                                Style="{StaticResource DetailActionButtonStyle}"
                                Click="OnCastClick"
                                ToolTipService.ToolTip="打开投屏页"
                                AutomationProperties.Name="投屏" />
                    </Grid>

                    <TextBlock Text="{Binding DetailStatus}" Style="{StaticResource SecondaryText}"
                               Visibility="{Binding DetailStatus, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>

            <!-- 来源与线路 / 选集 -->
            <Grid x:Name="ContentColumns" ColumnSpacing="{StaticResource SpaceXLarge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SourceColumn" Width="2*" />
                    <ColumnDefinition x:Name="EpisodeColumn" Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="SourcePane" Spacing="{StaticResource SpaceMedium}">
                    <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="来源与线路" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="查找换源" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding FindSourcesCommand}"
                                AutomationProperties.Name="查找换源" ToolTipService.ToolTip="搜索同名、同年份且包含播放线路的其他站点" />
                    </Grid>
                    <Grid ColumnSpacing="{StaticResource SpaceMini}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:AnchoredChoice Header="片源"
                                                 ItemsSource="{Binding DetailSources}"
                                                 DisplayMemberPath="SourceName"
                                                 SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                                                 MinWidth="0" HorizontalAlignment="Stretch" />
                        <controls:AnchoredChoice Grid.Column="1" Header="线路"
                                                 ItemsSource="{Binding Lines}"
                                                 DisplayMemberPath="Name"
                                                 SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                                 MinWidth="0" HorizontalAlignment="Stretch" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}"
                                Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing Width="20" Height="20" IsActive="{Binding IsDetailLoading}" />
                        <TextBlock Text="正在载入线路…" Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Expander Header="演职员"
                              Visibility="{Binding HasCredits, Converter={StaticResource BoolToVisibility}}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="{StaticResource SpaceSmall}">
                            <StackPanel Spacing="{StaticResource SpaceTiny}"
                                        Visibility="{Binding Detail.Director, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="导演" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding Detail.Director}" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource SpaceTiny}"
                                        Visibility="{Binding Detail.Actor, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="主演" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding Detail.Actor}" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Button Content="原站分享"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Visibility="{Binding Detail.HasSourceShares, Converter={StaticResource BoolToVisibility}}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <ListView MaxHeight="320" MinWidth="208" ItemsSource="{Binding Detail.SourceShares}"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <HyperlinkButton NavigateUri="{Binding Address}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" />
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource MetaText}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="EpisodePane" Grid.Column="1" Spacing="{StaticResource SpaceMedium}">
                    <Grid ColumnSpacing="{StaticResource SpaceMini}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="选集" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="160" MinHeight="36"
                                 PlaceholderText="搜索集数" AutomationProperties.Name="搜索集数"
                                 Text="{Binding EpisodeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <GridView x:Name="EpisodeGrid" ItemsSource="{Binding Episodes}"
                              SelectionMode="None"
                              MaxHeight="{StaticResource EpisodePanelMaxHeight}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.IsVerticalScrollChainingEnabled="False">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Tag="{Binding}"
                                        Click="OnPlayEpisodeClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Grid>

            <!-- 相关推荐：复用点播浏览池的横排海报流 -->
            <StackPanel x:Name="RelatedSection" Spacing="{StaticResource SpaceMedium}">
                <TextBlock Text="相关推荐" Style="{StaticResource SectionTitleText}" />
                <ListView x:Name="RelatedList"
                          ItemsSource="{Binding Items}"
                          SelectionMode="None"
                          Background="Transparent"
                          BorderThickness="0"
                          ContainerContentChanging="OnRelatedContainerChanging"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.IsHorizontalScrollChainingEnabled="False">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,18,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Width="{StaticResource PosterWidthCompact}"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Item.Name}"
                                    Click="OnRelatedClick">
                                <StackPanel Spacing="{StaticResource SpaceMini}">
                                    <Border Height="{StaticResource PosterHeightCompact}"
                                            CornerRadius="{StaticResource RadiusCard}"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource SubtleBorderBrush}"
                                            Background="{ThemeResource PosterPlaceholderBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8B9;" FontSize="28"
                                                      Foreground="{ThemeResource TertiaryTextBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Poster}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                                            <Border Visibility="{Binding Rating, Converter={StaticResource StringToVisibility}}"
                                                    Background="#CC0B0D12"
                                                    CornerRadius="{StaticResource RadiusTag}"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="10">
                                                <TextBlock Text="{Binding Rating}" Style="{StaticResource MetaText}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource RatingBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Item.Name}" Style="{StaticResource CardTitleText}" />
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                                        <TextBlock Text="{Binding Item.Year}" Style="{StaticResource MetaText}" />
                                        <TextBlock Text="·" Style="{StaticResource MetaText}" />
                                        <TextBlock Text="{Binding Item.SiteName}" Style="{StaticResource MetaText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

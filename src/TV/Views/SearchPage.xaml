<Page
    x:Class="TV.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TV.Controls"
    xmlns:local="using:TV.Converters"
    Background="Transparent"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
        <Style x:Key="SearchRowContainer" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="{StaticResource ListRowHeight}" />
        </Style>
        <Style x:Key="SearchSiteContainer" TargetType="ListViewItem" BasedOn="{StaticResource SearchRowContainer}">
            <Setter Property="Padding" Value="{StaticResource ControlPaddingHorizontal}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePaddingWide}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 画册级索引报头 -->
        <StackPanel x:Name="SearchHeader" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="5" Height="5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                <TextBlock Text="INDEX · MULTI-SITE" Style="{StaticResource EyebrowText}" />
            </StackPanel>
            <TextBlock Text="搜索" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="跨站点查找片名、年份或类型，逐站显示进度与结果"
                       Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <!-- 一体化五层光学磨砂命令搜索条：回车或点按才提交；底部内嵌细丝朱砂搜索进度线 -->
        <controls:GlassSurface x:Name="SearchCommandBar" Grid.Row="1" Margin="0,20,0,22"
                               Style="{StaticResource AppBarGlassStyle}" Padding="10,8">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:SearchTextBox x:Name="QueryBox"
                                            PlaceholderText="片名、年份或类型，输入时显示建议"
                                            MaxLength="160"
                                            AutomationProperties.Name="搜索关键词"
                                            VerticalAlignment="Center"
                                            Padding="14,10"
                                            Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="OnSuggestionTextChanged"
                                            TextInputReceived="OnQueryTextInputReceived"
                                            EditingKeyDown="OnQueryKeyDown"
                                            LostFocus="OnQueryLostFocus"
                                            SizeChanged="OnQuerySizeChanged" />
                    <Button x:Name="SearchSubmitButton" Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center"
                            Command="{Binding SubmitCommand}"
                            AutomationProperties.Name="搜索"
                            ToolTipService.ToolTip="搜索（回车）">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:LineIcon PathData="{StaticResource IconSearch}" IconSize="15"
                                               Foreground="{ThemeResource AccentInkBrush}" />
                            <TextBlock Text="搜索" FontWeight="SemiBold" Foreground="{ThemeResource AccentInkBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ProgressBar Grid.Row="1" IsIndeterminate="{Binding IsSearching}"
                             Foreground="{ThemeResource VermilionBrush}"
                             Height="2" Margin="2,8,2,0"
                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </controls:GlassSurface>

        <!-- 主体：左侧一体化磨砂站点遥测面板 + 右侧开放式历史/画框结果流 -->
        <Grid x:Name="SearchBody" Grid.Row="2"
              ColumnSpacing="{StaticResource SpaceLarge}"
              RowSpacing="{StaticResource SpaceSmall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 左侧五层光学磨砂站点遥测面板（标题与列表完整封装，统一竖向导航 + 弹性朱砂指示条） -->
            <controls:GlassSurface Grid.Row="0" Grid.RowSpan="2" Width="244"
                                   CornerRadius="{StaticResource RadiusPanel}" Padding="10,12,6,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"
                            Padding="6,2,6,10" Margin="0,0,4,0">
                        <Grid ColumnSpacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="站点" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="SITES" Style="{StaticResource EyebrowText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Grid x:Name="ScopeRailHost" Grid.Row="1">
                        <ListView x:Name="ScopeList" AutomationProperties.Name="搜索站点"
                                  ItemsSource="{Binding Scopes}"
                                  SelectedItem="{Binding Scope, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0,0,8,0"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ItemContainerStyle="{StaticResource SearchScopeNavItemStyle}"
                                  ContainerContentChanging="OnScopeContainerChanging">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource NavItemTextStyle}" FontWeight="SemiBold"
                                                       MaxLines="1" />
                                            <TextBlock Text="{Binding Group.Status}" Style="{StaticResource MetaText}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Group.Status, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Content="验证"
                                                    Click="OnVerifyClick"
                                                    DataContext="{Binding Group}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Height="32" MinHeight="32" Padding="10,0"
                                                    AutomationProperties.Name="验证站点"
                                                    ToolTipService.ToolTip="完成站点安全验证并重新搜索"
                                                    Visibility="{Binding CanVerify, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                            <Button Content="重试"
                                                    Click="OnRetryClick"
                                                    DataContext="{Binding Group}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    AutomationProperties.Name="重试"
                                                    ToolTipService.ToolTip="重新搜索该站点"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border x:Name="ScopeGlideIndicator" Width="3" Height="22" CornerRadius="1.5"
                                Background="{ThemeResource SelectionIndicatorBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,0,0,0" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </controls:GlassSurface>

            <!-- 右列头（底部分隔线对齐左侧站点面板，构建清晰双栏基准线） -->
            <Border Grid.Column="1" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"
                    Padding="0,0,0,10">
                <Grid ColumnSpacing="{StaticResource SpaceSmall}" MinHeight="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="搜索历史" Style="{StaticResource SectionTitleText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowsHistory, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ResultsHeading}" Style="{StaticResource CardTitleText}"
                               VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowsHistory, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                Visibility="{Binding ShowsHistory, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="清空"
                                Command="{Binding ClearHistoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="清空"
                                Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button x:Name="FilterButton" Grid.Column="2"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="筛选"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowsHistory, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                            <controls:LineIcon PathData="{StaticResource IconFilter}" IconSize="16" />
                            <TextBlock Text="筛选" Style="{StaticResource SecondaryText}"
                                       Foreground="{ThemeResource PrimaryTextBrush}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="{StaticResource SpaceSmall}" Width="244">
                                    <controls:AnchoredChoice Header="类型" ItemsSource="{Binding Types}"
                                                             SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                                             HorizontalAlignment="Stretch" />
                                    <TextBox Header="年份"
                                             Text="{Binding Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="4" />
                                    <controls:AnchoredChoice Header="排序" Options="相关度|年份"
                                                             SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                                                             HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <!-- 右列：历史态（极简 Hairline 索引列表 / 空态） -->
            <Grid Grid.Row="1" Grid.Column="1"
                  Visibility="{Binding ShowsHistory, Converter={StaticResource BoolToVisibility}}">
                <ListView ItemsSource="{Binding RecentSearches}"
                          SelectionMode="None"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0,0,12,0"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ItemContainerStyle="{StaticResource SearchRowContainer}"
                          Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="{StaticResource SpaceMini}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Click="OnHistoryClick"
                                            DataContext="{Binding}"
                                            AutomationProperties.Name="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,0"
                                            MinHeight="{StaticResource ListRowHeight}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                            <controls:LineIcon PathData="{StaticResource IconClock}" IconSize="16"
                                                               Foreground="{ThemeResource TertiaryTextBrush}" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource BodyText}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Click="OnRemoveHistoryClick"
                                            DataContext="{Binding}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="删除此条搜索记录"
                                            AutomationProperties.Name="删除此条搜索记录">
                                        <controls:LineIcon PathData="{StaticResource IconTrash}" IconSize="15"
                                                           Foreground="{ThemeResource SecondaryTextBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Spacing="{StaticResource SpaceSmall}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="{StaticResource TextParagraphMaxWidth}"
                            Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{ThemeResource GlassPanelBrush}"
                            BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <controls:LineIcon PathData="{StaticResource IconClock}" IconSize="28"
                                           Foreground="{ThemeResource SecondaryTextBrush}" />
                    </Border>
                    <TextBlock Text="暂无搜索记录" Style="{StaticResource SectionTitleText}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="搜索过的关键词会显示在这里，点一下即可再次搜索。"
                               Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 右列：结果态 -->
            <Grid Grid.Row="1" Grid.Column="1"
                  Visibility="{Binding ShowsHistory, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                <Grid>
                    <GridView x:Name="ResultsList"
                              AutomationProperties.Name="搜索结果"
                              ItemsSource="{Binding Rows}"
                              SelectionMode="None"
                              Background="Transparent"
                              BorderThickness="0"
                              ContainerContentChanging="OnResultContainerChanging"
                              SizeChanged="OnResultSizeChanged"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.IsVerticalScrollChainingEnabled="False">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="206" ItemHeight="382" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Item.Name}"
                                        Margin="0,4,18,18"
                                        Click="OnResultClick"
                                        PointerEntered="OnResultCardIn" PointerExited="OnResultCardOut"
                                        PointerPressed="OnResultCardPressed" PointerReleased="OnResultCardReleased" PointerCanceled="OnResultCardReleased">
                                    <Grid RowSpacing="{StaticResource SpaceMini}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="282" />
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                CornerRadius="{StaticResource RadiusCard}"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource GlassEdgeBrush}"
                                                Background="{ThemeResource PosterPlaceholderBrush}">
                                            <Grid>
                                                <controls:LineIcon PathData="{StaticResource IconFilm}" IconSize="30"
                                                                   Foreground="{ThemeResource TertiaryTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image x:Name="ResultArt" Source="{Binding Poster}" Stretch="UniformToFill" controls:PosterImage.AutoFit="True" />
                                                <Rectangle VerticalAlignment="Bottom" Height="52" IsHitTestVisible="False">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#000B0B0D" Offset="0" />
                                                            <GradientStop Color="#720B0B0D" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Border Visibility="{Binding Item.Remarks, Converter={StaticResource StringToVisibility}}"
                                                        Background="{ThemeResource GlassDarkBadgeBrush}"
                                                        BorderBrush="#2EFFFFFF" BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="7,3"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="9">
                                                    <TextBlock Text="{Binding Item.Remarks}"
                                                               Style="{StaticResource MetaText}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource GlassDarkBadgeInkBrush}"
                                                               MaxWidth="108" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <Border Visibility="{Binding Rating, Converter={StaticResource StringToVisibility}}"
                                                        Background="{ThemeResource GlassDarkBadgeBrush}"
                                                        BorderBrush="#2EFFFFFF" BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="7,3"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="9">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="4.5" Height="4.5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Rating}"
                                                                   Style="{StaticResource MonoMetaText}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource GlassDarkBadgeInkBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Grid x:Name="PlayOverlay" Background="#660B0B0D" Opacity="0">
                                                    <Border x:Name="PlayBadge" Width="52" Height="52" CornerRadius="26"
                                                            Background="#E8F4F3EE" BorderBrush="#66FFFFFF" BorderThickness="1"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <controls:LineIcon PathData="{StaticResource IconPlaySolid}" IconSize="20" IsFilled="True"
                                                                           Margin="2,0,0,0" Foreground="#0D0D10" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1" Text="{Binding Item.Name}"
                                                   Style="{StaticResource CardTitleText}" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                                    Spacing="{StaticResource SpaceMini}">
                                            <TextBlock Text="{Binding Item.Year}" Style="{StaticResource MonoMetaText}" />
                                            <TextBlock Text="·" Style="{StaticResource MetaText}"
                                                       Visibility="{Binding Item.Year, Converter={StaticResource StringToVisibility}}" />
                                            <TextBlock Text="{Binding SearchSourceLabel}" Style="{StaticResource MetaText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel x:Name="LoadingState"
                                Visibility="Collapsed"
                                Spacing="{StaticResource SpaceSmall}"
                                MaxWidth="{StaticResource TextParagraphMaxWidth}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressRing Width="40" Height="40" IsActive="True"
                                      Foreground="{ThemeResource VermilionBrush}"
                                      HorizontalAlignment="Center" />
                        <TextBlock Text="正在搜索…" Style="{StaticResource SectionTitleText}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="正在并发查询各站点，结果会逐个出现。"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="EmptyState"
                                Visibility="Collapsed"
                                Spacing="{StaticResource SpaceSmall}"
                                MaxWidth="{StaticResource TextParagraphMaxWidth}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="{ThemeResource GlassPanelBrush}"
                                BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                                HorizontalAlignment="Center">
                            <controls:LineIcon x:Name="EmptyIcon" PathData="{StaticResource IconSearch}" IconSize="28"
                                               Foreground="{ThemeResource SecondaryTextBrush}" />
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="没有找到匹配的影片"
                                   Style="{StaticResource SectionTitleText}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock x:Name="EmptyDescription"
                                   Text="换个关键词试试，或清空筛选条件后重新搜索。"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <Button Content="重新搜索"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SubmitCommand}"
                                AutomationProperties.Name="重新搜索"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 五层光学磨砂非抢焦搜索预选浮层：以顶部为锚点弹性展开，随时可打断 -->
        <controls:GlassSurface x:Name="SuggestionsOverlay"
                               Grid.Row="2"
                               Canvas.ZIndex="40"
                               Visibility="Collapsed"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="10,-16,0,0"
                               Background="{ThemeResource GlassOverlayBrush}"
                               CornerRadius="{StaticResource RadiusPanel}"
                               Padding="6"
                               AllowFocusOnInteraction="False"
                               PointerEntered="OnSuggestionsPointerEntered"
                               PointerExited="OnSuggestionsPointerExited">
            <controls:GlassSurface.Shadow>
                <ThemeShadow />
            </controls:GlassSurface.Shadow>
            <ListView x:Name="SuggestionList"
                      MaxHeight="280"
                      SelectionMode="Single"
                      IsTabStop="False"
                      AllowFocusOnInteraction="False"
                      Background="Transparent"
                      BorderThickness="0"
                      AutomationProperties.Name="搜索建议">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource SearchRowContainer}">
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="AllowFocusOnInteraction" Value="False" />
                        <Setter Property="MinHeight" Value="38" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Button Click="OnSuggestionClick"
                                IsTabStop="False"
                                AllowFocusOnInteraction="False"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,6"
                                Background="Transparent"
                                BorderThickness="0"
                                AutomationProperties.Name="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <controls:LineIcon PathData="{StaticResource IconSearch}" IconSize="13"
                                                   Foreground="{ThemeResource TertiaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}" Style="{StaticResource BodyText}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </controls:GlassSurface>
    </Grid>
</Page>

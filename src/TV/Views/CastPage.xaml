<Page
    x:Class="TV.Views.CastPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    SizeChanged="OnPageSizeChanged">
    <Grid Padding="{StaticResource PagePaddingWide}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 / 说明 + 接收状态 -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SpaceTiny}" VerticalAlignment="Center">
                <TextBlock Text="投屏" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="电脑作为投屏接收端：手机通过 DLNA / UPnP 发送视频，本机直接播放"
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Background="{ThemeResource SurfaceAltBrush}"
                    BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusTag}" Padding="10,3" VerticalAlignment="Center"
                    Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{ThemeResource AccentBrush}" Opacity="0.35" />
                    <TextBlock x:Name="StatusText" Text="未开启" Style="{StaticResource MetaText}"
                               FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"
                               VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 主体：左接收状态 / 设备与会话 + 右投屏舞台 -->
        <Grid x:Name="BodyGrid" Grid.Row="1" Margin="0,16,0,0"
              RowSpacing="{StaticResource SpaceMedium}" ColumnSpacing="{StaticResource SpaceXLarge}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="BodyTopRow" Height="*" />
                <RowDefinition x:Name="BodyBottomRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BodyLeftColumn" Width="360" />
                <ColumnDefinition x:Name="BodyStageColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：接收状态卡 + 设备会话 + 收到请求 + 操作按钮 -->
            <ScrollViewer x:Name="CastScroll" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                          AutomationProperties.Name="投屏侧栏"
                          VerticalAlignment="Stretch" HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource SpaceMedium}" Margin="0,0,0,4">
                    <StackPanel x:Name="ReceiverActions" Visibility="Collapsed" Spacing="{StaticResource SpaceMini}">
                        <Grid x:Name="ReceiverActionGrid">
                            <StackPanel x:Name="ReceiverButtons" Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                                <Button x:Name="SenderButton" Content="手机扫码" Click="OnSenderClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="手机扫码" />
                                <Button Content="停止接收" Click="OnStopClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="停止接收" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="手机与电脑连接同一 Wi-Fi 后扫码发送视频"
                                   Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="{StaticResource SpaceSmall}">
                            <TextBlock Text="接收端" Style="{StaticResource SectionTitleText}" />
                            <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="状态" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="SessionStateText" Grid.Column="1" Text="未开启"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="协议" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="DLNA / UPnP" Style="{StaticResource BodyText}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock Text="开启后，手机视频应用会把本机识别为可投送的电视设备。"
                                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="{StaticResource SpaceMini}">
                            <TextBlock Text="设备与会话" Style="{StaticResource SectionTitleText}" />
                            <Grid ColumnSpacing="{StaticResource SpaceSmall}" MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEC15;" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                    <TextBlock Text="接收设备" Style="{StaticResource MetaText}" />
                                    <TextBlock x:Name="ReceiverName" Text="等待开启" Style="{StaticResource BodyText}"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.Name="设备名称" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource SpaceSmall}" MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                    <TextBlock Text="投屏会话" Style="{StaticResource MetaText}" />
                                    <TextBlock x:Name="SessionTitleText" Text="等待手机发送" Style="{StaticResource BodyText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource SpaceSmall}" MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE916;" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                    <TextBlock Text="播放进度" Style="{StaticResource MetaText}" />
                                    <TextBlock x:Name="SessionPositionText" Text="00:00" Style="{StaticResource BodyText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <Border x:Name="Incoming" Style="{StaticResource PanelCardStyle}" Visibility="Collapsed">
                        <Grid ColumnSpacing="{StaticResource SpaceSmall}" RowSpacing="{StaticResource SpaceSmall}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="0" VerticalAlignment="Center">
                                <TextBlock Text="收到投屏请求" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock x:Name="IncomingTitle" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource MetaText}" />
                            </StackPanel>
                            <StackPanel x:Name="IncomingButtons" Grid.Column="1" Orientation="Horizontal"
                                        Spacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                                <Button Content="拒绝" Click="OnRejectClick"
                                        Height="{StaticResource PrimaryButtonHeight}" MinHeight="{StaticResource PrimaryButtonHeight}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="拒绝" />
                                <Button Content="接收" Click="OnAcceptClick"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.Name="接收" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右栏：投屏内容舞台（宽屏铺满；开始接收按钮在舞台中心） -->
            <ScrollViewer x:Name="StageFrame" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                          AutomationProperties.Name="投屏内容"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="0">
                    <Grid x:Name="Stage">
                        <StackPanel x:Name="StageIdle" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="{StaticResource SpaceMedium}" Padding="32">
                            <Border Width="96" Height="96" CornerRadius="24"
                                    Background="{ThemeResource AccentSoftBrush}"
                                    BorderBrush="{ThemeResource AccentBorderBrush}" BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEC15;" FontSize="40" Foreground="{ThemeResource AccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="StageTitle" Text="接收手机视频" Style="{StaticResource PageTitleText}"
                                       TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="StageHint" Text="手机与电脑连接同一 Wi-Fi"
                                       Style="{StaticResource SecondaryText}" TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <Button x:Name="StartButton" Content="开始接收" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnStartClick"
                                    AutomationProperties.Name="开始接收" />
                            <TextBlock Text="支持 DLNA / UPnP 设备投送，也支持手机浏览器发送视频"
                                       Style="{StaticResource MetaText}" TextAlignment="Center"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid x:Name="PreviewFrame" Visibility="Collapsed" Background="{ThemeResource AppBackgroundBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <MediaPlayerElement x:Name="Preview" AreTransportControlsEnabled="False"
                                                Stretch="Uniform" AutoPlay="False" />
                            <Grid Grid.Row="1" Padding="12,6" ColumnSpacing="{StaticResource SpaceSmall}"
                                  Background="{ThemeResource SurfaceBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PreviewToggle" Click="OnPreviewToggle"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTipService.ToolTip="播放或暂停"
                                        AutomationProperties.Name="播放或暂停">
                                    <FontIcon x:Name="PreviewPlayIcon" Glyph="&#xE768;" FontSize="16" />
                                </Button>
                                <Slider Grid.Column="1" x:Name="PreviewPosition" Minimum="0" Maximum="1"
                                        StepFrequency="1" IsEnabled="False" VerticalAlignment="Center"
                                        AutomationProperties.Name="播放进度"
                                        ValueChanged="OnPreviewPositionChanged" />
                                <TextBlock Grid.Column="2" x:Name="PreviewTime" Text="00:00"
                                           Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <InfoBar x:Name="Feedback" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning"
                 Margin="0,12,0,0" />
    </Grid>
</Page>

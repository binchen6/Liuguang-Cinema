<Page
    x:Class="TV.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    xmlns:local="using:TV.Converters"
    xmlns:controls="using:TV.Controls"
    Background="Black" RequestedTheme="Dark"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    SizeChanged="OnPageSizeChanged"
    PointerExited="OnPointerExited"
    PointerWheelChanged="OnPointerWheelChanged"
    Tapped="OnTapped"
    DoubleTapped="OnDoubleTapped"
    KeyDown="OnKeyDown">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />

        <x:Double x:Key="PlayerStateIconSize">34</x:Double>
        <x:Double x:Key="PlayerRingSize">44</x:Double>
        <x:Double x:Key="PlayerCenterButtonSize">76</x:Double>

        <!-- 播放器进度条 / 音量条清透玻璃轨道与珠光朱砂滑块令牌（消除默认深灰厚环） -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="#44FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#5CFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#6CFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFE8503E" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFF06B5B" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFCE3A2B" />
        <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#F6FFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFE8503E" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFF06B5B" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFCE3A2B" />

        <!-- 播放器透明胶囊下拉按钮态（覆盖默认不透明控件底色） -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#1CFFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#42FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#52FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#68FFFFFF" />

        <!-- 中央清透光学磨砂玻璃圆镜播放键（背景与五层光影由外层 GlassSurface 承载） -->
        <Style x:Key="PlayerCenterPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
            <Setter Property="Width" Value="{StaticResource PlayerCenterButtonSize}" />
            <Setter Property="Height" Value="{StaticResource PlayerCenterButtonSize}" />
            <Setter Property="MinWidth" Value="{StaticResource PlayerCenterButtonSize}" />
            <Setter Property="MinHeight" Value="{StaticResource PlayerCenterButtonSize}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFF8F7F2" />
            <Setter Property="CornerRadius" Value="38" />
        </Style>

        <!-- 底部主播放/暂停键：清透珠光晶白玻璃圆钮 -->
        <Style x:Key="PlayerPrimaryTransportStyle" TargetType="Button">
            <Setter Property="controls:GlassOpticsEngine.Mode" Value="Interactive" />
            <Setter Property="controls:GlassOpticsEngine.Profile" Value="Control" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Background" Value="#D6F8F7F2" />
            <Setter Property="BorderBrush" Value="#8AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0D0D10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#F8FFFFFF" />
                                            <Setter Target="RootBorder.BorderBrush" Value="#A8FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#C8DDDAD2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.42" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerControlGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <!-- 底层影片与弹幕画布（避免在高频刷新 SwapChainPanel 上叠加 DWM ThemeShadow） -->
        <Grid x:Name="VideoStageHost">
            <controls:DanmakuOverlay x:Name="DanmakuLayer" />
        </Grid>
        <ContentPresenter x:Name="MusicStage" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />

        <!-- 五层光学磨砂玻璃快捷操作 OSD 气囊（连续按键平滑微弹不闪烁） -->
        <Grid x:Name="OsdBadge" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0"
              IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
            <controls:GlassSurface x:Name="OsdGlassSurface" Style="{StaticResource PlayerPillGlassStyle}" CornerRadius="18" Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="5.5" Height="5.5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="OsdText" Style="{StaticResource SecondaryText}" FontWeight="SemiBold"
                               Foreground="#FFF8F7F2" />
                </StackPanel>
            </controls:GlassSurface>
        </Grid>

        <!-- AI 字幕生成 / 翻译五层光学玻璃进度浮条 -->
        <Grid x:Name="AiSubtitleBanner" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,116,0,0"
              Opacity="0" Visibility="Collapsed"
              PointerEntered="OnControlPointerEntered" PointerExited="OnControlPointerExited">
            <controls:GlassSurface x:Name="AiSubtitleGlassSurface" Style="{StaticResource PlayerPillGlassStyle}" CornerRadius="18" Padding="14,7">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing Width="16" Height="16" IsActive="{Binding IsAiSubtitleBusy}" Foreground="{ThemeResource VermilionBrush}" />
                    <TextBlock Text="{Binding AiSubtitleStatus}" Style="{StaticResource MetaText}"
                               Foreground="#FFF8F7F2" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    <Button Content="取消" Command="{Binding CancelAiSubtitleCommand}"
                            Style="{StaticResource GhostButtonStyle}" MinHeight="28" Height="28" Padding="10,0" />
                </StackPanel>
            </controls:GlassSurface>
        </Grid>

        <!-- 实时 AI 字幕五层光学玻璃浮层 -->
        <Grid x:Name="LiveSubtitleOverlay" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="48,0,48,120" MaxWidth="920" IsHitTestVisible="False"
              Opacity="0" Visibility="Collapsed">
            <controls:GlassSurface x:Name="LiveSubtitleGlassSurface" Style="{StaticResource PlayerPillGlassStyle}" CornerRadius="14" Padding="20,10">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LiveCaptionTranslated}" FontSize="22" FontWeight="SemiBold"
                               Foreground="#FFF8F7F2" TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding LiveCaptionTranslated, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock Text="{Binding LiveCaptionOriginal}" FontSize="18" FontWeight="Medium"
                               Foreground="#D4F8F7F2" TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding LiveCaptionOriginal, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </controls:GlassSurface>
        </Grid>

        <!-- 媒体信息五层光学玻璃 HUD (快捷键 I) -->
        <Grid x:Name="MediaInfoHud" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,72,0,0"
              IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
            <controls:GlassSurface x:Name="MediaInfoGlassSurface" Style="{StaticResource PlayerPillGlassStyle}" CornerRadius="14" Padding="14,10">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="TELEMETRY · 播放信息" Style="{StaticResource EyebrowText}" Foreground="#FFF8F7F2" />
                    </StackPanel>
                    <TextBlock Text="{Binding MediaInfoText}" Style="{StaticResource MonoMetaText}" Foreground="#FFF8F7F2" />
                    <TextBlock x:Name="MediaInfoExtra" Style="{StaticResource MonoMetaText}" Foreground="#CCF8F7F2" />
                </StackPanel>
            </controls:GlassSurface>
        </Grid>

        <!-- 中央状态层：统一五层光学磨砂玻璃卡片（加载 / 空 / 错误） -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Margin="24">
            <StackPanel Spacing="{StaticResource SpaceMedium}" HorizontalAlignment="Center" MaxWidth="560">
                <!-- 加载 / 缓冲 -->
                <controls:GlassSurface Style="{StaticResource PlayerPillGlassStyle}" CornerRadius="18" Padding="32,24"
                                       Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVisibility}}"
                                       PointerEntered="OnControlPointerEntered" PointerExited="OnControlPointerExited">
                    <StackPanel Spacing="{StaticResource SpaceSmall}" HorizontalAlignment="Center">
                        <ProgressRing Width="{StaticResource PlayerRingSize}" Height="{StaticResource PlayerRingSize}"
                                      IsActive="True" Foreground="{ThemeResource VermilionBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="正在加载" Style="{StaticResource SectionTitleText}"
                                   Foreground="#FFF8F7F2" TextAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BufferingText}" Style="{StaticResource SecondaryText}"
                                   Foreground="#C8F8F7F2" TextAlignment="Center" HorizontalAlignment="Center" />
                        <Button Content="返回" Style="{StaticResource PrimaryButtonStyle}" Click="OnBackClick"
                                HorizontalAlignment="Center" Margin="0,4,0,0" AutomationProperties.Name="返回" />
                    </StackPanel>
                </controls:GlassSurface>

                <!-- 空态 -->
                <controls:GlassSurface Style="{StaticResource PlayerPillGlassStyle}" CornerRadius="18" Padding="32,26"
                                       Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                       PointerEntered="OnControlPointerEntered" PointerExited="OnControlPointerExited">
                    <StackPanel Spacing="{StaticResource SpaceSmall}" HorizontalAlignment="Center">
                        <controls:LineIcon PathData="{StaticResource IconVod}" IconSize="38"
                                           Foreground="#C8F8F7F2" HorizontalAlignment="Center" />
                        <TextBlock Text="尚未播放" Style="{StaticResource SectionTitleText}"
                                   Foreground="#FFF8F7F2" TextAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Text="从点播或直播中选择影片，即可在此沉浸观看。" Style="{StaticResource SecondaryText}"
                                   Foreground="#C0F8F7F2" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Center" />
                        <Button Content="返回" Style="{StaticResource PrimaryButtonStyle}" Click="OnBackClick"
                                HorizontalAlignment="Center" Margin="0,4,0,0" AutomationProperties.Name="返回" />
                    </StackPanel>
                </controls:GlassSurface>

                <!-- 错误 / 提示态 -->
                <controls:GlassSurface Style="{StaticResource PlayerPillGlassStyle}" CornerRadius="18" Padding="32,24"
                                       Visibility="{Binding ShowStatusPanel, Converter={StaticResource BoolToVisibility}}"
                                       PointerEntered="OnControlPointerEntered" PointerExited="OnControlPointerExited">
                    <StackPanel Spacing="{StaticResource SpaceSmall}" HorizontalAlignment="Center">
                        <controls:LineIcon PathData="{StaticResource IconAlert}" IconSize="36"
                                           Foreground="#DCF8F7F2" HorizontalAlignment="Center" />
                        <TextBlock Text="播放提示" Style="{StaticResource SectionTitleText}"
                                   Foreground="#FFF8F7F2" TextAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}"
                                   Foreground="#C8F8F7F2" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="扫码登录" Style="{StaticResource PrimaryButtonStyle}" Click="OnCloudLoginClick"
                                    Visibility="{Binding HasRequiredLogin, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="网盘登录" />
                            <Button Content="返回" Style="{StaticResource SecondaryButtonStyle}" Click="OnBackClick"
                                    Height="{StaticResource PrimaryButtonHeight}" MinHeight="{StaticResource PrimaryButtonHeight}"
                                    AutomationProperties.Name="返回" />
                        </StackPanel>
                    </StackPanel>
                </controls:GlassSurface>
            </StackPanel>
        </Grid>

        <!-- 中央暂停态五层光学磨砂圆镜播放键 -->
        <Grid x:Name="CenterPlayHost" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
              PointerEntered="OnControlPointerEntered" PointerExited="OnControlPointerExited">
            <controls:GlassSurface x:Name="CenterPlayGlassSurface" Style="{StaticResource PlayerPillGlassStyle}"
                                   Width="{StaticResource PlayerCenterButtonSize}" Height="{StaticResource PlayerCenterButtonSize}"
                                   CornerRadius="38">
                <Button x:Name="CenterPlayButton"
                        Style="{StaticResource PlayerCenterPlayButtonStyle}"
                        Click="OnCenterPlayClick"
                        ToolTipService.ToolTip="播放 / 暂停 (空格)" AutomationProperties.Name="播放">
                    <controls:LineIcon PathData="{StaticResource IconPlaySolid}" IconSize="31" IsFilled="True"
                                       Margin="4,0,0,0" Foreground="#FFF8F7F2" />
                </Button>
            </controls:GlassSurface>
        </Grid>

        <!-- 控制层：顶部左右分体悬浮五层光学玻璃浮岛 + 底部修身光学控制坞，无操作 3 秒且鼠标不在控件上时连同鼠标同步隐藏 -->
        <Grid x:Name="ControlsLayer">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部双分体轻透磨砂玻璃浮岛：左胶囊（返回 + 片名）+ 右圆镜（更多选项），敞开上方视野 -->
            <Grid x:Name="TopChromeBar" Grid.Row="0" Padding="18,14,18,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:GlassSurface x:Name="TopGlassSurface" Style="{StaticResource PlayerDockGlassStyle}"
                                       HorizontalAlignment="Left" MaxWidth="680" CornerRadius="23" Padding="5,4,18,4"
                                       PointerEntered="OnControlPointerEntered" PointerExited="OnControlPointerExited">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayerBackButton" Style="{StaticResource PlayerIconButtonStyle}"
                                Click="OnBackClick"
                                ToolTipService.ToolTip="返回 (Esc)" AutomationProperties.Name="返回">
                            <controls:LineIcon PathData="{StaticResource IconBack}" IconSize="17" Foreground="#FFF8F7F2" />
                        </Button>
                        <Border Grid.Column="1" Width="1" Height="16" Background="#32FFFFFF" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#FFF8F7F2" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                       Foreground="#D0F8F7F2" MaxLines="1" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </controls:GlassSurface>

                <controls:GlassSurface x:Name="TopActionsGlassSurface" Grid.Column="1" Style="{StaticResource PlayerDockGlassStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="23" Padding="4"
                                       PointerEntered="OnControlPointerEntered" PointerExited="OnControlPointerExited">
                    <StackPanel x:Name="TopActions" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="PlaybackOptionsButton" Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="更多播放选项" AutomationProperties.Name="播放选项">
                            <controls:LineIcon PathData="{StaticResource IconMore}" IconSize="17" Foreground="#FFF8F7F2" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="PlaybackOptionsFlyout" Placement="BottomEdgeAlignedRight"
                                            MenuFlyoutPresenterStyle="{StaticResource PlayerGlassMenuFlyoutPresenterStyle}"
                                            Opening="OnPlaybackOptionsOpening" Closed="OnMenuFlyoutClosed">
                                    <MenuFlyoutSubItem x:Name="AudioTracks" Text="音轨" />
                                    <MenuFlyoutSubItem x:Name="SubtitleTracks" Text="字幕轨道" />
                                    <MenuFlyoutItem Text="字幕设置与时间轴…" Click="OnSubtitleSettingsClick" />
                                    <MenuFlyoutSubItem Text="AI 智能字幕">
                                        <MenuFlyoutItem Text="AI 自动生成字幕" Click="OnAiGenerateSubtitleClick" />
                                        <MenuFlyoutItem Text="AI 生成并翻译字幕" Click="OnAiGenerateAndTranslateClick" />
                                        <MenuFlyoutItem Text="AI 翻译当前/本地字幕" Click="OnAiTranslateSubtitleClick" />
                                        <ToggleMenuFlyoutItem x:Name="RealtimeSubtitleToggleItem" Text="实时字幕 (Qwen3-ASR)" Click="OnRealtimeSubtitleToggleClick" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Text="弹幕设置…" Click="OnDanmakuSettingsClick" AutomationProperties.Name="弹幕" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem x:Name="AspectRatioMenu" Text="画面比例" />
                                    <MenuFlyoutSubItem x:Name="SyncDelayMenu" Text="音画延迟微调" />
                                    <MenuFlyoutItem Text="片头片尾设置…" Click="OnTimingSettingsClick" />
                                    <MenuFlyoutSeparator />
                                    <ToggleMenuFlyoutItem x:Name="PreventSleepItem" Text="播放时防止息屏与休眠" Click="OnPreventSleepClick" />
                                    <ToggleMenuFlyoutItem x:Name="LoopEpisodeItem" Text="单集循环" Click="OnLoopEpisodeClick" />
                                    <MenuFlyoutItem Text="视频截图" Click="OnSnapshotClick" />
                                    <ToggleMenuFlyoutItem x:Name="MediaInfoToggleItem" Text="显示视频信息 (I)" Click="OnMediaInfoToggleClick" />
                                    <MenuFlyoutItem Text="画中画" Command="{Binding CompactOverlayCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </controls:GlassSurface>
            </Grid>

            <!-- 底部悬浮五层光学磨砂玻璃控制坞：柔和真磨砂 + 体积透视 + 顶部焦散高光丝 + 菲涅尔描边 -->
            <Grid x:Name="BottomChromeBar" Grid.Row="2" VerticalAlignment="Bottom" Margin="20,0,20,16">
                <controls:GlassSurface x:Name="BottomGlassSurface" Style="{StaticResource PlayerDockGlassStyle}"
                                       MaxWidth="1120" HorizontalAlignment="Stretch" CornerRadius="20" Padding="16,8,16,9"
                                       PointerEntered="OnControlPointerEntered" PointerExited="OnControlPointerExited">
                    <StackPanel Spacing="4">
                            <TextBlock Text="{Binding QualityMessage}" Style="{StaticResource MetaText}"
                                       Foreground="{ThemeResource VermilionBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding QualityMessage, Converter={StaticResource StringToVisibility}}" />

                            <!-- 底部第一行：播放进度 + 等宽时间码 + 悬浮拖动/悬停时间预览 -->
                            <Grid x:Name="ProgressRow" Height="28"
                                  ColumnSpacing="10"
                                  Visibility="{Binding DurationText, Converter={StaticResource StringToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PositionText}" Style="{StaticResource MonoMetaText}" FontWeight="SemiBold"
                                           Foreground="#FFF8F7F2" VerticalAlignment="Center" MinWidth="48" />
                                <Grid x:Name="SeekTrackHost" Grid.Column="1" VerticalAlignment="Center">
                                    <Border x:Name="SeekPreviewPill"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="0,-32,0,0" Padding="8,3" CornerRadius="8"
                                            Background="#E6141418" BorderBrush="#40FFFFFF" BorderThickness="1"
                                            Opacity="0" IsHitTestVisible="False" Canvas.ZIndex="20">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="SeekPreviewTransform" X="0" />
                                        </Border.RenderTransform>
                                        <TextBlock x:Name="SeekPreviewText" Style="{StaticResource MonoMetaText}"
                                                   FontWeight="SemiBold" Foreground="#FFF8F7F2" Text="00:00" />
                                    </Border>
                                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding DurationMs}" Value="{Binding PositionMs, Mode=TwoWay}"
                                            VerticalAlignment="Center" MinHeight="28"
                                            ValueChanged="OnSeekValueChanged"
                                            PointerMoved="OnSeekTrackPointerMoved"
                                            PointerExited="OnSeekTrackPointerExited"
                                            StepFrequency="100" SmallChange="5000" LargeChange="30000"
                                            AutomationProperties.Name="播放进度" />
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource MonoMetaText}"
                                           Foreground="#CCF8F7F2" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
                            </Grid>

                            <!-- 底部第二行：播放/选集/倍速/音量 ； 画质/跳过/字幕/弹幕/投屏/全屏 -->
                            <Grid x:Name="BottomChrome" ColumnSpacing="{StaticResource SpaceSmall}"
                                  RowSpacing="{StaticResource SpaceMini}" SizeChanged="OnBottomChromeSizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="BottomChromeExtraRow" Height="0" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="TransportControls" Style="{StaticResource PlayerControlGroupStyle}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayerPrimaryTransportStyle}"
                                                Click="OnPlayPauseClick"
                                                ToolTipService.ToolTip="播放 / 暂停 (空格)" AutomationProperties.Name="播放暂停">
                                            <Grid Width="38" Height="38">
                                                <controls:LineIcon PathData="{StaticResource IconPauseSolid}" IconSize="20" IsFilled="True"
                                                                   Foreground="#0D0D10"
                                                                   Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                                <controls:LineIcon PathData="{StaticResource IconPlaySolid}" IconSize="20" IsFilled="True"
                                                                   Foreground="#0D0D10"
                                                                   Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="PreviousEpisodeButton" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding PreviousEpisodeCommand}"
                                                IsEnabled="{Binding CanPrevious}"
                                                Visibility="{Binding HasPlaylist, Converter={StaticResource BoolToVisibility}}"
                                                ToolTipService.ToolTip="上一集" AutomationProperties.Name="上一集">
                                            <controls:LineIcon PathData="{StaticResource IconPrevious}" IconSize="17" Foreground="#FFF8F7F2" />
                                        </Button>
                                        <Button x:Name="NextEpisodeButton" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding NextEpisodeCommand}"
                                                IsEnabled="{Binding CanNext}"
                                                Visibility="{Binding HasPlaylist, Converter={StaticResource BoolToVisibility}}"
                                                ToolTipService.ToolTip="下一集" AutomationProperties.Name="下一集">
                                            <controls:LineIcon PathData="{StaticResource IconNext}" IconSize="17" Foreground="#FFF8F7F2" />
                                        </Button>
                                        <Button x:Name="PlaylistButton" Style="{StaticResource PlayerIconButtonStyle}"
                                                Visibility="{Binding HasPlaylist, Converter={StaticResource BoolToVisibility}}"
                                                ToolTipService.ToolTip="选集 (P)" AutomationProperties.Name="选集">
                                            <controls:LineIcon PathData="{StaticResource IconPlaylist}" IconSize="18" Foreground="#FFF8F7F2" />
                                            <Button.Flyout>
                                                <Flyout x:Name="PlaylistFlyout" Placement="TopEdgeAlignedLeft"
                                                        FlyoutPresenterStyle="{StaticResource PlayerGlassStaticFlyoutPresenterStyle}"
                                                        Opening="OnPlaylistOpening" Closed="OnPlaylistClosed">
                                                    <StackPanel Width="256" Spacing="{StaticResource SpaceSmall}">
                                                        <controls:AnchoredChoice Header="线路" ItemsSource="{Binding Lines}" DisplayMemberPath="Name"
                                                                                 SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                                                                 HorizontalAlignment="Stretch" PlaceholderText="选择线路"/>
                                                        <ListView x:Name="PlaylistEpisodes" ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode, Mode=TwoWay}"
                                                                  SelectionMode="Single" Padding="0,0,8,0"
                                                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                                                  AutomationProperties.Name="集数列表">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" Padding="6,8" TextTrimming="CharacterEllipsis"/>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <DropDownButton x:Name="RateButton" Style="{StaticResource PlayerDropDownButtonStyle}" Content="{Binding RateText}"
                                                        Margin="4,0,0,0" ToolTipService.ToolTip="倍速">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout x:Name="RateFlyout" Placement="TopEdgeAlignedLeft"
                                                            MenuFlyoutPresenterStyle="{StaticResource PlayerGlassMenuFlyoutPresenterStyle}"
                                                            Opening="OnMenuFlyoutOpening" Closed="OnMenuFlyoutClosed" />
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <Button x:Name="VolumeButton" Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTipService.ToolTip="音量 (↑↓ 调节)" AutomationProperties.Name="音量">
                                            <Grid Width="38" Height="38">
                                                <controls:LineIcon PathData="{StaticResource IconVolume}" IconSize="17" Foreground="#FFF8F7F2"
                                                                   Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                                <controls:LineIcon PathData="{StaticResource IconVolumeMute}" IconSize="17" Foreground="#CCF8F7F2"
                                                                   Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                            <Button.Flyout>
                                                <Flyout x:Name="VolumeFlyout" Placement="Top"
                                                        FlyoutPresenterStyle="{StaticResource PlayerGlassStaticFlyoutPresenterStyle}"
                                                        Opening="OnMenuFlyoutOpening" Closed="OnMenuFlyoutClosed">
                                                    <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Style="{StaticResource PlayerIconButtonStyle}" Click="OnMuteClick"
                                                                ToolTipService.ToolTip="静音 (M)" AutomationProperties.Name="静音">
                                                            <Grid Width="38" Height="38">
                                                                <controls:LineIcon PathData="{StaticResource IconVolume}" IconSize="17" Foreground="#FFF8F7F2"
                                                                                   Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                                                <controls:LineIcon PathData="{StaticResource IconVolumeMute}" IconSize="17" Foreground="#CCF8F7F2"
                                                                                   Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                                                            </Grid>
                                                        </Button>
                                                        <Slider Grid.Column="1" Width="140" Minimum="0" Maximum="100"
                                                                Value="{Binding Volume, Mode=TwoWay}"
                                                                VerticalAlignment="Center" AutomationProperties.Name="音量滑块" />
                                                    </Grid>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="MediaControls" Grid.Column="1" Style="{StaticResource PlayerControlGroupStyle}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <DropDownButton x:Name="QualityButton" Style="{StaticResource PlayerDropDownButtonStyle}" Content="{Binding QualityButtonText}"
                                                        ToolTipService.ToolTip="{Binding SelectedQuality.Name}" AutomationProperties.Name="清晰度">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout x:Name="QualityFlyout" Placement="TopEdgeAlignedRight"
                                                            MenuFlyoutPresenterStyle="{StaticResource PlayerGlassMenuFlyoutPresenterStyle}"
                                                            Opening="OnQualityMenuOpening" Closed="OnMenuFlyoutClosed" />
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <DropDownButton x:Name="SkipButton" Style="{StaticResource PlayerDropDownButtonStyle}" Content="跳过"
                                                        Margin="0,0,2,0" ToolTipService.ToolTip="片头片尾" AutomationProperties.Name="片头片尾">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout Placement="TopEdgeAlignedRight"
                                                            MenuFlyoutPresenterStyle="{StaticResource PlayerGlassMenuFlyoutPresenterStyle}"
                                                            Opening="OnMenuFlyoutOpening" Closed="OnMenuFlyoutClosed">
                                                    <MenuFlyoutItem Text="跳过片头" Command="{Binding SkipIntroCommand}" />
                                                    <MenuFlyoutItem Text="跳过片尾" Command="{Binding SkipOutroCommand}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="设置片头片尾" Click="OnTimingSettingsClick" />
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <Button x:Name="SubtitleSettingsButton" Style="{StaticResource PlayerIconButtonStyle}"
                                                Click="OnSubtitleSettingsClick"
                                                ToolTipService.ToolTip="字幕设置 / AI 字幕"
                                                AutomationProperties.Name="字幕设置">
                                            <Grid Width="38" Height="38">
                                                <controls:LineIcon PathData="{StaticResource IconSubtitle}" IconSize="17" Foreground="#FFF8F7F2" />
                                                <Border x:Name="SubtitleActiveIndicator" Width="12" Height="2"
                                                        CornerRadius="1"
                                                        Background="{ThemeResource VermilionBrush}"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Margin="0,0,0,4" Visibility="Collapsed" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="DanmakuToggleButton" Style="{StaticResource PlayerIconButtonStyle}"
                                                Click="OnDanmakuToggleClick" RightTapped="OnDanmakuRightTapped"
                                                ToolTipService.ToolTip="显示弹幕 (D · 右键设置)"
                                                AutomationProperties.Name="弹幕开关">
                                            <Grid Width="38" Height="38">
                                                <controls:LineIcon PathData="{StaticResource IconDanmaku}" IconSize="17" Foreground="#FFF8F7F2" />
                                                <Border x:Name="DanmakuOnIndicator" Width="12" Height="2"
                                                        CornerRadius="1"
                                                        Background="{ThemeResource VermilionBrush}"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Margin="0,0,0,4" Visibility="Collapsed" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="CastButton" Style="{StaticResource PlayerIconButtonStyle}" Click="OnCastClick"
                                                ToolTipService.ToolTip="投屏" AutomationProperties.Name="投屏">
                                            <controls:LineIcon PathData="{StaticResource IconCast}" IconSize="17" Foreground="#FFF8F7F2" />
                                        </Button>
                                        <Button x:Name="FullScreenButton" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding FullScreenCommand}"
                                                ToolTipService.ToolTip="全屏 (F)" AutomationProperties.Name="全屏">
                                            <controls:LineIcon PathData="{StaticResource IconFullscreen}" IconSize="17" Foreground="#FFF8F7F2" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                </controls:GlassSurface>
            </Grid>
        </Grid>
    </Grid>
</Page>

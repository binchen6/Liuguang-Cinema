<Page
    x:Class="TV.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    xmlns:local="using:TV.Converters"
    xmlns:controls="using:TV.Controls"
    Background="Black" RequestedTheme="Dark"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    PointerMoved="OnPointerMoved"
    PointerExited="OnPointerExited"
    Tapped="OnTapped"
    DoubleTapped="OnDoubleTapped"
    KeyDown="OnKeyDown">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />

        <!-- 播放器局部令牌：Tokens 未定义、播放器专用 -->
        <x:Double x:Key="PlayerStateIconSize">40</x:Double>
        <x:Double x:Key="PlayerRingSize">56</x:Double>
        <x:Double x:Key="PlayerCenterButtonSize">84</x:Double>
        <x:Double x:Key="PlayerTextButtonWidth">72</x:Double>
        <LinearGradientBrush x:Key="PlayerTopScrim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B3000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PlayerBottomScrim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#D9000000" Offset="1" />
        </LinearGradientBrush>

        <!-- 中央播放/暂停大按钮：暖金主操作 -->
        <Style x:Key="PlayerCenterPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
            <Setter Property="Width" Value="{StaticResource PlayerCenterButtonSize}" />
            <Setter Property="Height" Value="{StaticResource PlayerCenterButtonSize}" />
            <Setter Property="Background" Value="{ThemeResource AccentFillBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AccentInkBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        </Style>
        <Style x:Key="PlayerPrimaryTransportStyle" TargetType="Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource AccentFillBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AccentInkBrush}" />
        </Style>
        <Style x:Key="PlayerControlGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- 文字型播放器按钮（倍速 / 画质 / 字幕）：与图标按钮统一 44 高、8 圆角 -->
        <Style x:Key="PlayerTextButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
            <Setter Property="Width" Value="{StaticResource PlayerTextButtonWidth}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <vlc:VideoView x:Name="VideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Initialized="OnVideoViewInitialized" />
        <Canvas x:Name="DanmakuLayer" IsHitTestVisible="False" />

        <!-- 中央状态层：加载 / 空 / 错误，统一图标 + 标题 + 说明 + 主操作 -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Margin="24">
            <StackPanel Spacing="{StaticResource SpaceMedium}" HorizontalAlignment="Center" MaxWidth="560">
                <!-- 加载 / 缓冲 -->
                <StackPanel Spacing="{StaticResource SpaceSmall}" HorizontalAlignment="Center"
                            Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing Width="{StaticResource PlayerRingSize}" Height="{StaticResource PlayerRingSize}"
                                  IsActive="True" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="正在加载" Style="{StaticResource SectionTitleText}"
                               TextAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding BufferingText}" Style="{StaticResource SecondaryText}"
                               TextAlignment="Center" HorizontalAlignment="Center" />
                    <Button Content="返回" Style="{StaticResource PrimaryButtonStyle}" Click="OnBackClick"
                            HorizontalAlignment="Center" Margin="0,4,0,0" AutomationProperties.Name="返回" />
                </StackPanel>

                <!-- 空态 -->
                <StackPanel Spacing="{StaticResource SpaceSmall}" HorizontalAlignment="Center"
                            Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                    <FontIcon Glyph="&#xE7F4;" FontSize="{StaticResource PlayerStateIconSize}"
                              Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="尚未播放" Style="{StaticResource SectionTitleText}"
                               TextAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Text="从点播或直播中选择影片，即可在此沉浸观看。" Style="{StaticResource SecondaryText}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Center" />
                    <Button Content="返回" Style="{StaticResource PrimaryButtonStyle}" Click="OnBackClick"
                            HorizontalAlignment="Center" Margin="0,4,0,0" AutomationProperties.Name="返回" />
                </StackPanel>

                <!-- 错误 / 提示态 -->
                <StackPanel Spacing="{StaticResource SpaceSmall}" HorizontalAlignment="Center"
                            Visibility="{Binding ShowStatusPanel, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="{StaticResource PlayerStateIconSize}"
                              Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="播放提示" Style="{StaticResource SectionTitleText}"
                               TextAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}" HorizontalAlignment="Center">
                        <Button Content="扫码登录" Style="{StaticResource PrimaryButtonStyle}" Click="OnCloudLoginClick"
                                Visibility="{Binding HasRequiredLogin, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="网盘登录" />
                        <Button Content="返回" Style="{StaticResource SecondaryButtonStyle}" Click="OnBackClick"
                                Height="{StaticResource PrimaryButtonHeight}" MinHeight="{StaticResource PrimaryButtonHeight}"
                                AutomationProperties.Name="返回" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Button x:Name="CenterPlayButton"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource PlayerCenterPlayButtonStyle}"
                Command="{Binding TogglePauseCommand}" Visibility="Collapsed"
                ToolTipService.ToolTip="播放 / 暂停 (空格)" AutomationProperties.Name="播放">
            <FontIcon Glyph="&#xE768;" FontSize="{StaticResource FontSizeHero}" />
        </Button>

        <!-- 控制层：顶部标题、底部进度和操作统一随空闲计时显隐。 -->
        <Grid x:Name="ControlsLayer">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题、底部进度和操作属于同一个显隐层级。 -->
            <Border Grid.Row="0" Background="{StaticResource PlayerTopScrim}" Padding="24,12,24,28">
                <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource PlayerIconButtonStyle}" Click="OnBackClick"
                            ToolTipService.ToolTip="返回 (Esc)" AutomationProperties.Name="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource FontSizeSection}" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleText}"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MetaText}"
                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                    <StackPanel x:Name="TopActions" Grid.Column="2" Orientation="Horizontal"
                                Spacing="{StaticResource SpaceSmall}" VerticalAlignment="Center">
                        <Button x:Name="PlaybackOptionsButton" Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="更多播放选项" AutomationProperties.Name="播放选项">
                            <FontIcon Glyph="&#xE712;" FontSize="{StaticResource FontSizeSection}" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="PlaybackOptionsFlyout" Placement="BottomEdgeAlignedRight"
                                            Opening="OnPlaybackOptionsOpening" Closed="OnMenuFlyoutClosed">
                                    <MenuFlyoutSubItem x:Name="AudioTracks" Text="音轨" />
                                    <MenuFlyoutSubItem x:Name="SubtitleTracks" Text="字幕" />
                                    <MenuFlyoutItem Text="加载本地字幕" Click="OnLoadSubtitleClick" />
                                    <MenuFlyoutItem Text="匹配在线字幕" Click="OnMatchSubtitleClick" />
                                    <MenuFlyoutItem Text="片头片尾设置" Click="OnTimingSettingsClick" />
                                    <MenuFlyoutItem Text="弹幕设置" Click="OnDanmakuSettingsClick" AutomationProperties.Name="弹幕" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="画中画" Command="{Binding CompactOverlayCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部使用轻量渐变，不为每个分组增加厚重的容器。 -->
            <Border Grid.Row="2" VerticalAlignment="Bottom" Background="{StaticResource PlayerBottomScrim}" Padding="24,28,24,16">
                <StackPanel Spacing="{StaticResource SpaceMini}">
                    <TextBlock Text="{Binding QualityMessage}" Style="{StaticResource MetaText}"
                               Foreground="{ThemeResource AccentBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding QualityMessage, Converter={StaticResource StringToVisibility}}" />

                    <!-- 底部第一行：播放进度 -->
                    <Grid x:Name="ProgressRow" Height="{StaticResource IconButtonSize}"
                          ColumnSpacing="{StaticResource SpaceSmall}"
                          Visibility="{Binding DurationText, Converter={StaticResource StringToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource SecondaryText}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" VerticalAlignment="Center" MinWidth="52" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationMs}" Value="{Binding PositionMs, Mode=TwoWay}"
                                VerticalAlignment="Center" MinHeight="{StaticResource IconButtonSize}"
                                PointerPressed="OnSeekPressed" PointerReleased="OnSeekReleased"
                                StepFrequency="1000" SmallChange="5000" LargeChange="30000"
                                AutomationProperties.Name="播放进度" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource SecondaryText}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="52" TextAlignment="Right" />
                    </Grid>

                    <!-- 底部第二行：播放/选集/倍速/音量；画质/片头片尾/弹幕/投屏/全屏。 -->
                    <Grid x:Name="BottomChrome" ColumnSpacing="{StaticResource SpaceSmall}"
                          RowSpacing="{StaticResource SpaceMini}" SizeChanged="OnBottomChromeSizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="BottomChromeExtraRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="TransportControls" Style="{StaticResource PlayerControlGroupStyle}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceTiny}">
                            <Button Style="{StaticResource PlayerPrimaryTransportStyle}" Command="{Binding TogglePauseCommand}"
                                    ToolTipService.ToolTip="播放 / 暂停 (空格)" AutomationProperties.Name="播放暂停">
                                <FontIcon Glyph="{Binding PlayPauseGlyph}" FontSize="{StaticResource FontSizeSection}" />
                            </Button>
                            <Button Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding PreviousEpisodeCommand}"
                                    IsEnabled="{Binding CanPrevious}"
                                    Visibility="{Binding HasPlaylist, Converter={StaticResource BoolToVisibility}}"
                                    ToolTipService.ToolTip="上一集" AutomationProperties.Name="上一集">
                                <FontIcon Glyph="&#xE892;" FontSize="{StaticResource FontSizeSection}" />
                            </Button>
                            <Button Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding NextEpisodeCommand}"
                                    IsEnabled="{Binding CanNext}"
                                    Visibility="{Binding HasPlaylist, Converter={StaticResource BoolToVisibility}}"
                                    ToolTipService.ToolTip="下一集" AutomationProperties.Name="下一集">
                                <FontIcon Glyph="&#xE893;" FontSize="{StaticResource FontSizeSection}" />
                            </Button>
                            <Button x:Name="PlaylistButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Visibility="{Binding HasPlaylist, Converter={StaticResource BoolToVisibility}}"
                                    ToolTipService.ToolTip="选集 (P)" AutomationProperties.Name="选集">
                                <FontIcon Glyph="&#xE8FD;" FontSize="{StaticResource FontSizeSection}" />
                                <Button.Flyout>
                                    <Flyout x:Name="PlaylistFlyout" Placement="TopEdgeAlignedLeft"
                                            Opening="OnPlaylistOpening" Closed="OnPlaylistClosed">
                                        <StackPanel Width="256" Spacing="{StaticResource SpaceSmall}">
                                            <controls:AnchoredChoice Header="线路" ItemsSource="{Binding Lines}" DisplayMemberPath="Name"
                                                                     SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                                                     HorizontalAlignment="Stretch" PlaceholderText="选择线路"/>
                                            <ListView x:Name="PlaylistEpisodes" ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode, Mode=TwoWay}"
                                                      SelectionMode="Single" AutomationProperties.Name="集数列表">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" Padding="6,8" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <DropDownButton Style="{StaticResource PlayerTextButtonStyle}" Content="{Binding RateText}"
                                            ToolTipService.ToolTip="倍速">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="RateFlyout" Placement="TopEdgeAlignedLeft"
                                                Opening="OnMenuFlyoutOpening" Closed="OnMenuFlyoutClosed" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Style="{StaticResource PlayerIconButtonStyle}"
                                    ToolTipService.ToolTip="音量 (↑↓ 调节)" AutomationProperties.Name="音量">
                                <FontIcon Glyph="{Binding VolumeGlyph}" FontSize="{StaticResource FontSizeSection}" />
                                <Button.Flyout>
                                    <Flyout x:Name="VolumeFlyout" Placement="Top"
                                            Opening="OnMenuFlyoutOpening" Closed="OnMenuFlyoutClosed">
                                        <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource PlayerIconButtonStyle}" Click="OnMuteClick"
                                                    ToolTipService.ToolTip="静音 (M)" AutomationProperties.Name="静音">
                                                <FontIcon Glyph="{Binding VolumeGlyph}" FontSize="{StaticResource FontSizeSection}" />
                                            </Button>
                                            <Slider Grid.Column="1" Width="140" Minimum="0" Maximum="100"
                                                    Value="{Binding Volume, Mode=TwoWay}"
                                                    VerticalAlignment="Center" AutomationProperties.Name="音量滑块" />
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                        </Border>

                        <Border x:Name="MediaControls" Grid.Column="1" Style="{StaticResource PlayerControlGroupStyle}"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceTiny}">
                            <DropDownButton Style="{StaticResource PlayerTextButtonStyle}" Content="{Binding QualityButtonText}"
                                            ToolTipService.ToolTip="{Binding SelectedQuality.Name}" AutomationProperties.Name="清晰度">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="QualityFlyout" Placement="TopEdgeAlignedRight"
                                                Opening="OnQualityMenuOpening" Closed="OnMenuFlyoutClosed" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton Style="{StaticResource PlayerTextButtonStyle}" Content="跳过"
                                            ToolTipService.ToolTip="片头片尾" AutomationProperties.Name="片头片尾">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="TopEdgeAlignedRight" Opening="OnMenuFlyoutOpening" Closed="OnMenuFlyoutClosed">
                                        <MenuFlyoutItem Text="跳过片头" Command="{Binding SkipIntroCommand}" />
                                        <MenuFlyoutItem Text="跳过片尾" Command="{Binding SkipOutroCommand}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="设置片头片尾" Click="OnTimingSettingsClick" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button x:Name="DanmakuToggleButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="OnDanmakuToggleClick" ToolTipService.ToolTip="显示弹幕"
                                    AutomationProperties.Name="弹幕开关">
                                <Grid>
                                    <FontIcon Glyph="&#xE8BD;" FontSize="{StaticResource FontSizeSection}" />
                                    <Border x:Name="DanmakuOnIndicator" Width="14" Height="2"
                                            CornerRadius="{StaticResource RadiusTag}"
                                            Background="{ThemeResource AccentFillBrush}"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                            Margin="0,0,0,5" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource PlayerIconButtonStyle}" Click="OnCastClick"
                                    ToolTipService.ToolTip="投屏" AutomationProperties.Name="投屏">
                                <FontIcon Glyph="&#xE8AE;" FontSize="{StaticResource FontSizeSection}" />
                            </Button>
                            <Button Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding FullScreenCommand}"
                                    ToolTipService.ToolTip="全屏 (F)" AutomationProperties.Name="全屏">
                                <FontIcon Glyph="&#xE740;" FontSize="{StaticResource FontSizeSection}" />
                            </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

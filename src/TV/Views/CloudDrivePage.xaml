<Page x:Class="TV.Views.CloudDrivePage" x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid Padding="{StaticResource PagePaddingWide}" RowSpacing="{StaticResource SpaceLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SpaceTiny}">
                <TextBlock Text="我的云盘" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="浏览、搜索并直接播放账号中的媒体文件，不会重复转存。" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                <Button Content="返回上级" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="返回上级目录" />
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding LoadFolderCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新云盘">
                    <FontIcon Glyph="&#xE72C;" FontSize="18" />
                </Button>
            </StackPanel>
        </Grid>
        <ListView Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                  SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0"
                  AutomationProperties.Name="网盘账号"
                  ContainerContentChanging="OnAccountContainerChanging"
                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource NavRailItemStyle}">
                    <Setter Property="Height" Value="64" />
                    <Setter Property="MinWidth" Value="148" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpaceTiny}">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource MetaText}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="2" ColumnSpacing="{StaticResource SpaceSmall}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Name}" Command="{Binding DataContext.OpenBreadcrumbCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="云盘目录" />
                                <TextBlock Text="/" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                <TextBox x:Name="SearchBox" Width="240" PlaceholderText="搜索当前网盘" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown" AutomationProperties.Name="搜索我的云盘" />
                <Button Content="搜索" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}"
                        Height="{StaticResource PrimaryButtonHeight}" MinHeight="{StaticResource PrimaryButtonHeight}" AutomationProperties.Name="搜索云盘文件" />
            </StackPanel>
        </Grid>
        <ProgressBar Grid.Row="3" Height="3" IsIndeterminate="{Binding IsLoading}" Foreground="{ThemeResource AccentFillBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        <Grid Grid.Row="4">
            <ListView ItemsSource="{Binding Entries}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEntryClick"
                      Background="Transparent" BorderThickness="0" AutomationProperties.Name="云盘文件"
                      ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource RailListStyle}">
                        <Setter Property="Height" Value="NaN" />
                        <Setter Property="MinHeight" Value="68" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="{StaticResource SpaceMedium}" MinHeight="60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusControl}" Background="{ThemeResource SurfaceAltBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="{Binding Glyph}" FontSize="20" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpaceTiny}">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Path}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding MetaText}" Style="{StaticResource MetaText}" VerticalAlignment="Center" MinWidth="70" />
                            <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="{StaticResource SpaceSmall}"
                        Visibility="{Binding EmptyText, Converter={StaticResource StringToVisibility}}">
                <FontIcon Glyph="&#xE753;" FontSize="40" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource SectionTitleText}" TextAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="扫码登录" Style="{StaticResource PrimaryButtonStyle}" Click="OnCloudLoginClick"
                        Visibility="{Binding HasRequiredLogin, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="网盘登录" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="5" MinHeight="40">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetaText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Content="加载更多" Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" />
        </Grid>
    </Grid>
</Page>

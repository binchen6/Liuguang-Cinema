<Page x:Class="TV.Views.CloudDrivePage" x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TV.Controls"
    Background="Transparent" Loaded="OnLoaded" Unloaded="OnUnloaded" SizeChanged="OnPageSizeChanged">
    <Grid x:Name="CloudRoot" Padding="{StaticResource PagePaddingWide}" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 画册个人云库报头 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{ThemeResource VermilionBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="04 · CLOUD VAULT" Style="{StaticResource EyebrowText}" />
                </StackPanel>
                <TextBlock Text="我的云盘" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="浏览、搜索并直接播放账号中的媒体文件，不重复转存" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                <Button Content="返回上级" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="返回上级目录" />
                <Button x:Name="CloudRefreshButton" Style="{StaticResource IconButtonStyle}" Command="{Binding LoadFolderCommand}"
                        ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新云盘">
                    <controls:LineIcon PathData="{StaticResource IconRefresh}" IconSize="17" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 磨砂网盘账号卡 -->
        <ListView Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                  SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0"
                  AutomationProperties.Name="网盘账号"
                  ContainerContentChanging="OnAccountContainerChanging"
                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource NavRailItemStyle}">
                    <Setter Property="Height" Value="72" />
                    <Setter Property="MinWidth" Value="180" />
                    <Setter Property="Padding" Value="14,0,16,0" />
                    <Setter Property="Margin" Value="0,0,10,0" />
                    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
                    <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Grid Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource SuccessBrush}"
                                         Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Fill="{ThemeResource DangerBrush}"
                                         Visibility="{Binding IsWarning, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Fill="{ThemeResource TertiaryTextBrush}" Opacity="0.55"
                                         Visibility="{Binding IsNeutral, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource MetaText}"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 一体化磨砂路径与搜索带 -->
        <Border Grid.Row="2" Style="{StaticResource GlassBarStyle}" Padding="12,8">
            <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Content="{Binding Name}" Command="{Binding DataContext.OpenBreadcrumbCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                            Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="云盘目录" />
                                    <controls:LineIcon PathData="{StaticResource IconChevronRight}" IconSize="12"
                                                       Foreground="{ThemeResource TertiaryTextBrush}" Opacity="0.65" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                    <TextBox x:Name="SearchBox" Width="232" PlaceholderText="搜索当前网盘" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchKeyDown" AutomationProperties.Name="搜索我的云盘" />
                    <Button Content="搜索" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="搜索云盘文件" />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="3" Height="2" IsIndeterminate="{Binding IsLoading}" Foreground="{ThemeResource VermilionBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!-- 文件列表 -->
        <Grid Grid.Row="4">
            <ListView ItemsSource="{Binding Entries}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEntryClick"
                      Background="Transparent" BorderThickness="0" Padding="0,0,8,0" AutomationProperties.Name="云盘文件"
                      ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource RailListStyle}">
                        <Setter Property="Height" Value="NaN" />
                        <Setter Property="MinHeight" Value="64" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                            <Grid ColumnSpacing="{StaticResource SpaceMedium}" MinHeight="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="{StaticResource RadiusControl}"
                                        Background="{ThemeResource GlassChipBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <controls:LineIcon PathData="{StaticResource IconFolder}" IconSize="19"
                                                           Foreground="{ThemeResource PrimaryTextBrush}"
                                                           Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}" />
                                        <controls:LineIcon PathData="{StaticResource IconFilm}" IconSize="19"
                                                           Foreground="{ThemeResource VermilionBrush}"
                                                           Visibility="{Binding IsVideoFile, Converter={StaticResource BoolToVisibility}}" />
                                        <controls:LineIcon PathData="{StaticResource IconFile}" IconSize="18"
                                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                                           Visibility="{Binding IsGenericFile, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding MetaText}" Style="{StaticResource MonoMetaText}"
                                           VerticalAlignment="Center" MinWidth="78" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Style="{StaticResource MonoMetaText}"
                                           VerticalAlignment="Center" MinWidth="128" TextAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="{StaticResource SpaceSmall}"
                        Visibility="{Binding EmptyText, Converter={StaticResource StringToVisibility}}">
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <controls:LineIcon PathData="{StaticResource IconCloud}" IconSize="28" Foreground="{ThemeResource SecondaryTextBrush}" />
                </Border>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource SectionTitleText}" TextAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="扫码登录" Style="{StaticResource PrimaryButtonStyle}" Click="OnCloudLoginClick"
                        Visibility="{Binding HasRequiredLogin, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="网盘登录" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" MinHeight="40">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetaText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Content="加载更多" Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" />
        </Grid>
    </Grid>
</Page>

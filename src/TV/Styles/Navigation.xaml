<!--
    流光影院 · 统一横竖导航样式库（SHIRO · MA · OPTICAL GLASS）
    所有页面的一级/二级竖向导轨与横向分段/胶囊/卡片导航在此集中管理，
    严格遵循 WinUI 3 SelectorItem / ListViewItem 全量 CommonStates 契约，
    彻底杜绝历史选中态残留；弹簧滑轨动效由 Controls/NavigationMotion.cs 统一驱动。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 导航文字基础样式（不硬编码 Foreground，自动继承导航项 Normal / PointerOver / Selected 语义色） -->
    <Style x:Key="NavItemTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NavSegmentTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ============================================================
         A. 统一竖向导航家族（Vertical Navigation Family）
         ============================================================ -->

    <!-- 竖向导航基础项（配合 NavigationMotion.AttachVerticalList 全局弹性朱砂滑轨使用，不内嵌静态红条） -->
    <Style x:Key="VerticalNavItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource NavItemHeight}" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource NavItemForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="HoverOverlay"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                        <Border x:Name="SelectionPlate"
                                Background="{ThemeResource NavActivePlateBrush}"
                                BorderBrush="{ThemeResource NavActiveBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Presenter" Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{ThemeResource NavItemForegroundBrush}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource NavHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource NavHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled" />
                                <VisualState x:Name="DisabledState">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MultiSelectStates">
                                <VisualState x:Name="MultiSelectDisabled" />
                                <VisualState x:Name="MultiSelectEnabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 应用主侧栏一级导航项（MainWindow） -->
    <Style x:Key="MainNavRailItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource VerticalNavItemStyle}">
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- 搜索页站点遥测导航项（双行 + 右侧验证/重试操作区） -->
    <Style x:Key="SearchScopeNavItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource VerticalNavItemStyle}">
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <!-- 直播页左侧分组导轨项 -->
    <Style x:Key="LiveGroupNavItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource VerticalNavItemStyle}">
        <Setter Property="Padding" Value="12,0,14,0" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <!-- 内置朱砂竖条的竖向列表项（用于高密度主从长列表，如直播频道流与云盘文件行，不强行加跨百项飞跃指示条） -->
    <Style x:Key="VerticalNavInlineItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource NavItemHeight}" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Padding" Value="12,0,14,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="HoverOverlay"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                        <Border x:Name="SelectionPlate"
                                Background="{ThemeResource NavActivePlateBrush}"
                                BorderBrush="{ThemeResource NavActiveBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5"
                                    Background="{ThemeResource SelectionIndicatorBrush}" Opacity="0"
                                    VerticalAlignment="Center" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="Presenter" Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource NavHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource NavHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MultiSelectStates">
                                <VisualState x:Name="MultiSelectDisabled" />
                                <VisualState x:Name="MultiSelectEnabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 设置页分区导航项（保留 Expander 以兼容 UIA ExpandCollapsePattern，共享统一竖向导航材质与字色语义） -->
    <Style x:Key="SettingsNavSectionStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <ToggleButton x:Name="HeaderToggle"
                                  Content="{TemplateBinding Header}"
                                  Height="{StaticResource NavItemHeight}"
                                  Padding="0,0,12,0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  Background="Transparent" BorderThickness="0"
                                  CornerRadius="{StaticResource RadiusControl}"
                                  UseSystemFocusVisuals="True"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid x:Name="Root" Background="{TemplateBinding Background}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}">
                                    <Border x:Name="HoverOverlay" CornerRadius="{TemplateBinding CornerRadius}"
                                            Background="Transparent" IsHitTestVisible="False" />
                                    <Border x:Name="CheckedPlate" CornerRadius="{TemplateBinding CornerRadius}"
                                            Background="{ThemeResource NavActivePlateBrush}"
                                            BorderBrush="{ThemeResource NavActiveBorderBrush}" BorderThickness="1"
                                            Opacity="0" IsHitTestVisible="False" />
                                    <ContentPresenter x:Name="Presenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Foreground="{ThemeResource NavItemForegroundBrush}"
                                                      Margin="14,0,0,0"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverOverlay.Background" Value="{ThemeResource NavHoverBrush}" />
                                                    <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemHoverForegroundBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverOverlay.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                                    <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemHoverForegroundBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="Root.Opacity" Value="0.42" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Checked">
                                                <VisualState.Setters>
                                                    <Setter Target="CheckedPlate.Opacity" Value="1" />
                                                    <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="CheckedPointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="CheckedPlate.Opacity" Value="1" />
                                                    <Setter Target="HoverOverlay.Background" Value="{ThemeResource NavHoverBrush}" />
                                                    <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="CheckedPressed">
                                                <VisualState.Setters>
                                                    <Setter Target="CheckedPlate.Opacity" Value="1" />
                                                    <Setter Target="HoverOverlay.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                                    <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="CheckedDisabled">
                                                <VisualState.Setters>
                                                    <Setter Target="CheckedPlate.Opacity" Value="1" />
                                                    <Setter Target="Root.Opacity" Value="0.42" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Indeterminate" />
                                            <VisualState x:Name="IndeterminatePointerOver" />
                                            <VisualState x:Name="IndeterminatePressed" />
                                            <VisualState x:Name="IndeterminateDisabled" />
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         B. 统一横向导航家族（Horizontal Navigation Family）
         ============================================================ -->

    <!-- 横向胶囊导航项（点播分类栏：单选 ListView + 底层高反差弹簧滑行胶囊，彻底杜绝多选残留） -->
    <Style x:Key="HorizontalNavChipItemStyle" TargetType="ListViewItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="IdlePill"
                                Background="{ThemeResource NavChipBackgroundBrush}"
                                BorderBrush="{ThemeResource NavChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                        <Border x:Name="HoverOverlay"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Presenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{ThemeResource NavItemForegroundBrush}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePill.Background" Value="{ThemeResource NavChipHoverBackgroundBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePill.Opacity" Value="0" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavChipSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePill.Opacity" Value="0" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavChipSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePill.Opacity" Value="0" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavChipSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePill.Opacity" Value="0" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavChipSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePill.Opacity" Value="0" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavChipSelectedForegroundBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MultiSelectStates">
                                <VisualState x:Name="MultiSelectDisabled" />
                                <VisualState x:Name="MultiSelectEnabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 横向分段槽导航项（媒体库分段器：透明槽 + 晶体滑动胶囊 + 未选柔和降权/选中主字色） -->
    <Style x:Key="HorizontalNavSegmentItemStyle" TargetType="ListViewItem">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="HoverOverlay" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Presenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{ThemeResource NavItemForegroundBrush}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource NavHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MultiSelectStates">
                                <VisualState x:Name="MultiSelectDisabled" />
                                <VisualState x:Name="MultiSelectEnabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 横向状态卡片导航项（云盘四网盘切换带：零模糊晶透卡片 + 底部水平滑行朱砂指示条） -->
    <Style x:Key="HorizontalNavCardItemStyle" TargetType="ListViewItem">
        <Setter Property="Height" Value="72" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="MinWidth" Value="184" />
        <Setter Property="Padding" Value="16,0,16,4" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="IdlePlate"
                                Background="{ThemeResource NavCardBackgroundBrush}"
                                BorderBrush="{ThemeResource NavCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                        <Border x:Name="SelectionPlate"
                                Background="{ThemeResource NavActivePlateBrush}"
                                BorderBrush="{ThemeResource NavActiveBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border Height="1" VerticalAlignment="Top" Margin="14,0"
                                    Background="{ThemeResource GlassCausticBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="HoverOverlay"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Presenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{ThemeResource NavItemForegroundBrush}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource NavHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePlate.Opacity" Value="0" />
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePlate.Opacity" Value="0" />
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePlate.Opacity" Value="0" />
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource NavHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePlate.Opacity" Value="0" />
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource NavItemSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="IdlePlate.Opacity" Value="0" />
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Root.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MultiSelectStates">
                                <VisualState x:Name="MultiSelectDisabled" />
                                <VisualState x:Name="MultiSelectEnabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

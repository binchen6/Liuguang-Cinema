    <!-- 系统强调色：朱砂落款红（驱动 Slider、ToggleSwitch、CheckBox、ProgressBar 与焦点环） -->
    <Color x:Key="SystemAccentColor">#FFE8503E</Color>
    <Color x:Key="SystemAccentColorLight1">#FFF06B5B</Color>
    <Color x:Key="SystemAccentColorLight2">#FFF5887B</Color>
    <Color x:Key="SystemAccentColorLight3">#FFF9A89E</Color>
    <Color x:Key="SystemAccentColorDark1">#FFCE3A2B</Color>
    <Color x:Key="SystemAccentColorDark2">#FFA82C20</Color>
    <Color x:Key="SystemAccentColorDark3">#FF821F16</Color>

    <!-- ============================================================
         2. 字体与平面字阶
         ============================================================ -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Segoe UI Variable Text</FontFamily>

    <!-- 字阶（px，严格保留 ≥13px 可读底线） -->
    <x:Double x:Key="FontSizeHero">34</x:Double>
    <x:Double x:Key="FontSizePageTitle">30</x:Double>
    <x:Double x:Key="FontSizeSection">20</x:Double>
    <x:Double x:Key="FontSizeCardTitle">16</x:Double>
    <x:Double x:Key="FontSizeBody">15</x:Double>
    <x:Double x:Key="FontSizeSecondary">14</x:Double>
    <x:Double x:Key="FontSizeMeta">13</x:Double>

    <!-- 行高 -->
    <x:Double x:Key="LineHeightHero">42</x:Double>
    <x:Double x:Key="LineHeightPageTitle">38</x:Double>
    <x:Double x:Key="LineHeightSection">28</x:Double>
    <x:Double x:Key="LineHeightCardTitle">22</x:Double>
    <x:Double x:Key="LineHeightBody">22</x:Double>
    <x:Double x:Key="LineHeightSecondary">20</x:Double>
    <x:Double x:Key="LineHeightMeta">18</x:Double>

    <!-- ============================================================
         3. 间距（4px 建筑网格）
         ============================================================ -->
    <x:Double x:Key="SpaceTiny">4</x:Double>
    <x:Double x:Key="SpaceMini">8</x:Double>
    <x:Double x:Key="SpaceSmall">12</x:Double>
    <x:Double x:Key="SpaceMedium">16</x:Double>
    <x:Double x:Key="SpaceLarge">24</x:Double>
    <x:Double x:Key="SpaceXLarge">32</x:Double>
    <x:Double x:Key="SpaceHuge">48</x:Double>

    <Thickness x:Key="PagePaddingWide">36,10,36,28</Thickness>
    <Thickness x:Key="PagePaddingStandard">28,10,28,24</Thickness>
    <Thickness x:Key="PagePaddingNarrow">16,8,16,20</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,28</Thickness>
    <Thickness x:Key="GroupGap">0,0,0,16</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="ControlPaddingHorizontal">18,0</Thickness>

    <!-- ============================================================
         4. 控件尺寸与克制圆角
         ============================================================ -->
    <x:Double x:Key="NavItemHeight">48</x:Double>
    <Thickness x:Key="PlayerTopChromePadding">18,14,18,0</Thickness>
    <Thickness x:Key="PlayerBottomChromeMargin">20,0,20,16</Thickness>
    <x:Double x:Key="PlayerDockMaxWidth">1120</x:Double>
    <x:Double x:Key="PrimaryButtonHeight">44</x:Double>
    <x:Double x:Key="SecondaryButtonHeight">40</x:Double>
    <x:Double x:Key="IconButtonSize">40</x:Double>
    <x:Double x:Key="InputHeight">44</x:Double>
    <x:Double x:Key="MenuItemHeight">40</x:Double>
    <x:Double x:Key="ListRowHeight">48</x:Double>

    <!-- 圆角规范：利落画框与磨砂玻璃 -->
    <CornerRadius x:Key="RadiusTag">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusChip">18</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

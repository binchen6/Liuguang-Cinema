<!--
    流光影院 · 设计令牌（SHIRO · MA · OPTICAL GLASS）
    品牌方向：原研哉「白与余白」哲学 × 国际现代平面排版 × 五层光学磨砂玻璃。
    - 暗室素墨（Default）：#0B0B0D 素墨底 + 烟熏磨砂玻璃 + 宣纸白高反差主操作 + 朱砂红落款
    - 素白画廊（Light）：#ECE9E1 温润宣纸底（低眩光护眼） + 月白晶玉磨砂玻璃 + 深松烟墨主操作 + 印泥朱砂落款
    - 高对比（HighContrast）：完整系统语义色无障碍映射
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         1. 语义颜色、光学磨砂玻璃材质与统一导航语义令牌
         ============================================================ -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- 建筑底层画布与月光大气底纹（深色主题：月光 + 高通透晶澈玻璃） -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
            <Color x:Key="SolarCanvasKeyColor">#18DCEAFF</Color>
            <Color x:Key="SolarCanvasMidColor">#0A84B2F2</Color>
            <Color x:Key="MusicGlassLightColor">#AD856A58</Color>
            <Color x:Key="MusicGlassRimColor">#946C585F</Color>
            <Color x:Key="MusicGlassScatterColor">#5A455373</Color>
            <LinearGradientBrush x:Key="AppCanvasGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D0E14" Offset="0" />
                <GradientStop Color="#0A0B0F" Offset="0.55" />
                <GradientStop Color="#0B0C11" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="BackdropGlowPrimaryBrush">
                <GradientStop Color="#1CE4F0FF" Offset="0" />
                <GradientStop Color="#00E4F0FF" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="BackdropGlowSecondaryBrush">
                <GradientStop Color="#1476A2EA" Offset="0" />
                <GradientStop Color="#0076A2EA" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="BackdropGlowAccentBrush">
                <GradientStop Color="#0D8C9CE0" Offset="0" />
                <GradientStop Color="#008C9CE0" Offset="1" />
            </RadialGradientBrush>

            <!-- 月光透光玻璃层级：低雾度高通透，凸显月光折射与冷银玻璃切边 -->
            <AcrylicBrush x:Key="GlassRailBrush" TintColor="#10131C" TintOpacity="0.46" TintLuminosityOpacity="0.62" FallbackColor="#E611141E" />
            <AcrylicBrush x:Key="GlassPanelBrush" TintColor="#131722" TintOpacity="0.38" TintLuminosityOpacity="0.54" FallbackColor="#E0141822" />
            <AcrylicBrush x:Key="GlassOverlayBrush" TintColor="#171B27" TintOpacity="0.62" TintLuminosityOpacity="0.72" FallbackColor="#EE171B26" />
            <!-- 虚拟化微件采用零模糊清透月光晶体渐变 -->
            <LinearGradientBrush x:Key="GlassChipBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#20E6F2FF" Offset="0" />
                <GradientStop Color="#0EC4DCFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassDarkBadgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#B80C0E16" Offset="0" />
                <GradientStop Color="#CE07090F" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlassDarkBadgeInkBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="GlassDarkBadgeAccentBrush" Color="#F06B5B" />
            <LinearGradientBrush x:Key="GlassActivePlateBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#26E6F2FF" Offset="0" />
                <GradientStop Color="#10C6DEFF" Offset="1" />
            </LinearGradientBrush>

            <!-- 月光透光玻璃体积折射、冷银内倒角厚度边与顶部焦散高光丝 -->
            <LinearGradientBrush x:Key="GlassVolumeBrush" StartPoint="0.08,0" EndPoint="0.92,1">
                <GradientStop Color="#22E8F4FF" Offset="0" />
                <GradientStop Color="#0AC6E0FF" Offset="0.26" />
                <GradientStop Color="#00000000" Offset="0.58" />
                <GradientStop Color="#20040710" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassInnerBevelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#28E8F4FF" Offset="0" />
                <GradientStop Color="#0AC8E2FF" Offset="0.34" />
                <GradientStop Color="#22000000" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassCausticBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#66EEF6FF" Offset="0.28" />
                <GradientStop Color="#36C4DEFF" Offset="0.64" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassBottomBevelBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#26CAE0FF" Offset="0.5" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassRailSeamHighlightBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#3AE6F2FF" Offset="0.22" />
                <GradientStop Color="#1AC0DCFF" Offset="0.75" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>

            <!-- 统一导航栏语义令牌（横竖共用） -->
            <SolidColorBrush x:Key="NavItemForegroundBrush" Color="#A6A7B2" />
            <SolidColorBrush x:Key="NavItemHoverForegroundBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="NavItemSelectedForegroundBrush" Color="#FAF9F5" />
            <LinearGradientBrush x:Key="NavActivePlateBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#22FFFFFF" Offset="0" />
                <GradientStop Color="#11FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavActiveBorderBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#44FFFFFF" Offset="0" />
                <GradientStop Color="#1CFFFFFF" Offset="0.38" />
                <GradientStop Color="#26FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NavChipBackgroundBrush" Color="#0EFFFFFF" />
            <SolidColorBrush x:Key="NavChipHoverBackgroundBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="NavChipBorderBrush" Color="#1EFFFFFF" />
            <SolidColorBrush x:Key="NavChipSelectedBackgroundBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="NavChipSelectedForegroundBrush" Color="#0D0D10" />
            <LinearGradientBrush x:Key="NavCardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14FFFFFF" Offset="0" />
                <GradientStop Color="#0AFFFFFF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NavCardBorderBrush" Color="#20FFFFFF" />

            <!-- 实色表面与层级 -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#13141A" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A1C24" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#232631" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#1C1E27" />
            <SolidColorBrush x:Key="SettingsCardBackgroundBrush" Color="#CC15171F" />
            <SolidColorBrush x:Key="PosterPlaceholderBrush" Color="#15161C" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#D608080A" />
            <SolidColorBrush x:Key="DividerBrush" Color="#16FFFFFF" />
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#BA111115" Offset="0" />
                <GradientStop Color="#DF111115" Offset="0.52" />
                <GradientStop Color="#F7111115" Offset="1" />
            </LinearGradientBrush>

            <!-- 品牌徽标单体 -->
            <SolidColorBrush x:Key="BrandMonolithBrush" Color="#18181D" />
            <SolidColorBrush x:Key="BrandMonolithInkBrush" Color="#F4F3EE" />

            <!-- 文本（宣纸白 / 温润灰 / 石墨灰） -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A2A3AE" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#727380" />
            <SolidColorBrush x:Key="OnInverseTextBrush" Color="#0D0D10" />

            <!-- 月光透光玻璃菲涅尔冷银外框（顶左受月光清透折射 → 底右微冷反光） -->
            <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0.08,0" EndPoint="0.92,1">
                <GradientStop Color="#52E8F4FF" Offset="0" />
                <GradientStop Color="#24C4DCFF" Offset="0.28" />
                <GradientStop Color="#12B8D4FF" Offset="0.76" />
                <GradientStop Color="#2EC8E0FF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="StrongBorderBrush" Color="#34FFFFFF" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#66E8503E" />

            <!-- 朱砂落款强调 + 墨白高反差主操作 -->
            <SolidColorBrush x:Key="VermilionBrush" Color="#E8503E" />
            <SolidColorBrush x:Key="VermilionSoftBrush" Color="#22E8503E" />
            <SolidColorBrush x:Key="AccentBrush" Color="#E8503E" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#DBD9D2" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#0D0D10" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#20E8503E" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="#E8503E" />

            <!-- 状态 -->
            <SolidColorBrush x:Key="DangerBrush" Color="#F26B5E" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#26F26B5E" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A" />
            <SolidColorBrush x:Key="RatingBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="#0EFFFFFF" />

            <!-- 兼容旧键 -->
            <SolidColorBrush x:Key="GlassBrush" Color="#131317" />
            <SolidColorBrush x:Key="CardBrush" Color="#17171C" />
            <SolidColorBrush x:Key="PillIdleBrush" Color="#17171C" />
            <SolidColorBrush x:Key="PillActiveInkBrush" Color="#0D0D10" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- 素白画廊 · 温润护眼宣纸画布（明度 ~90%，消除高亮度纯白眩光，久看不累） -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#ECE9E1" />
            <Color x:Key="SolarCanvasKeyColor">#52FFF9EC</Color>
            <Color x:Key="SolarCanvasMidColor">#18A8C6E8</Color>
            <Color x:Key="MusicGlassLightColor">#AAFFE0AD</Color>
            <Color x:Key="MusicGlassRimColor">#9AF0C5B5</Color>
            <Color x:Key="MusicGlassScatterColor">#72B4C4E2</Color>
            <LinearGradientBrush x:Key="AppCanvasGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0EDE6" Offset="0" />
                <GradientStop Color="#EAE6DD" Offset="0.54" />
                <GradientStop Color="#E4DFD4" Offset="1" />
            </LinearGradientBrush>
            <!-- 浅色环境柔光场：晨光暖白 + 淡青瓷雾 + 柔杏陶土，为浅色玻璃提供真实透光介质 -->
            <RadialGradientBrush x:Key="BackdropGlowPrimaryBrush">
                <GradientStop Color="#66FFFDF7" Offset="0" />
                <GradientStop Color="#00FFFDF7" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="BackdropGlowSecondaryBrush">
                <GradientStop Color="#1F7E9EBC" Offset="0" />
                <GradientStop Color="#007E9EBC" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="BackdropGlowAccentBrush">
                <GradientStop Color="#1AD2907A" Offset="0" />
                <GradientStop Color="#00D2907A" Offset="1" />
            </RadialGradientBrush>

            <!-- 日光磨砂玻璃层级（浅色主题：自然日光 + 柔雾磨砂玻璃 + 自动微晶酸蚀纹理） -->
            <AcrylicBrush x:Key="GlassRailBrush" TintColor="#F6F3EB" TintOpacity="0.68" TintLuminosityOpacity="0.78" FallbackColor="#F0F3F0E8" />
            <AcrylicBrush x:Key="GlassPanelBrush" TintColor="#FAF8F2" TintOpacity="0.64" TintLuminosityOpacity="0.74" FallbackColor="#EFF8F5EE" />
            <AcrylicBrush x:Key="GlassOverlayBrush" TintColor="#FCFBF6" TintOpacity="0.80" TintLuminosityOpacity="0.84" FallbackColor="#F8FAF8F2" />
            <!-- 零模糊清透玉石微件 -->
            <LinearGradientBrush x:Key="GlassChipBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#DCFAF8F3" Offset="0" />
                <GradientStop Color="#B8EFEBE1" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassDarkBadgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#BE181A22" Offset="0" />
                <GradientStop Color="#D6101218" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlassDarkBadgeInkBrush" Color="#F6F5F0" />
            <SolidColorBrush x:Key="GlassDarkBadgeAccentBrush" Color="#F06B5B" />
            <LinearGradientBrush x:Key="GlassActivePlateBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FAF8F3" Offset="0" />
                <GradientStop Color="#EFEBE2" Offset="1" />
            </LinearGradientBrush>

            <!-- 月白晶玉五层光学：顶左晨光漫射 + 内 1px 亮白倒角 + 顶部日光焦散 + 底部暖石厚度影 -->
            <LinearGradientBrush x:Key="GlassVolumeBrush" StartPoint="0.08,0" EndPoint="0.92,1">
                <GradientStop Color="#A8FFFFFF" Offset="0" />
                <GradientStop Color="#3EFFFFFF" Offset="0.28" />
                <GradientStop Color="#00FFFFFF" Offset="0.58" />
                <GradientStop Color="#16686053" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassInnerBevelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F2FFFFFF" Offset="0" />
                <GradientStop Color="#74FFFFFF" Offset="0.34" />
                <GradientStop Color="#14FFFFFF" Offset="0.72" />
                <GradientStop Color="#1A5C5448" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassCausticBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#FFFFFFFF" Offset="0.28" />
                <GradientStop Color="#E0FFFFFF" Offset="0.62" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassBottomBevelBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00423B30" Offset="0" />
                <GradientStop Color="#20423B30" Offset="0.5" />
                <GradientStop Color="#00423B30" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassRailSeamHighlightBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#E0FFFFFF" Offset="0.22" />
                <GradientStop Color="#90FFFFFF" Offset="0.76" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>

            <!-- 统一导航栏语义令牌（浅色高清晰温润层次） -->
            <SolidColorBrush x:Key="NavItemForegroundBrush" Color="#52545E" />
            <SolidColorBrush x:Key="NavItemHoverForegroundBrush" Color="#1F2024" />
            <SolidColorBrush x:Key="NavItemSelectedForegroundBrush" Color="#18191D" />
            <LinearGradientBrush x:Key="NavActivePlateBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FCFBF7" Offset="0" />
                <GradientStop Color="#F1EDE4" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavActiveBorderBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#28322D25" Offset="0" />
                <GradientStop Color="#1C322D25" Offset="0.45" />
                <GradientStop Color="#36322D25" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NavChipBackgroundBrush" Color="#9EF9F7F2" />
            <SolidColorBrush x:Key="NavChipHoverBackgroundBrush" Color="#E6FCFBF7" />
            <SolidColorBrush x:Key="NavChipBorderBrush" Color="#24302B22" />
            <SolidColorBrush x:Key="NavChipSelectedBackgroundBrush" Color="#23252B" />
            <SolidColorBrush x:Key="NavChipSelectedForegroundBrush" Color="#FAF8F4" />
            <LinearGradientBrush x:Key="NavCardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#C4F9F7F2" Offset="0" />
                <GradientStop Color="#99EDE9DF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NavCardBorderBrush" Color="#22302B22" />

            <!-- 实色表面（告别刺眼纯白，改为素绢暖白与浅亚麻石） -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F5F0" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E3DFD5" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#DAD5C9" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FAF8F3" />
            <SolidColorBrush x:Key="SettingsCardBackgroundBrush" Color="#EEF8F6F1" />
            <SolidColorBrush x:Key="PosterPlaceholderBrush" Color="#DFDBD0" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#DCECE9E1" />
            <SolidColorBrush x:Key="DividerBrush" Color="#1A2E2A22" />
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#BAFAF8F3" Offset="0" />
                <GradientStop Color="#E2EFECE3" Offset="0.52" />
                <GradientStop Color="#F8ECE9E1" Offset="1" />
            </LinearGradientBrush>

            <!-- 品牌徽标单体 -->
            <SolidColorBrush x:Key="BrandMonolithBrush" Color="#23252B" />
            <SolidColorBrush x:Key="BrandMonolithInkBrush" Color="#FAF8F4" />

            <!-- 护眼文本色阶（深松烟墨 / 青灰墨 / 淡烟墨，零光晕疲劳且高可读） -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F2024" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#53555E" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#72747F" />
            <SolidColorBrush x:Key="OnInverseTextBrush" Color="#FAF8F4" />

            <!-- 浅色玻璃四边完整暖矿石细框（配合内层亮白倒角，清晰刻画玻璃立体轮廓） -->
            <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#26322D25" Offset="0" />
                <GradientStop Color="#1B322D25" Offset="0.38" />
                <GradientStop Color="#302E2921" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1C2E2A22" />
            <SolidColorBrush x:Key="StrongBorderBrush" Color="#342E2A22" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#5EC93A2B" />

            <!-- 印泥朱砂落款 + 深松烟墨高反差主操作 -->
            <SolidColorBrush x:Key="VermilionBrush" Color="#C93A2B" />
            <SolidColorBrush x:Key="VermilionSoftBrush" Color="#1AC93A2B" />
            <SolidColorBrush x:Key="AccentBrush" Color="#C93A2B" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="#23252B" />
            <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#353842" />
            <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#16171B" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#FAF8F4" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#18C93A2B" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#102C2820" />
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="#C93A2B" />

            <SolidColorBrush x:Key="DangerBrush" Color="#B62D20" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#1AB62D20" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#1E7B52" />
            <SolidColorBrush x:Key="RatingBrush" Color="#1F2024" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="#0D2C2820" />

            <SolidColorBrush x:Key="GlassBrush" Color="#FAF8F3" />
            <SolidColorBrush x:Key="CardBrush" Color="#E8E4DA" />
            <SolidColorBrush x:Key="PillIdleBrush" Color="#E6E2D8" />
            <SolidColorBrush x:Key="PillActiveInkBrush" Color="#FAF8F4" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <Color x:Key="SolarCanvasKeyColor">Transparent</Color>
            <Color x:Key="SolarCanvasMidColor">Transparent</Color>
            <Color x:Key="MusicGlassLightColor">Transparent</Color>
            <Color x:Key="MusicGlassRimColor">Transparent</Color>
            <Color x:Key="MusicGlassScatterColor">Transparent</Color>
            <SolidColorBrush x:Key="AppCanvasGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BackdropGlowPrimaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="BackdropGlowSecondaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="BackdropGlowAccentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassRailBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassDarkBadgeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassDarkBadgeInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassDarkBadgeAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="GlassActivePlateBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassVolumeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassInnerBevelBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassCausticBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassBottomBevelBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassRailSeamHighlightBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavItemForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavItemHoverForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavItemSelectedForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

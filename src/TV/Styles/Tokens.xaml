<!--
    流光影院 · 设计令牌（SHIRO · MA · GLASS）
    品牌方向：原研哉「白与余白」哲学 × 国际现代平面排版 × 建筑级磨砂玻璃。
    - 暗室素墨（Default）：#0B0B0D 素墨底 + 烟熏磨砂玻璃 + 宣纸白高反差主操作 + 朱砂红落款
    - 素白画廊（Light）：#F6F5F0 宣纸白底 + 和纸透光磨砂 + 松烟墨高反差主操作 + 印泥朱砂落款
    - 高对比（HighContrast）：完整系统语义色无障碍映射
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         1. 语义颜色与磨砂玻璃材质
         ============================================================ -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- 建筑底层画布与微光大气底纹 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
            <LinearGradientBrush x:Key="AppCanvasGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0E0E11" Offset="0" />
                <GradientStop Color="#0A0A0C" Offset="0.55" />
                <GradientStop Color="#0D0C0E" Offset="1" />
            </LinearGradientBrush>

            <!-- 宏观建筑磨砂玻璃层级（低 Luminosity 校准释放柔和透光，低配/RDP 自动平滑降级至 FallbackColor） -->
            <AcrylicBrush x:Key="GlassRailBrush" TintColor="#12141B" TintOpacity="0.60" TintLuminosityOpacity="0.74" FallbackColor="#EB12141B" />
            <AcrylicBrush x:Key="GlassPanelBrush" TintColor="#161820" TintOpacity="0.54" TintLuminosityOpacity="0.68" FallbackColor="#E615171F" />
            <AcrylicBrush x:Key="GlassOverlayBrush" TintColor="#1B1E28" TintOpacity="0.74" TintLuminosityOpacity="0.82" FallbackColor="#F2181B24" />
            <!-- 虚拟化微件采用零模糊透明晶体渐变：视觉通透锐利，滚动期消除 30+ 并发背景模糊 Pass -->
            <LinearGradientBrush x:Key="GlassChipBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1EFFFFFF" Offset="0" />
                <GradientStop Color="#10FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassDarkBadgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#B80C0E16" Offset="0" />
                <GradientStop Color="#CE07090F" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlassDarkBadgeInkBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="GlassDarkBadgeAccentBrush" Color="#F06B5B" />
            <LinearGradientBrush x:Key="GlassActivePlateBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1EFFFFFF" Offset="0" />
                <GradientStop Color="#10FFFFFF" Offset="1" />
            </LinearGradientBrush>

            <!-- 光学玻璃体积光影、内倒角厚度边与顶部焦散高光丝 -->
            <LinearGradientBrush x:Key="GlassVolumeBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#18FFFFFF" Offset="0" />
                <GradientStop Color="#06FFFFFF" Offset="0.28" />
                <GradientStop Color="#00000000" Offset="0.60" />
                <GradientStop Color="#22030408" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassInnerBevelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1AFFFFFF" Offset="0" />
                <GradientStop Color="#06FFFFFF" Offset="0.35" />
                <GradientStop Color="#1E000000" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassCausticBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#4CFFFFFF" Offset="0.30" />
                <GradientStop Color="#2AFFFFFF" Offset="0.64" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassBottomBevelBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#1AFFFFFF" Offset="0.5" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>

            <!-- 实色表面与层级 -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#13141A" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A1C24" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#232631" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#1C1E27" />
            <SolidColorBrush x:Key="PosterPlaceholderBrush" Color="#15161C" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#D608080A" />
            <SolidColorBrush x:Key="DividerBrush" Color="#16FFFFFF" />
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#BA111115" Offset="0" />
                <GradientStop Color="#DF111115" Offset="0.52" />
                <GradientStop Color="#F7111115" Offset="1" />
            </LinearGradientBrush>

            <!-- 品牌徽标单体 -->
            <SolidColorBrush x:Key="BrandMonolithBrush" Color="#18181D" />
            <SolidColorBrush x:Key="BrandMonolithInkBrush" Color="#F4F3EE" />

            <!-- 文本（宣纸白 / 温润灰 / 石墨灰） -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A2A3AE" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#727380" />
            <SolidColorBrush x:Key="OnInverseTextBrush" Color="#0D0D10" />

            <!-- 菲涅尔定向高光描边与极细分割线（顶亮→侧轻→底柔反光，塑造真实玻璃倒角透视） -->
            <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#3EFFFFFF" Offset="0" />
                <GradientStop Color="#1CFFFFFF" Offset="0.28" />
                <GradientStop Color="#0EFFFFFF" Offset="0.76" />
                <GradientStop Color="#22FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="StrongBorderBrush" Color="#34FFFFFF" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#66E8503E" />

            <!-- 朱砂落款强调 + 墨白高反差主操作 -->
            <SolidColorBrush x:Key="VermilionBrush" Color="#E8503E" />
            <SolidColorBrush x:Key="VermilionSoftBrush" Color="#22E8503E" />
            <SolidColorBrush x:Key="AccentBrush" Color="#E8503E" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#DBD9D2" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#0D0D10" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#20E8503E" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="#E8503E" />

            <!-- 状态 -->
            <SolidColorBrush x:Key="DangerBrush" Color="#F26B5E" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#26F26B5E" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A" />
            <SolidColorBrush x:Key="RatingBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="#0EFFFFFF" />

            <!-- 兼容旧键 -->
            <SolidColorBrush x:Key="GlassBrush" Color="#131317" />
            <SolidColorBrush x:Key="CardBrush" Color="#17171C" />
            <SolidColorBrush x:Key="PillIdleBrush" Color="#17171C" />
            <SolidColorBrush x:Key="PillActiveInkBrush" Color="#0D0D10" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- 原研哉「白」宣纸画廊底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F5F0" />
            <LinearGradientBrush x:Key="AppCanvasGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F9F8F4" Offset="0" />
                <GradientStop Color="#F5F4EE" Offset="0.55" />
                <GradientStop Color="#F2F0E8" Offset="1" />
            </LinearGradientBrush>

            <!-- 和纸透光磨砂玻璃层级 -->
            <AcrylicBrush x:Key="GlassRailBrush" TintColor="#FAF9F5" TintOpacity="0.64" TintLuminosityOpacity="0.78" FallbackColor="#F0FAF9F5" />
            <AcrylicBrush x:Key="GlassPanelBrush" TintColor="#FFFFFF" TintOpacity="0.56" TintLuminosityOpacity="0.72" FallbackColor="#EBFFFFFF" />
            <AcrylicBrush x:Key="GlassOverlayBrush" TintColor="#FFFFFF" TintOpacity="0.78" TintLuminosityOpacity="0.86" FallbackColor="#F6FFFFFF" />
            <!-- 零模糊晶体微件 -->
            <LinearGradientBrush x:Key="GlassChipBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#CCFFFFFF" Offset="0" />
                <GradientStop Color="#99F4F2EC" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassDarkBadgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#BC14161D" Offset="0" />
                <GradientStop Color="#D40B0D13" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlassDarkBadgeInkBrush" Color="#F4F3EE" />
            <SolidColorBrush x:Key="GlassDarkBadgeAccentBrush" Color="#F06B5B" />
            <LinearGradientBrush x:Key="GlassActivePlateBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E6FFFFFF" Offset="0" />
                <GradientStop Color="#B8EFECE4" Offset="1" />
            </LinearGradientBrush>

            <!-- 素白和纸光学体积、内倒角与顶部焦散 -->
            <LinearGradientBrush x:Key="GlassVolumeBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#6EFFFFFF" Offset="0" />
                <GradientStop Color="#20FFFFFF" Offset="0.30" />
                <GradientStop Color="#00FFFFFF" Offset="0.62" />
                <GradientStop Color="#0A000000" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassInnerBevelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#99FFFFFF" Offset="0" />
                <GradientStop Color="#24FFFFFF" Offset="0.40" />
                <GradientStop Color="#0D000000" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassCausticBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#EEFFFFFF" Offset="0.32" />
                <GradientStop Color="#99FFFFFF" Offset="0.68" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassBottomBevelBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#12000000" Offset="0.5" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>

            <!-- 实色表面 -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EFECE4" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E6E3DA" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PosterPlaceholderBrush" Color="#EAE7DF" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#D9F6F5F0" />
            <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C9FFFFFF" Offset="0" />
                <GradientStop Color="#E8FAF9F5" Offset="0.52" />
                <GradientStop Color="#FAFAF9F5" Offset="1" />
            </LinearGradientBrush>

            <!-- 品牌徽标单体 -->
            <SolidColorBrush x:Key="BrandMonolithBrush" Color="#141416" />
            <SolidColorBrush x:Key="BrandMonolithInkBrush" Color="#FAF9F5" />

            <!-- 文本（松烟墨 / 青灰墨 / 淡墨） -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#141416" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#595962" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#84848F" />
            <SolidColorBrush x:Key="OnInverseTextBrush" Color="#FAF9F5" />

            <!-- 素白菲涅尔定向高光描边（顶纯白倒角 + 底微墨影） -->
            <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#E6FFFFFF" Offset="0" />
                <GradientStop Color="#14000000" Offset="0.34" />
                <GradientStop Color="#22000000" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="StrongBorderBrush" Color="#28000000" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#59CE3A2B" />

            <!-- 印泥朱砂落款 + 松烟墨高反差主操作 -->
            <SolidColorBrush x:Key="VermilionBrush" Color="#CE3A2B" />
            <SolidColorBrush x:Key="VermilionSoftBrush" Color="#1ACE3A2B" />
            <SolidColorBrush x:Key="AccentBrush" Color="#CE3A2B" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="#141416" />
            <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#2A2A30" />
            <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#08080A" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#FAF9F5" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#18CE3A2B" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#10000000" />
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="#CE3A2B" />

            <SolidColorBrush x:Key="DangerBrush" Color="#B82A1E" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#1AB82A1E" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#1B7A50" />
            <SolidColorBrush x:Key="RatingBrush" Color="#141416" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="#0A000000" />

            <SolidColorBrush x:Key="GlassBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBrush" Color="#EFECE4" />
            <SolidColorBrush x:Key="PillIdleBrush" Color="#ECE9E0" />
            <SolidColorBrush x:Key="PillActiveInkBrush" Color="#FAF9F5" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppCanvasGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassRailBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassDarkBadgeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassDarkBadgeInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassDarkBadgeAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="GlassActivePlateBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassVolumeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassInnerBevelBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassCausticBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassBottomBevelBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PosterPlaceholderBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HeroScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BrandMonolithBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandMonolithInkBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OnInverseTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="GlassEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StrongBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="VermilionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="VermilionSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentFillPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RatingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="GlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PillIdleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PillActiveInkBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 系统强调色：朱砂落款红（驱动 Slider、ToggleSwitch、CheckBox、ProgressBar 与焦点环） -->
    <Color x:Key="SystemAccentColor">#FFE8503E</Color>
    <Color x:Key="SystemAccentColorLight1">#FFF06B5B</Color>
    <Color x:Key="SystemAccentColorLight2">#FFF5887B</Color>
    <Color x:Key="SystemAccentColorLight3">#FFF9A89E</Color>
    <Color x:Key="SystemAccentColorDark1">#FFCE3A2B</Color>
    <Color x:Key="SystemAccentColorDark2">#FFA82C20</Color>
    <Color x:Key="SystemAccentColorDark3">#FF821F16</Color>

    <!-- ============================================================
         2. 字体与平面字阶
         ============================================================ -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Segoe UI Variable Text</FontFamily>

    <!-- 字阶（px，严格保留 ≥13px 可读底线） -->
    <x:Double x:Key="FontSizeHero">34</x:Double>
    <x:Double x:Key="FontSizePageTitle">30</x:Double>
    <x:Double x:Key="FontSizeSection">20</x:Double>
    <x:Double x:Key="FontSizeCardTitle">16</x:Double>
    <x:Double x:Key="FontSizeBody">15</x:Double>
    <x:Double x:Key="FontSizeSecondary">14</x:Double>
    <x:Double x:Key="FontSizeMeta">13</x:Double>

    <!-- 行高 -->
    <x:Double x:Key="LineHeightHero">42</x:Double>
    <x:Double x:Key="LineHeightPageTitle">38</x:Double>
    <x:Double x:Key="LineHeightSection">28</x:Double>
    <x:Double x:Key="LineHeightCardTitle">22</x:Double>
    <x:Double x:Key="LineHeightBody">22</x:Double>
    <x:Double x:Key="LineHeightSecondary">20</x:Double>
    <x:Double x:Key="LineHeightMeta">18</x:Double>

    <!-- ============================================================
         3. 间距（4px 建筑网格）
         ============================================================ -->
    <x:Double x:Key="SpaceTiny">4</x:Double>
    <x:Double x:Key="SpaceMini">8</x:Double>
    <x:Double x:Key="SpaceSmall">12</x:Double>
    <x:Double x:Key="SpaceMedium">16</x:Double>
    <x:Double x:Key="SpaceLarge">24</x:Double>
    <x:Double x:Key="SpaceXLarge">32</x:Double>
    <x:Double x:Key="SpaceHuge">48</x:Double>

    <Thickness x:Key="PagePaddingWide">36,10,36,28</Thickness>
    <Thickness x:Key="PagePaddingStandard">28,10,28,24</Thickness>
    <Thickness x:Key="PagePaddingNarrow">16,8,16,20</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,28</Thickness>
    <Thickness x:Key="GroupGap">0,0,0,16</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="ControlPaddingHorizontal">18,0</Thickness>

    <!-- ============================================================
         4. 控件尺寸与克制圆角
         ============================================================ -->
    <x:Double x:Key="NavItemHeight">48</x:Double>
    <x:Double x:Key="PrimaryButtonHeight">44</x:Double>
    <x:Double x:Key="SecondaryButtonHeight">40</x:Double>
    <x:Double x:Key="IconButtonSize">40</x:Double>
    <x:Double x:Key="InputHeight">44</x:Double>
    <x:Double x:Key="MenuItemHeight">40</x:Double>
    <x:Double x:Key="ListRowHeight">48</x:Double>

    <!-- 圆角规范：利落画框与磨砂玻璃 -->
    <CornerRadius x:Key="RadiusTag">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusChip">18</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <x:Double x:Key="CardRadius">10</x:Double>

    <!-- 海报 -->
    <x:Double x:Key="PosterWidth">188</x:Double>
    <x:Double x:Key="PosterHeight">282</x:Double>
    <x:Double x:Key="PosterWidthCompact">168</x:Double>
    <x:Double x:Key="PosterHeightCompact">252</x:Double>
    <x:Double x:Key="PosterColumnGap">18</x:Double>
    <x:Double x:Key="PosterRowGap">22</x:Double>
    <x:Double x:Key="PosterMaxWidth">720</x:Double>

    <!-- 侧栏 -->
    <x:Double x:Key="NavPaneWidth">208</x:Double>
    <x:Double x:Key="NavPaneCompactWidth">76</x:Double>
    <x:Double x:Key="TitleBarHeight">48</x:Double>

    <!-- 正文可读宽度上限 -->
    <x:Double x:Key="ReadableMaxWidth">840</x:Double>
    <x:Double x:Key="TextParagraphMaxWidth">800</x:Double>

    <!-- ============================================================
         5. 现代平面文本样式（全站统一入口）
         ============================================================ -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHero}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightHero}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightPageTitle}" />
        <Setter Property="CharacterSpacing" Value="-8" />
    </Style>
    <Style x:Key="EyebrowText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMeta}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightMeta}" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{ThemeResource TertiaryTextBrush}" />
    </Style>
    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightSecondary}" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MetaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMeta}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightMeta}" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>
    <Style x:Key="MonoMetaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMeta}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightMeta}" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="SelectableText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

</ResourceDictionary>

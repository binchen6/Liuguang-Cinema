    <!-- ============================================================
         控件样式：原研哉墨白高反差 + 磨砂玻璃层次
         ============================================================ -->

    <!-- 主操作：暗室为宣纸白底+素墨字，素白为松烟墨底+宣纸白字，44 高 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="controls:GlassOpticsEngine.Mode" Value="Interactive" />
        <Setter Property="controls:GlassOpticsEngine.Profile" Value="Control" />
        <Setter Property="Height" Value="{StaticResource PrimaryButtonHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource PrimaryButtonHeight}" />
        <Setter Property="Padding" Value="{StaticResource ControlPaddingHorizontal}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{ThemeResource AccentFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentInkBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BackgroundSizing="OuterBorderEdge"
                            BorderBrush="{TemplateBinding BorderBrush}"

        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FFF8F7F2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="GlassOverlay"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="GlassOverlay.Background" Value="{StaticResource PlayerGlassHoverBrush}" />
                                        <Setter Target="GlassOverlay.BorderBrush" Value="{StaticResource PlayerGlassRimHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="GlassOverlay.Background" Value="{StaticResource PlayerGlassPressedBrush}" />
                                        <Setter Target="GlassOverlay.BorderBrush" Value="{StaticResource PlayerGlassRimPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.36" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 播放器通透玻璃下拉胶囊按钮（倍速 / 画质 / 跳过 / 封面与歌词，36 高，严格居中对齐） -->
    <Style x:Key="PlayerDropDownButtonStyle" TargetType="DropDownButton">
        <Setter Property="controls:GlassOpticsEngine.Mode" Value="Interactive" />
        <Setter Property="controls:GlassOpticsEngine.Profile" Value="Cinema" />
        <Setter Property="controls:GlassOpticsEngine.RadiusOverride" Value="18" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,0,10,0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="#1EFFFFFF" />
        <Setter Property="BorderBrush" Value="#34FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFF8F7F2" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMeta}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DropDownButton">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                            <Path Data="M 0.5,1 L 4,4.5 L 7.5,1"
                                  Width="8" Height="5.5"
                                  Stroke="#D8F8F7F2" StrokeThickness="1.35"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PlayerGlassHoverBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource PlayerGlassRimHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PlayerGlassPressedBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource PlayerGlassRimPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 播放器清透烟熏玻璃弹出面板与菜单（单一由 FlyoutPresenter 托管的滚动条，杜绝双层滚动条叠加） -->
    <Style x:Key="PlayerGlassFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource PlayerGlassFlyoutBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlayerGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,14,6,14" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Enabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <!-- 内嵌独立 ListView 或定高内容的播放器弹层：禁用外层 FlyoutPresenter 滚动条避免叠加 -->
    <Style x:Key="PlayerGlassStaticFlyoutPresenterStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource PlayerGlassFlyoutPresenterStyle}">
        <Setter Property="Padding" Value="14" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <!-- 通用内嵌 ListView 弹层：禁用外层 FlyoutPresenter 滚动条避免双滚动条 -->
    <Style x:Key="StaticListFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style x:Key="PlayerGlassMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource PlayerGlassFlyoutBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlayerGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- 横向与竖向导航项样式已集中收拢至 Styles/Navigation.xaml 统一管理 -->

    <!-- 建筑磨砂玻璃主面板（详情工作台 / 投屏控制台 / 直播面板） -->
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="controls:GlassOpticsEngine.Mode" Value="Interactive" />
        <Setter Property="controls:GlassOpticsEngine.Profile" Value="Standard" />
        <Setter Property="controls:GlassOpticsEngine.RadiusOverride" Value="14" />
        <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- 轻透建筑设置分组卡片（无额外重度 Acrylic 模糊层，保证多卡同屏滚动满帧与层级主次分明） -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="controls:GlassOpticsEngine.Mode" Value="Interactive" />
        <Setter Property="controls:GlassOpticsEngine.Profile" Value="Standard" />
        <Setter Property="controls:GlassOpticsEngine.RadiusOverride" Value="14" />
        <Setter Property="Background" Value="{ThemeResource SettingsCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
        <Setter Property="Padding" Value="22,18" />
    </Style>

    <!-- 输入框与下拉全站光学对齐 -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="controls:GlassOpticsEngine.Mode" Value="Interactive" />
        <Setter Property="controls:GlassOpticsEngine.Profile" Value="Control" />
        <Setter Property="MinHeight" Value="{StaticResource InputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="12,10,12,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="controls:GlassOpticsEngine.Mode" Value="Interactive" />
        <Setter Property="controls:GlassOpticsEngine.Profile" Value="Control" />
        <Setter Property="MinHeight" Value="{StaticResource InputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="12,10,12,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="controls:GlassOpticsEngine.Mode" Value="Interactive" />
        <Setter Property="controls:GlassOpticsEngine.Profile" Value="Control" />
        <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="NumberBox" BasedOn="{StaticResource DefaultNumberBoxStyle}">
        <Setter Property="controls:GlassOpticsEngine.Mode" Value="Interactive" />
        <Setter Property="controls:GlassOpticsEngine.Profile" Value="Control" />
        <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="controls:GlassOpticsEngine.Mode" Value="Interactive" />
        <Setter Property="controls:GlassOpticsEngine.Profile" Value="Control" />
        <Setter Property="MinHeight" Value="{StaticResource SecondaryButtonHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>

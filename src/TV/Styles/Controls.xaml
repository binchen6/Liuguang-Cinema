    <Style x:Key="GlassSliderStyle" TargetType="Slider">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="#40FFFFFF" />
        <Setter Property="Foreground" Value="{ThemeResource VermilionBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                        <ContentPresenter x:Name="HeaderContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Visibility="Collapsed" />
                        <Grid x:Name="SliderContainer" Background="Transparent" Control.IsTemplateFocusTarget="True"
                              VerticalAlignment="Center" Height="24">
                            <Grid x:Name="HorizontalTemplate" VerticalAlignment="Center" Height="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3"
                                           Height="4" RadiusX="2" RadiusY="2"
                                           Fill="{TemplateBinding Background}"
                                           VerticalAlignment="Center" />
                                <Rectangle x:Name="HorizontalDecreaseRect" Grid.Column="0"
                                           Height="4" RadiusX="2" RadiusY="2"
                                           Fill="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                                <Thumb x:Name="HorizontalThumb" Grid.Column="1"
                                       Style="{StaticResource GlassSliderThumbStyle}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <Grid x:Name="VerticalTemplate" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Rectangle x:Name="VerticalTrackRect" Grid.RowSpan="3" Width="4" RadiusX="2" RadiusY="2"
                                           Fill="{TemplateBinding Background}" HorizontalAlignment="Center" />
                                <Rectangle x:Name="VerticalDecreaseRect" Grid.Row="2" Width="4" RadiusX="2" RadiusY="2"
                                           Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                                <Thumb x:Name="VerticalThumb" Grid.Row="1"
                                       Style="{StaticResource GlassSliderThumbStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalTrackRect.Fill" Value="#5CFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalTrackRect.Fill" Value="#6CFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="SliderContainer.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 五层光学磨砂玻璃通用控件模板与风格预设（Controls/GlassSurface） -->
    <Style x:Key="BaseGlassSurfaceStyle" TargetType="controls:GlassSurface">
        <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
        <Setter Property="VolumeBrush" Value="{ThemeResource GlassVolumeBrush}" />
        <Setter Property="InnerBevelBrush" Value="{ThemeResource GlassInnerBevelBrush}" />
        <Setter Property="CausticBrush" Value="{ThemeResource GlassCausticBrush}" />
        <Setter Property="BottomBevelBrush" Value="{ThemeResource GlassBottomBevelBrush}" />
        <Setter Property="FrostGrainOpacity" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassSurface">
                    <Border x:Name="OuterShell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <!-- L2: 体积光影与乳白磨砂漫射 -->
                            <Border x:Name="VolumeLayer"
                                    Background="{TemplateBinding VolumeBrush}"
                                    CornerRadius="{TemplateBinding InnerCornerRadius}"
                                    IsHitTestVisible="False" />
                            <!-- L3: 1:1 酸蚀微晶磨砂粒（通过 Border ImageBrush 承载，零固有布局尺寸、零每帧开销） -->
                            <Border x:Name="FrostGrainLayer"
                                    CornerRadius="{TemplateBinding InnerCornerRadius}"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False" />
                            <!-- L4b: 内 1px 玻璃厚度倒角边 -->
                            <Border x:Name="InnerBevelLayer"
                                    Margin="1"
                                    BorderThickness="1"
                                    BorderBrush="{TemplateBinding InnerBevelBrush}"
                                    CornerRadius="{TemplateBinding BevelCornerRadius}"
                                    IsHitTestVisible="False" />
                            <!-- L5a: 顶部 1px 峰值焦散高光丝 -->
                            <Border x:Name="CausticLine"
                                    Height="1"
                                    VerticalAlignment="Top"
                                    Margin="{TemplateBinding CausticMargin}"
                                    Background="{TemplateBinding CausticBrush}"
                                    IsHitTestVisible="False" />
                            <!-- L5b: 底部 1px 折返高光唇 -->
                            <Border x:Name="BottomBevel"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Margin="{TemplateBinding CausticMargin}"
                                    Background="{TemplateBinding BottomBevelBrush}"
                                    IsHitTestVisible="False" />
                            <!-- L6: 专属 GPU 光学折射/菲涅尔边缘/点击焦散波纹引擎宿主层（零闲置开销） -->
                            <Border x:Name="OpticsHost"
                                    CornerRadius="{TemplateBinding InnerCornerRadius}"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


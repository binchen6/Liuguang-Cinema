<Application
    x:Class="TV.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:TV.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Icons.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 播放器专用烟熏磨砂玻璃画刷 -->
            <AcrylicBrush x:Key="PlayerGlassBrush" TintColor="#0D0D10" TintOpacity="0.76" TintLuminosityOpacity="0.82" FallbackColor="#E80C0C0F" />
            <AcrylicBrush x:Key="PlayerGlassPillBrush" TintColor="#121216" TintOpacity="0.80" TintLuminosityOpacity="0.86" FallbackColor="#EB101014" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:BoolToFavoriteConverter x:Key="FavoriteText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

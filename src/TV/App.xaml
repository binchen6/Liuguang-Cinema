<Application
    x:Class="TV.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:TV.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Icons.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Navigation.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 播放器清透玻璃由有色基底、内倒角和焦散边光构成。 -->
            <LinearGradientBrush x:Key="PlayerGlassBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#30202937" Offset="0" />
                <GradientStop Color="#40151A25" Offset="0.48" />
                <GradientStop Color="#620B0E16" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlayerGlassPillBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#40272F3C" Offset="0" />
                <GradientStop Color="#48131722" Offset="0.48" />
                <GradientStop Color="#6D0B0E16" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlayerGlassFlyoutBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#D6161B28" Offset="0" />
                <GradientStop Color="#E40E111A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlayerGlassVolumeBrush" StartPoint="0.12,0" EndPoint="0.88,1">
                <GradientStop Color="#34F4F8FF" Offset="0" />
                <GradientStop Color="#12E4ECFF" Offset="0.19" />
                <GradientStop Color="#04E0E8FF" Offset="0.50" />
                <GradientStop Color="#2C04060D" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlayerGlassInnerBevelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#44FFFFFF" Offset="0" />
                <GradientStop Color="#0EFFFFFF" Offset="0.35" />
                <GradientStop Color="#06000000" Offset="0.72" />
                <GradientStop Color="#30000000" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlayerGlassCausticBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#96FFFFFF" Offset="0.26" />
                <GradientStop Color="#58FFFFFF" Offset="0.56" />
                <GradientStop Color="#22FFFFFF" Offset="0.84" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlayerGlassBottomBevelBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#2CFFFFFF" Offset="0.5" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlayerGlassBorderBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#9CFFFFFF" Offset="0" />
                <GradientStop Color="#44F4FAFF" Offset="0.24" />
                <GradientStop Color="#20D9E3F7" Offset="0.74" />
                <GradientStop Color="#57FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlayerGlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#28FFFFFF" Offset="0" />
                <GradientStop Color="#0CFFFFFF" Offset="0.26" />
                <GradientStop Color="#00FFFFFF" Offset="0.58" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PlayerGlassHoverBrush" Color="#2CFFFFFF" />
            <SolidColorBrush x:Key="PlayerGlassPressedBrush" Color="#42FFFFFF" />
            <SolidColorBrush x:Key="PlayerGlassRimHoverBrush" Color="#62FFFFFF" />
            <SolidColorBrush x:Key="PlayerGlassRimPressedBrush" Color="#7EFFFFFF" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:BoolToFavoriteConverter x:Key="FavoriteText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

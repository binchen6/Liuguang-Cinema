<UserControl x:Class="TV.Controls.CloudLoginPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="320" RowSpacing="{StaticResource SpaceSmall}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="{StaticResource SpaceTiny}">
            <TextBlock Text="网盘扫码登录" Style="{StaticResource SectionTitleText}" />
            <TextBlock Text="登录凭据仅加密保存在当前 Windows 用户下。" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="{StaticResource SpaceMini}">
            <Button Content="关闭" Click="OnCloseClick" Style="{StaticResource SecondaryButtonStyle}"
                    Height="{StaticResource PrimaryButtonHeight}" MinHeight="{StaticResource PrimaryButtonHeight}"
                    AutomationProperties.Name="关闭扫码" />
        </StackPanel>
        <Grid Grid.Row="2" MinHeight="220">
            <Border Width="220" Height="220" HorizontalAlignment="Center"
                    Background="{ThemeResource PosterPlaceholderBrush}" CornerRadius="{StaticResource RadiusCard}"
                    Visibility="{Binding IsWebLogin, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                <Image Source="{Binding QrImage}" Stretch="Uniform" AutomationProperties.Name="等待扫码" />
            </Border>
            <ProgressRing Width="32" Height="32" IsActive="{Binding IsBusy}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource BodyText}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>

<UserControl x:Class="TV.Controls.MusicPlayerSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TV.Controls"
             xmlns:local="using:TV.Converters">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="MusicBoolVisibility" />
        <local:StringToVisibilityConverter x:Key="MusicTextVisibility" />
        <x:Double x:Key="MusicLyricFontSize">27</x:Double>
    </UserControl.Resources>
    <Grid x:Name="MusicRoot" Background="{ThemeResource AppBackgroundBrush}" SizeChanged="OnLayoutChanged">
        <Grid x:Name="GlassLightLayer" IsHitTestVisible="False" Opacity="0.60">
            <Border x:Name="GlassLight" Width="670" Height="520" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Background>
                    <RadialGradientBrush Center="0.48,0.52" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource MusicGlassLightColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource MusicGlassRimColor}" Offset="0.46" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
        <Grid Margin="22,14,22,16" MaxWidth="1050" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="OnBack" Style="{StaticResource PlayerIconButtonStyle}"
                            AutomationProperties.Name="返回" ToolTipService.ToolTip="返回">
                        <controls:LineIcon PathData="{StaticResource IconBack}" IconSize="20" />
                    </Button>
                    <TextBlock Text="音乐播放器" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                </StackPanel>
                <DropDownButton Grid.Column="1" Content="封面与歌词" Style="{StaticResource PlayerDropDownButtonStyle}">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="匹配在线封面与歌词" Click="OnMatch" />
                            <MenuFlyoutItem Text="导入封面" Click="OnImportCover" />
                            <MenuFlyoutItem Text="导入歌词" Click="OnImportLyrics" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
            <Grid Grid.Row="1" x:Name="TrackLayout" ColumnSpacing="38" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="TrackInfo" VerticalAlignment="Center" Spacing="8">
                    <controls:GlassSurface x:Name="CoverSurface" Width="250" Height="250" Padding="0"
                                           HorizontalAlignment="Center" CornerRadius="{StaticResource RadiusControl}"
                                           Style="{StaticResource PlayerDockGlassStyle}">
                        <Grid>
                            <TextBlock x:Name="CoverFallback" Text="♫" FontSize="64" Foreground="{ThemeResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                            <Image x:Name="Art" Stretch="UniformToFill" AutomationProperties.Name="歌曲封面" />
                        </Grid>
                    </controls:GlassSurface>
                    <TextBlock x:Name="TrackTitle" TextWrapping="WrapWholeWords" MaxLines="2"
                               TextAlignment="Center" Style="{StaticResource SectionTitleText}" FontFamily="{StaticResource DisplayFontFamily}" />
                    <TextBlock x:Name="TrackArtist" TextAlignment="Center" Style="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="MetadataStatus" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource MetaText}" />
                </StackPanel>
                <Grid x:Name="LyricPanel" Grid.Column="1" Background="Transparent">
                    <Grid>
                        <ListView x:Name="Lyrics" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnLyricClick"
                                  Background="Transparent" AutomationProperties.Name="逐句歌词"
                                  ContainerContentChanging="OnLyricContainerChanging" SizeChanged="OnLyricViewportChanged"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListView.Header><Border x:Name="LyricLeadingSpace" IsHitTestVisible="False" /></ListView.Header>
                            <ListView.Footer><Border x:Name="LyricTrailingSpace" IsHitTestVisible="False" /></ListView.Footer>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="14,9" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="{StaticResource MusicLyricFontSize}"
                                               FontFamily="{StaticResource DisplayFontFamily}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="LyricPlaceholder" Text="暂无歌词" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryText}" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Grid>
            <controls:GlassSurface Grid.Row="2" Style="{StaticResource PlayerDockGlassStyle}" Padding="15,8">
                <Grid RowSpacing="3" ColumnSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" Style="{StaticResource MonoMetaText}" />
                    <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="OnSeekValueChanged"
                            AutomationProperties.Name="音乐播放进度" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" Style="{StaticResource MonoMetaText}" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <Button Style="{StaticResource PlayerIconButtonStyle}" AutomationProperties.Name="上一首" ToolTipService.ToolTip="上一首"
                                Command="{Binding PreviousEpisodeCommand}" IsEnabled="{Binding CanPrevious}">
                            <controls:LineIcon PathData="{StaticResource IconPrevious}" IconSize="20" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="播放暂停" ToolTipService.ToolTip="播放 / 暂停"
                                Command="{Binding TogglePauseCommand}" MinWidth="52" MinHeight="40">
                            <Grid>
                                <controls:LineIcon PathData="{StaticResource IconPlaySolid}" IconSize="17" IsFilled="True"
                                                   Visibility="{Binding IsPlaying, Converter={StaticResource MusicBoolVisibility}, ConverterParameter=Inverse}" />
                                <controls:LineIcon PathData="{StaticResource IconPauseSolid}" IconSize="17" IsFilled="True"
                                                   Visibility="{Binding IsPlaying, Converter={StaticResource MusicBoolVisibility}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}" AutomationProperties.Name="下一首" ToolTipService.ToolTip="下一首"
                                Command="{Binding NextEpisodeCommand}" IsEnabled="{Binding CanNext}">
                            <controls:LineIcon PathData="{StaticResource IconNext}" IconSize="20" />
                        </Button>
                        <Slider Width="84" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="音乐音量" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               TextAlignment="Center" Style="{StaticResource MetaText}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource MusicTextVisibility}}" />
                </Grid>
            </controls:GlassSurface>
        </Grid>
    </Grid>
</UserControl>

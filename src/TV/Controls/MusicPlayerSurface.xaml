<UserControl x:Class="TV.Controls.MusicPlayerSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TV.Controls"
             xmlns:local="using:TV.Converters">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="MusicBoolVisibility" />
        <local:StringToVisibilityConverter x:Key="MusicTextVisibility" />
        <x:Double x:Key="MusicLyricFontSize">26</x:Double>
    </UserControl.Resources>
    <Grid x:Name="MusicRoot" Background="{ThemeResource AppBackgroundBrush}" SizeChanged="OnLayoutChanged">
        <!-- GPU 合成不规则真实日光与玻璃折射光场（无硬边椭圆，五层柔化散射+焦散光带） -->
        <Border x:Name="SolarStageHost" IsHitTestVisible="False" />

        <Grid Margin="24,18,24,18" MaxWidth="1100" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏：对称清透玻璃胶囊（左侧返回+标题，右侧封面与歌词菜单） -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:GlassSurface x:Name="HeaderBackGlass" Style="{StaticResource PlayerDockGlassStyle}"
                                       HorizontalAlignment="Left" CornerRadius="23" Padding="5,4,18,4">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Click="OnBack" Style="{StaticResource PlayerIconButtonStyle}"
                                AutomationProperties.Name="返回" ToolTipService.ToolTip="返回 (Esc)">
                            <controls:LineIcon PathData="{StaticResource IconBack}" IconSize="17" Foreground="#FFF8F7F2" />
                        </Button>
                        <Border Width="1" Height="16" Background="#30FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="音乐播放器" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FFF8F7F2" VerticalAlignment="Center" />
                    </StackPanel>
                </controls:GlassSurface>
                <DropDownButton x:Name="MetadataButton" Grid.Column="1" Content="封面与歌词"
                                Style="{StaticResource PlayerDropDownButtonStyle}"
                                Height="46" MinHeight="46" CornerRadius="23" Padding="16,0,14,0"
                                VerticalAlignment="Center">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight"
                                    MenuFlyoutPresenterStyle="{StaticResource PlayerGlassMenuFlyoutPresenterStyle}">
                            <MenuFlyoutItem Text="匹配在线封面与歌词" Click="OnMatch" />
                            <MenuFlyoutItem Text="导入封面" Click="OnImportCover" />
                            <MenuFlyoutItem Text="导入歌词" Click="OnImportLyrics" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <!-- 主舞台：左侧光学玻璃封面与曲目信息，右侧逐句歌词与光学高光 -->
            <Grid Grid.Row="1" x:Name="TrackLayout" ColumnSpacing="44" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>

                <StackPanel x:Name="TrackInfo" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <controls:GlassSurface x:Name="CoverSurface" Width="264" Height="264" Padding="0"
                                           HorizontalAlignment="Center" CornerRadius="{StaticResource RadiusPanel}"
                                           Style="{StaticResource PlayerDockGlassStyle}">
                        <Grid>
                            <Border x:Name="ArtClipBorder" CornerRadius="13">
                                <Border.Background>
                                    <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <controls:LineIcon x:Name="CoverFallback" PathData="{StaticResource IconMusic}" IconSize="56"
                                               Foreground="#A6F8F7F2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </controls:GlassSurface>
                    <StackPanel Spacing="4" MaxWidth="320" HorizontalAlignment="Center">
                        <TextBlock x:Name="TrackTitle" TextWrapping="WrapWholeWords" MaxLines="2"
                                   TextAlignment="Center" Style="{StaticResource SectionTitleText}"
                                   FontFamily="{StaticResource DisplayFontFamily}" Foreground="#FFF8F7F2" />
                        <TextBlock x:Name="TrackArtist" TextAlignment="Center" Style="{StaticResource SecondaryText}"
                                   Foreground="#B8F8F7F2" Visibility="Collapsed" />
                        <TextBlock x:Name="MetadataStatus" TextWrapping="Wrap" TextAlignment="Center"
                                   Style="{StaticResource MetaText}" Foreground="#9CF8F7F2" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="LyricPanel" Grid.Column="1" Background="Transparent">
                    <Grid>
                        <ListView x:Name="Lyrics" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnLyricClick"
                                  Background="Transparent" AutomationProperties.Name="逐句歌词"
                                  ContainerContentChanging="OnLyricContainerChanging" SizeChanged="OnLyricViewportChanged"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListView.Header><Border x:Name="LyricLeadingSpace" IsHitTestVisible="False" /></ListView.Header>
                            <ListView.Footer><Border x:Name="LyricTrailingSpace" IsHitTestVisible="False" /></ListView.Footer>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="CornerRadius" Value="12" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="LyricGlassPlate" CornerRadius="12" Padding="16,10" Margin="0,0,22,0"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="{StaticResource MusicLyricFontSize}"
                                                   LineHeight="36" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="SemiBold"
                                                   Foreground="#FFF8F7F2" />
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="LyricPlaceholder" Text="暂无歌词" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryText}" Foreground="#A6F8F7F2" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- 底部清透光学玻璃控制坞：进度行严格同轴居中，控制行三栏对称平衡 -->
            <controls:GlassSurface x:Name="TransportGlass" Grid.Row="2" Style="{StaticResource PlayerDockGlassStyle}"
                                   CornerRadius="20" Padding="18,10,18,12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 第一行：等宽时间码 + 居中玻璃进度条 -->
                    <Grid Height="28" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" MinWidth="46"
                                   Style="{StaticResource MonoMetaText}" FontWeight="SemiBold" Foreground="#FFF8F7F2" />
                        <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1"
                                Style="{StaticResource GlassSliderStyle}"
                                ValueChanged="OnSeekValueChanged"
                                AutomationProperties.Name="音乐播放进度" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" MinWidth="46"
                                   TextAlignment="Right" Style="{StaticResource MonoMetaText}" Foreground="#CCF8F7F2" />
                    </Grid>

                    <!-- 第二行：三栏对称（左留白 / 中央上一首-播放-下一首 / 右侧静音图标+音量条） -->
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Spacing="10">
                            <Button Style="{StaticResource PlayerIconButtonStyle}" Width="40" Height="40" MinWidth="40" MinHeight="40"
                                    CornerRadius="20" controls:GlassOpticsEngine.RadiusOverride="20"
                                    AutomationProperties.Name="上一首" ToolTipService.ToolTip="上一首"
                                    Command="{Binding PreviousEpisodeCommand}" IsEnabled="{Binding CanPrevious}">
                                <controls:LineIcon PathData="{StaticResource IconPrevious}" IconSize="18" Foreground="#FFF8F7F2" />
                            </Button>
                            <Button Style="{StaticResource PlayerPrimaryTransportStyle}" Width="46" Height="46" MinWidth="46" MinHeight="46"
                                    CornerRadius="23" controls:GlassOpticsEngine.RadiusOverride="23"
                                    AutomationProperties.Name="播放暂停" ToolTipService.ToolTip="播放 / 暂停 (空格)"
                                    Command="{Binding TogglePauseCommand}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:LineIcon PathData="{StaticResource IconPlaySolid}" IconSize="21" IsFilled="True"
                                                       Foreground="#0D0D10"
                                                       Visibility="{Binding IsPlaying, Converter={StaticResource MusicBoolVisibility}, ConverterParameter=Inverse}" />
                                    <controls:LineIcon PathData="{StaticResource IconPauseSolid}" IconSize="20" IsFilled="True"
                                                       Foreground="#0D0D10"
                                                       Visibility="{Binding IsPlaying, Converter={StaticResource MusicBoolVisibility}}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource PlayerIconButtonStyle}" Width="40" Height="40" MinWidth="40" MinHeight="40"
                                    CornerRadius="20" controls:GlassOpticsEngine.RadiusOverride="20"
                                    AutomationProperties.Name="下一首" ToolTipService.ToolTip="下一首"
                                    Command="{Binding NextEpisodeCommand}" IsEnabled="{Binding CanNext}">
                                <controls:LineIcon PathData="{StaticResource IconNext}" IconSize="18" Foreground="#FFF8F7F2" />
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Spacing="6">
                            <Button Style="{StaticResource PlayerIconButtonStyle}" Width="34" Height="34" MinWidth="34" MinHeight="34"
                                    CornerRadius="17" controls:GlassOpticsEngine.RadiusOverride="17"
                                    Click="OnMuteClick" AutomationProperties.Name="静音" ToolTipService.ToolTip="静音 (M)">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:LineIcon PathData="{StaticResource IconVolume}" IconSize="16" Foreground="#FFF8F7F2"
                                                       Visibility="{Binding IsMuted, Converter={StaticResource MusicBoolVisibility}, ConverterParameter=Inverse}" />
                                    <controls:LineIcon PathData="{StaticResource IconVolumeMute}" IconSize="16" Foreground="#CCF8F7F2"
                                                       Visibility="{Binding IsMuted, Converter={StaticResource MusicBoolVisibility}}" />
                                </Grid>
                            </Button>
                            <Slider Width="92" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"
                                    Style="{StaticResource GlassSliderStyle}"
                                    VerticalAlignment="Center" AutomationProperties.Name="音乐音量" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               TextAlignment="Center" Style="{StaticResource MetaText}" Foreground="#CCF8F7F2"
                               Visibility="{Binding StatusMessage, Converter={StaticResource MusicTextVisibility}}" />
                </Grid>
            </controls:GlassSurface>
        </Grid>
    </Grid>
</UserControl>

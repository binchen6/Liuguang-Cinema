<ContentDialog x:Class="TV.Controls.BilibiliLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="B 站账号" CloseButtonText="关闭" DefaultButton="Close"
    Opened="OnOpened" Closed="OnClosed">
    <StackPanel Spacing="{StaticResource SpaceSmall}">
        <TextBlock x:Name="AccountStatus" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <Border x:Name="QrFrame" Width="224" Height="224" HorizontalAlignment="Center" Visibility="Collapsed" Padding="10"
                Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
            <Grid>
                <Image x:Name="QrImage" Stretch="Uniform" AutomationProperties.Name="B 站登录二维码" />
                <ProgressRing x:Name="QrProgress" Foreground="{ThemeResource VermilionBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <TextBlock x:Name="ScanStatus" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
            <Button x:Name="ScanButton" Content="扫码登录" Click="OnScanClick" Style="{StaticResource PrimaryButtonStyle}" />
            <Button x:Name="SignOutButton" Content="退出登录" Click="OnSignOutClick" Style="{StaticResource GhostButtonStyle}"
                    Height="{StaticResource PrimaryButtonHeight}" MinHeight="{StaticResource PrimaryButtonHeight}"
                    Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</ContentDialog>

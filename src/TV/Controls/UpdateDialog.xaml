<ContentDialog
    x:Class="TV.Controls.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TV.Controls"
    x:Name="DialogRoot"
    PrimaryButtonText="下载安装"
    SecondaryButtonText="GitHub 发行页"
    CloseButtonText="稍后"
    DefaultButton="Primary"
    AutomationProperties.Name="应用更新">
    <ContentDialog.Title>
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <controls:BrandMark MarkSize="34" VerticalAlignment="Center" />
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="发现新版本" Style="{StaticResource SectionTitleText}" />
                <TextBlock x:Name="VersionText" Style="{StaticResource MonoMetaText}" />
            </StackPanel>
        </StackPanel>
    </ContentDialog.Title>
    <StackPanel Width="500" MaxWidth="500" Spacing="14">
        <Border Background="{ThemeResource GlassChipBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="16,14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ReleaseTitleText" Style="{StaticResource CardTitleText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="PackageText" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="{ThemeResource VermilionSoftBrush}"
                        BorderBrush="{ThemeResource AccentBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="9,4" VerticalAlignment="Top">
                    <TextBlock Text="RELEASE" Style="{StaticResource MonoMetaText}" FontWeight="SemiBold"
                               Foreground="{ThemeResource VermilionBrush}" />
                </Border>
            </Grid>
        </Border>
        <StackPanel Spacing="7">
            <TextBlock Text="CHANGELOG · 更新内容" Style="{StaticResource EyebrowText}" />
            <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"
                    Background="{ThemeResource SurfaceBrush}" MaxHeight="280">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" IsVerticalScrollChainingEnabled="True" Padding="4,2,8,2">
                    <TextBlock x:Name="NotesText" Margin="10" Style="{StaticResource SecondaryText}"
                               Foreground="{ThemeResource PrimaryTextBrush}" TextWrapping="Wrap" LineHeight="23"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Border>
        </StackPanel>
        <StackPanel x:Name="ProgressPanel" Spacing="7" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="3" Foreground="{ThemeResource VermilionBrush}" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource MonoMetaText}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                   Text="下载完成后将自动关闭应用并安装；安装期间无需其他操作。" />
    </StackPanel>
</ContentDialog>

<ContentDialog
    x:Class="TV.Controls.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="DialogRoot"
    PrimaryButtonText="下载安装"
    SecondaryButtonText="GitHub 发行页"
    CloseButtonText="稍后"
    DefaultButton="Primary"
    AutomationProperties.Name="应用更新">
    <ContentDialog.Title>
        <StackPanel Spacing="5">
            <TextBlock Text="发现新版本" Style="{StaticResource SectionTitleText}" />
            <TextBlock x:Name="VersionText" Style="{StaticResource MetaText}" />
        </StackPanel>
    </ContentDialog.Title>
    <StackPanel Width="500" MaxWidth="500" Spacing="14">
        <Border Background="{ThemeResource SurfaceAltBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ReleaseTitleText" Style="{StaticResource CardTitleText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="PackageText" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="{ThemeResource SelectionBrush}" CornerRadius="8" Padding="9,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="GitHub 正式版" Style="{StaticResource MetaText}" Foreground="{ThemeResource AccentBrush}" />
                </Border>
            </Grid>
        </Border>
        <StackPanel Spacing="7">
            <TextBlock Text="更新内容" Style="{StaticResource LabelText}" />
            <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"
                    Background="{ThemeResource SurfaceBrush}" MaxHeight="280">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Padding="2,0,8,0">
                    <TextBlock x:Name="NotesText" Margin="10" Style="{StaticResource SecondaryText}"
                               Foreground="{ThemeResource PrimaryTextBrush}" TextWrapping="Wrap" LineHeight="23"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Border>
        </StackPanel>
        <StackPanel x:Name="ProgressPanel" Spacing="7" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="4" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                   Text="下载完成后将自动关闭应用并安装；安装期间无需其他操作。" />
    </StackPanel>
</ContentDialog>

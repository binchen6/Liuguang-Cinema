<UserControl
    x:Class="TV.Controls.LiquidBackdrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF22645E" Offset="0"/>
                <GradientStop Color="#FF132B43" Offset="0.53"/>
                <GradientStop Color="#FF08141C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
    </Border>
</UserControl>

<UserControl
    x:Class="TV.Controls.LiquidBackdrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    Loaded="OnLoaded">
    <!-- 原研哉建筑感主题自适应光场：暗室极轻电影余辉 / 素白晨光青瓷漫射，为全站磨砂玻璃提供真实透光纵深；高对比自动隐藏 -->
    <Grid Background="{ThemeResource AppCanvasGradientBrush}">
        <Grid x:Name="AmbientLayer" IsHitTestVisible="False">
            <Ellipse Width="960" Height="960" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-300,-340,0,0" Fill="{ThemeResource BackdropGlowPrimaryBrush}" />
            <Ellipse Width="820" Height="820" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="200,-260,0,0" Fill="{ThemeResource BackdropGlowSecondaryBrush}" />
            <Ellipse Width="780" Height="780" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-240,-260" Fill="{ThemeResource BackdropGlowAccentBrush}" />
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="TV.Controls.LibraryPoster" x:Name="PosterRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TV.Controls"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="56" /></Grid.RowDefinitions>
        <Border CornerRadius="{StaticResource RadiusCard}" BorderThickness="1"
                BorderBrush="{ThemeResource GlassEdgeBrush}" Background="{ThemeResource PosterPlaceholderBrush}">
            <Grid>
                <controls:LineIcon PathData="{StaticResource IconFilm}" IconSize="28"
                                   Foreground="{ThemeResource TertiaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="Artwork" Stretch="Uniform" />
                <ProgressBar Value="{Binding Progress, ElementName=PosterRoot}" Maximum="100" Height="3"
                             VerticalAlignment="Bottom" Margin="8,0,8,7" Foreground="{ThemeResource VermilionBrush}"
                             Visibility="{Binding HasProgress, ElementName=PosterRoot, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Spacing="3" Padding="2,0,3,0">
            <TextBlock x:Name="TitleBlock" Text="{Binding Title, ElementName=PosterRoot}" Style="{StaticResource CardTitleText}"
                       MaxLines="1" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle, ElementName=PosterRoot}" Style="{StaticResource MetaText}"
                       MaxLines="1" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>

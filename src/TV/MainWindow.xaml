<Window
    x:Class="TV.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ShellRoot" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PaneColumn" Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 侧栏：品牌 + 一级导航 + 设置（全高，与标题栏一体） -->
        <Border x:Name="NavPane" Grid.Column="0" Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid x:Name="NavPaneContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="BrandBlock" Grid.Row="0" Orientation="Horizontal" Spacing="11"
                            Margin="20,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border Width="28" Height="28" CornerRadius="8" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFD68A" Offset="0" />
                                <GradientStop Color="#E8A442" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE768;" FontSize="12" Margin="2,0,0,0"
                                  Foreground="{ThemeResource AccentInkBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="BrandText" Text="流光影院" FontSize="{StaticResource FontSizeCardTitle}" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFontFamily}" CharacterSpacing="20"
                               Foreground="{ThemeResource PrimaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <ListView x:Name="NavList" Grid.Row="1" Margin="0,8,0,0" Padding="0,0,0,8"
                          Background="Transparent" BorderThickness="0"
                          SelectionMode="Single" IsItemClickEnabled="False"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          SelectionChanged="OnNavSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <StaticResource ResourceKey="NavRailItemStyle" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListViewItem Tag="vod" AutomationProperties.Name="点播" ToolTipService.ToolTip="点播">
                        <StackPanel x:Name="NavContentVod" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE8B2;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelVod" Text="点播" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="live" AutomationProperties.Name="直播" ToolTipService.ToolTip="直播">
                        <StackPanel x:Name="NavContentLive" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE7F4;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelLive" Text="直播" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="library" AutomationProperties.Name="媒体库" ToolTipService.ToolTip="媒体库">
                        <StackPanel x:Name="NavContentLibrary" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE8A9;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelLibrary" Text="媒体库" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="cast" AutomationProperties.Name="投屏" ToolTipService.ToolTip="投屏">
                        <StackPanel x:Name="NavContentCast" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xEC15;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelCast" Text="投屏" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="16,4,16,8" />
                    <Button x:Name="SettingsButton" Style="{StaticResource GhostButtonStyle}"
                            Margin="8,0,8,0" Height="{StaticResource NavItemHeight}" Padding="17,0,14,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OnSettingsClick" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置">
                        <StackPanel x:Name="NavContentSettings" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE713;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelSettings" Text="设置" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 物理弹簧滑行的全局侧栏指示条（跨点播/直播/媒体库/投屏/设置丝滑过渡） -->
                <Border x:Name="FloatingNavIndicator" Grid.RowSpan="3"
                        Width="3.5" Height="22" CornerRadius="2"
                        Background="{ThemeResource SelectionIndicatorBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8,0,0,0" Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- 右侧：标题栏操作区 + 页面内容 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent"
                  Loaded="OnTitleBarLoaded" SizeChanged="OnTitleBarSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource IconButtonStyle}"
                        Background="Transparent" BorderThickness="0" Opacity="0" IsHitTestVisible="False"
                        Margin="12,0,0,0" Click="OnBackClick"
                        ToolTipService.ToolTip="返回 (Alt+←)" AutomationProperties.Name="返回">
                    <FontIcon Glyph="&#xE72B;" FontSize="18" />
                </Button>

            </Grid>

            <Frame x:Name="ContentFrame" Grid.Row="1" Background="Transparent" />
        </Grid>

        <!-- 关闭行为面板锚点（贴在标题栏右上，系统按钮下方） -->
        <Border x:Name="ClosePromptAnchor" Width="46" Height="32" HorizontalAlignment="Right"
                VerticalAlignment="Top" IsHitTestVisible="False" />
    </Grid>
</Window>

<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <Product>流光影院 (Liuguang Cinema)</Product>
    <Company>Liuguang Cinema Contributors</Company>
    <Authors>Liuguang Cinema Contributors</Authors>
    <Copyright>Copyright (c) Liuguang Cinema Contributors. MIT License.</Copyright>
    <RepositoryUrl>https://github.com/binchen6/Liuguang-Cinema</RepositoryUrl>
  </PropertyGroup>
</Project>
